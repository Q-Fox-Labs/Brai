{
  "name": "brai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build:web": "npm run build --workspace=@brai/web",
    "build:timer": "npm run build --workspace=@brai/timer",
    "build:agent": "npm run build --workspace=@brai/agent",
    "typecheck:web": "npm run typecheck --workspace=@brai/web",
    "typecheck:timer": "npm run typecheck --workspace=@brai/timer",
    "typecheck:agent": "npm run typecheck --workspace=@brai/agent",
    "build": "npm run build:web && npm run build:timer && npm run build:auth && npm run build:agent && npm run build:supabase-mcp && npm run build:history",
    "typecheck": "npm run typecheck:web && npm run typecheck:timer && npm run typecheck:auth && npm run typecheck:agent && npm run typecheck:supabase-mcp && npm run typecheck:history",
    "lint": "npm run lint --workspaces --if-present",
    "test:web": "npm test --workspace=@brai/web",
    "build:auth": "npm run build --workspace=@brai/auth",
    "typecheck:auth": "npm run typecheck --workspace=@brai/auth",
    "test:auth": "npm test --workspace=@brai/auth",
    "test:timer": "npm test --workspace=@brai/timer",
    "test:agent": "npm test --workspace=@brai/agent",
    "test": "npm test --workspaces --if-present",
    "build:supabase-mcp": "npm run build --workspace=@brai/supabase-mcp",
    "typecheck:supabase-mcp": "npm run typecheck --workspace=@brai/supabase-mcp",
    "test:supabase-mcp": "npm test --workspace=@brai/supabase-mcp",
    "test:integration:supabase-mcp": "npm run test:integration --workspace=@brai/supabase-mcp",
    "build:history": "npm run build --workspace=@brai/history",
    "typecheck:history": "npm run typecheck --workspace=@brai/history",
    "test:history": "npm run test --workspace=@brai/history",
    "migrate:history": "npm run migrate --workspace=@brai/history",
    "health:history": "npm run health --workspace=@brai/history",
    "test:integration:history": "npm run test:integration --workspace=@brai/history"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
