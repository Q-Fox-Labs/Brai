{
  "name": "brai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build:web": "npm run build --workspace=@brai/web",
    "build:timer": "npm run build --workspace=@brai/timer",
    "typecheck:web": "npm run typecheck --workspace=@brai/web",
    "typecheck:timer": "npm run typecheck --workspace=@brai/timer",
    "build": "npm run build:web && npm run build:timer && npm run build:auth",
    "typecheck": "npm run typecheck:web && npm run typecheck:timer && npm run typecheck:auth",
    "lint": "npm run lint --workspaces --if-present",
    "test:web": "npm test --workspace=@brai/web",
    "build:auth": "npm run build --workspace=@brai/auth",
    "typecheck:auth": "npm run typecheck --workspace=@brai/auth",
    "test:auth": "npm test --workspace=@brai/auth",
    "test:timer": "npm test --workspace=@brai/timer",
    "test:contracts": "npm run test:contracts --workspace=@brai/agent",
    "generate:contracts": "npm run generate:contracts --workspace=@brai/agent",
    "typecheck:contracts": "npm run typecheck:contracts --workspace=@brai/agent",
    "check:contracts": "npm run check:contracts --workspace=@brai/agent",
    "generate:codex-contract": "npm run generate:codex-contract --workspace=@brai/agent --",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
