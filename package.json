{
  "name": "brai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build:web": "npm run build --workspace=@brai/web",
    "build:timer": "npm run build --workspace=@brai/timer",
    "build:agent": "npm run build --workspace=@brai/agent",
    "typecheck:web": "npm run typecheck --workspace=@brai/web",
    "typecheck:timer": "npm run typecheck --workspace=@brai/timer",
    "typecheck:agent": "npm run typecheck --workspace=@brai/agent",
    "build": "npm run build:web && npm run build:timer && npm run build:auth && npm run build:agent && npm run build:supabase-mcp && npm run build:artifacts && npm run build:history && npm run build:transcription && npm run build:alerts && npm run build:elements",
    "typecheck": "npm run typecheck:web && npm run typecheck:timer && npm run typecheck:auth && npm run typecheck:agent && npm run typecheck:supabase-mcp && npm run typecheck:artifacts && npm run typecheck:history && npm run typecheck:transcription && npm run typecheck:alerts && npm run typecheck:elements",
    "lint": "npm run lint --workspaces --if-present",
    "test:web": "npm test --workspace=@brai/web",
    "build:auth": "npm run build --workspace=@brai/auth",
    "typecheck:auth": "npm run typecheck --workspace=@brai/auth",
    "test:auth": "npm test --workspace=@brai/auth",
    "test:timer": "npm test --workspace=@brai/timer",
    "test:agent": "npm test --workspace=@brai/agent",
    "test": "npm test --workspaces --if-present",
    "build:supabase-mcp": "npm run build --workspace=@brai/supabase-mcp",
    "typecheck:supabase-mcp": "npm run typecheck --workspace=@brai/supabase-mcp",
    "test:supabase-mcp": "npm test --workspace=@brai/supabase-mcp",
    "test:integration:supabase-mcp": "npm run test:integration --workspace=@brai/supabase-mcp",
    "build:artifacts": "npm run build --workspace=@brai/artifacts",
    "typecheck:artifacts": "npm run typecheck --workspace=@brai/artifacts",
    "test:artifacts": "npm test --workspace=@brai/artifacts",
    "test:integration:artifacts": "npm run test:integration --workspace=@brai/artifacts",
    "build:history": "npm run build --workspace=@brai/history",
    "typecheck:history": "npm run typecheck --workspace=@brai/history",
    "test:history": "npm run test --workspace=@brai/history",
    "migrate:history": "npm run migrate --workspace=@brai/history",
    "health:history": "npm run health --workspace=@brai/history",
    "test:integration:history": "npm run test:integration --workspace=@brai/history",
    "build:local-ai": "npm run build --workspace=@brai/local-ai",
    "typecheck:local-ai": "npm run typecheck --workspace=@brai/local-ai",
    "test:local-ai": "npm test --workspace=@brai/local-ai",
    "test:integration:local-ai": "npm run test:integration --workspace=@brai/local-ai",
    "migrate:local-ai": "npm run migrate --workspace=@brai/local-ai",
    "build:transcription": "npm run build --workspace=@brai/transcription",
    "typecheck:transcription": "npm run typecheck --workspace=@brai/transcription",
    "test:transcription": "npm test --workspace=@brai/transcription",
    "test:integration:transcription:postgres": "npm run test:integration:postgres --workspace=@brai/transcription",
    "test:integration:transcription:helper:rpc": "npm run test:integration:helper:rpc --workspace=@brai/transcription",
    "test:integration:transcription:nats": "npm run test:integration:nats --workspace=@brai/transcription",
    "test:transcription:metadata": "npm run test:integration:metadata --workspace=@brai/transcription",
    "test:integration:transcription:asr": "npm run test:integration:asr --workspace=@brai/transcription",
    "test:integration:transcription:restart": "npm run test:integration:restart --workspace=@brai/transcription",
    "build:alerts": "npm run build --workspace=@brai/alerts",
    "build:elements": "npm run build --workspace=@brai/elements",
    "typecheck:alerts": "npm run typecheck --workspace=@brai/alerts",
    "typecheck:elements": "npm run typecheck --workspace=@brai/elements",
    "test:alerts": "npm run test --workspace=@brai/alerts",
    "test:elements": "npm run test --workspace=@brai/elements",
    "test:integration:alerts": "npm run test:integration --workspace=@brai/alerts",
    "migrate:alerts": "npm run migrate --workspace=@brai/alerts",
    "health:alerts": "npm run health --workspace=@brai/alerts"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0"
  }
}
