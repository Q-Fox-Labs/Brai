# ABOUTME: Запускает Duplicati с доступом к источникам резервных копий сервера.
# ABOUTME: Веб-интерфейс выключен; локальный API, ключи и пароль остаются закрытыми.
[Unit]
Description=Duplicati backup server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/duplicati/server.env
Environment=DUPLICATI_HOME=/var/lib/duplicati
ExecStart=/usr/bin/duplicati-server --webservice-interface=loopback --webservice-port=8200 --webservice-api-only=true --webservice-allowed-hostnames=localhost;127.0.0.1 --require-db-encryption-key=true --webservice-disable-signin-tokens=true
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
