# ABOUTME: Раздаёт готовые байты artifacts из отдельной закрытой точки.
# ABOUTME: Контейнер получает только files subpath volume read-only.
{
	admin off
	auto_https off
}

:9080 {
	respond /health 204
	@artifact path_regexp artifact ^/files/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$
	handle @artifact {
		uri strip_prefix /files
		root * /srv/artifacts
		header {
			>Content-Type application/octet-stream
			>Content-Disposition "attachment; filename=artifact"
			>Cache-Control no-store
			>X-Content-Type-Options nosniff
		}
		file_server
	}
	respond 404
}
