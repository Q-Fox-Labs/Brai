{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.app/codeworks/component-v1.schema.json",
  "title": "Codeworks component descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "type",
    "status",
    "environments",
    "executableSources",
    "inputs",
    "dependencies",
    "commands",
    "delivery",
    "deploy",
    "npm"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "type": {
      "enum": [
        "container",
        "program",
        "library"
      ]
    },
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "renamedTo": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "environments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "dev",
          "prod"
        ]
      },
      "description": "Supported delivery targets; actual enablement and host settings belong to the deployment operator."
    },
    "executableSources": {
      "$ref": "#/definitions/paths"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "runtime",
        "checks"
      ],
      "properties": {
        "build": {
          "$ref": "#/definitions/paths"
        },
        "runtime": {
          "$ref": "#/definitions/paths"
        },
        "checks": {
          "$ref": "#/definitions/paths"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inputs",
          "delivery"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "inputs": {
            "$ref": "#/definitions/paths"
          },
          "delivery": {
            "$ref": "#/definitions/paths"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "check"
      ],
      "properties": {
        "build": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "check": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "files",
        "entrypoints",
        "smokeImports",
        "systemRequirements"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ready-files",
            "oci-context"
          ]
        },
        "files": {
          "$ref": "#/definitions/paths"
        },
        "entrypoints": {
          "$ref": "#/definitions/paths"
        },
        "smokeImports": {
          "$ref": "#/definitions/paths"
        },
        "systemRequirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "migrations",
        "health"
      ],
      "properties": {
        "units": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migrations": {
          "$ref": "#/definitions/paths"
        },
        "health": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "npm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaces"
      ],
      "properties": {
        "workspaces": {
          "$ref": "#/definitions/paths"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "retired"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "definitions": {
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\).+$"
      }
    }
  }
}
