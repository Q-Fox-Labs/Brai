# ABOUTME: Проверяет browser session до выдачи готового artifact файла.
# ABOUTME: Заменяет клиентские identity headers и задаёт безопасные response headers.
(artifact-attachment) {
	@agent_upload path_regexp agent_upload ^/api/agent/uploads/([A-Za-z0-9_-]{16,512})$
	handle @agent_upload {
		route {
			@unsupported not method PUT
			respond @unsupported 405
			request_header -Cookie
			request_header -Authorization
			rewrite * /upload/{re.agent_upload.1}
			reverse_proxy {$BRAI_AGENT_ARTIFACTS_UPLOAD_UPSTREAM}
		}
	}
	@attachment path_regexp artifact_attachment ^/api/agent/attachments/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$
	handle @attachment {
		route {
			@unsupported not method GET HEAD
			respond @unsupported 405
			request_header -X-Artifact-Content-Type
			request_header -X-Artifact-Content-Disposition
			request_header -X-Artifact-Disposition
			request_header -X-Artifact-User
			request_header -X-Artifact-Project
			request_header -X-Artifact-Thread
			forward_auth {$BRAI_WEB_UPSTREAM} {
				uri /api/agent/artifact-auth
				header_up Cookie {http.request.header.Cookie}
				header_up X-Forwarded-Uri {http.request.uri}
				header_up X-Forwarded-Method {http.request.method}
				copy_headers Content-Type>X-Artifact-Content-Type Content-Disposition>X-Artifact-Content-Disposition
			}
			header {
				>Content-Type {http.request.header.X-Artifact-Content-Type}
				>Content-Disposition {http.request.header.X-Artifact-Content-Disposition}
				>Cache-Control "private, no-store"
				>X-Content-Type-Options nosniff
				>Cross-Origin-Resource-Policy same-origin
				>X-Frame-Options SAMEORIGIN
			}
			rewrite * /files/{re.artifact_attachment.1}
			reverse_proxy {$BRAI_AGENT_ARTIFACTS_FILE_SERVER}
		}
	}
	@result path_regexp artifact_result ^/api/agent/results/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$
	handle @result {
		route {
			@unsupported not method GET HEAD
			respond @unsupported 405
			request_header -X-Artifact-Content-Type
			request_header -X-Artifact-Content-Disposition
			request_header -X-Artifact-Disposition
			request_header -X-Artifact-User
			request_header -X-Artifact-Project
			request_header -X-Artifact-Thread
			forward_auth {$BRAI_WEB_UPSTREAM} {
				uri /api/agent/artifact-auth
				header_up Cookie {http.request.header.Cookie}
				header_up X-Forwarded-Uri {http.request.uri}
				header_up X-Forwarded-Method {http.request.method}
				copy_headers Content-Type>X-Artifact-Content-Type Content-Disposition>X-Artifact-Content-Disposition
			}
			header {
				>Content-Type {http.request.header.X-Artifact-Content-Type}
				>Content-Disposition {http.request.header.X-Artifact-Content-Disposition}
				>Cache-Control "private, no-store"
				>X-Content-Type-Options nosniff
				>Cross-Origin-Resource-Policy same-origin
				>X-Frame-Options SAMEORIGIN
			}
			rewrite * /files/{re.artifact_result.1}
			reverse_proxy {$BRAI_AGENT_RESULTS_FILE_SERVER}
		}
	}
}


(artifact-upload) {
	@upload path_regexp artifact_upload ^/upload/[A-Za-z0-9_-]{16,512}$
	handle @upload {
		route {
			@unsupported not method PUT
			respond @unsupported 405
			request_header -Cookie
			request_header -Authorization
			reverse_proxy {$BRAI_ARTIFACTS_UPLOAD_UPSTREAM}
		}
	}
}
