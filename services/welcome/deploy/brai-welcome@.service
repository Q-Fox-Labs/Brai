# ABOUTME: Запускает отдельный процесс справочной из принятого пакета.
# ABOUTME: Подписочная авторизация доступна через отдельный Unix-сокет.
[Unit]
Description=Brai Welcome (%i)
Wants=network-online.target
After=network-online.target brai-welcome-dialogues@%i.service
Requires=brai-welcome-dialogues@%i.service

[Service]
User=brai-welcome-%i
Group=brai-welcome-%i
WorkingDirectory=/var/lib/brai-welcome-%i
Environment=WELCOME_CONFIG=/etc/brai-welcome/%i/runtime.json
ExecStart=/usr/local/bin/node /opt/brai-welcome/%i/services/welcome/src/main.mjs
UMask=0077
ProtectHome=yes
ProtectSystem=strict
StateDirectory=brai-welcome-%i
StateDirectoryMode=0700
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure

[Install]
WantedBy=multi-user.target
