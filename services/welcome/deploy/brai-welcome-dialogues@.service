# ABOUTME: Запускает закрытую выдачу личных MCP-привязок Welcome.
# ABOUTME: У этой службы отдельный UID и закрытая конфигурация владельца БД.
[Unit]
Description=Brai Welcome personal Dialogues (%i)
Wants=network-online.target
After=network-online.target

[Service]
User=brai-welcome-mcp-%i
Group=brai-welcome-mcp-%i
Environment=DIALOGUES_WELCOME_CONFIG=/etc/brai-welcome/%i/dialogues.json
ExecStart=/usr/local/bin/node /opt/brai-welcome/%i/services/dialogues/dist/welcome-entry.js
UMask=0077
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
