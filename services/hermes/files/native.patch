 _MDV2_ESCAPE_RE = re.compile(r'([_*\[\]()~`>#\+\-=|{}.!\\])')
 
 
+def _brai_hide_bare_urls(content: str) -> str:
+    """Скрыть открытые адреса в ссылках, сохранив готовые ссылки и блоки кода."""
+    pattern = re.compile(r'```[\s\S]*?```|`[^`\n]*`|\[[^\]]+\]\([^()]*(?:\([^()]*\)[^()]*)*\)|https?://[^\s<>\x00]+')
+    def convert(match):
+        value = match.group(0)
+        if not value.startswith(('http://', 'https://')):
+            return value
+        suffix = ''
+        while value and (value[-1] in '.,;:!?' or value[-1] == ')' and value.count(')') > value.count('(')):
+            suffix = value[-1] + suffix
+            value = value[:-1]
+        return '[Ссылка](' + value + ')' + suffix
+    return pattern.sub(convert, content)
+
+
 def _escape_mdv2(text: str) -> str:
