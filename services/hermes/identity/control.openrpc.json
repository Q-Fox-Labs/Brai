{
  "openrpc": "1.3.2",
  "info": {
    "title": "Brai Hermes identity control private RPC",
    "version": "1.0.0",
    "description": "Только доверенный родительский broker; stdin/stdout UTF-8 JSON-RPC 2.0, один JSON документ на строку, без секретов в stdout и stderr. До 2162688 байт на запрос, не более 64 одновременных запросов и 64 элементов batch. Клиент сопоставляет id; timeout/disconnect не отменяет работу. Сроки задаёт вызывающий broker; неизвестный исход записи не повторяется вслепую. Callback состояния не передаётся RPC. Код входа и Telegram token никогда не возвращаются."
  },
  "methods": [
    {
      "name": "identity.get",
      "summary": "Прочитать актуальную идентичность Auth по стабильному userId для root lifecycle; не доступен Unix worker.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "userId",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "../../auth/schemas/messages.schema.json#/definitions/IdentityGetResponse"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/RequestFailed"
        },
        {
          "$ref": "#/components/errors/InvalidParams"
        }
      ]
    },
