            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "oneOf": [
            {
              "$ref": "#/components/schemas/ActivePrincipal"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "active"
              ],
              "properties": {
                "active": {
                  "const": false
                }
              }
            }
          ]
        }
      },
      "errors": [
        {
