{
  "openrpc": "1.3.2",
  "info": {
    "title": "Brai Hermes identity control private RPC",
    "version": "1.0.0",
    "description": "Только доверенный родительский broker; stdin/stdout UTF-8 JSON-RPC 2.0, один JSON документ на строку, без секретов в stdout и stderr. До 2162688 байт на запрос, не более 64 одновременных запросов и 64 элементов batch. Клиент сопоставляет id; timeout/disconnect не отменяет работу. Сроки задаёт вызывающий broker; неизвестный исход записи не повторяется вслепую. Callback состояния не передаётся RPC. Код входа и Telegram token никогда не возвращаются."
  },
  "methods": [
    {
      "name": "identity.resolve",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "telegramId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "../../auth/schemas/messages.schema.json#/definitions/TelegramResolveResponse"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/RequestFailed"
        },
        {
          "$ref": "#/components/errors/InvalidParams"
        }
      ]
    },
    {
      "name": "identity.invite-redeem",
      "paramStructure": "by-name",
      "description": "Имеет побочный эффект; после разрыва повтор не выполнять вслепую.",
      "params": [
        {
          "name": "telegramId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          }
        },
        {
          "name": "code",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        {
          "name": "name",
          "required": false,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "../../auth/schemas/messages.schema.json#/definitions/TelegramResolveResponse"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/RequestFailed"
        },
        {
          "$ref": "#/components/errors/InvalidParams"
        }
      ]
    },
    {
      "name": "identity.profile-ready",
      "paramStructure": "by-name",
      "description": "Промежуточная операция provisioning; повтор только по контракту Auth.",
      "params": [
        {
          "name": "userId",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        {
          "name": "profileId",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "../../auth/schemas/messages.schema.json#/definitions/TelegramResolveResponse"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/RequestFailed"
        },
        {
          "$ref": "#/components/errors/InvalidParams"
        }
      ]
    },
    {
      "name": "authorize",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "uid",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "result": {
        "name": "result",
