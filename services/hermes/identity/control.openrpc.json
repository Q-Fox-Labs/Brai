            "pattern": "^[0-9]+$"
          }
        },
        {
          "name": "privateChat",
          "required": true,
          "schema": {
            "type": "boolean",
            "description": "false отклоняется как denied до выдачи кода."
          }
        },
        {
          "name": "requestId",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        {
          "name": "threadId",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Тема исходного личного Telegram запроса; задаётся только доверенным ingress."
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "sent",
                "denied",
                "unavailable",
                "failed",
                "unknown"
