{
  "openrpc": "1.2.6",
  "info": {
    "title": "Brai Hermes worker IPC",
    "version": "1.0.0"
  },
  "methods": [
    {
      "name": "dispatch",
      "summary": "Доставить допущенное Telegram событие в личный runner.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "event",
          "required": true,
          "schema": {
            "type": "object",
            "required": [
              "source",
              "message_id",
              "delivery_scope",
              "chat_generation"
            ],
            "properties": {
              "source": {
                "type": "object"
              },
              "message_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "message_type": {
                "type": "string"
              },
              "user_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "user_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "media_urls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "media_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "media_text_inlined": {
                "type": "array",
                "items": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "reply_to_message_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reply_to_text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamp": {
                "type": "string"
              },
              "reply_expected": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "identity_inputs": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "itemId"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "caption": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "groupId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "delivery_scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "chat_generation": {
                "type": "integer",
                "minimum": 0,
                "description": "Монотонное поколение trusted ingress после durable admission. Более новое разрешённое поколение восстанавливает потерянную IPC квитанцию resume; старое не запускается."
              }
            },
            "additionalProperties": false
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "type": "object",
          "required": [
            "accepted",
            "turn_id"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "turn_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "name": "cancel",
      "summary": "Остановить привязанный активный ход.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "turn_id",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "result": {
        "name": "state",
        "schema": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "stopped",
                "stopping",
                "not_running"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "name": "send",
      "summary": "Обратный вызов worker для доставки через ingress.",
      "params": [
        {
          "name": "action",
          "required": true,
          "schema": {
            "enum": [
              "send",
              "edit_message",
              "send_typing",
              "send_draft",
              "send_file_set",
              "send_image",
              "send_animation",
              "send_image_file",
              "send_document",
              "send_video",
              "send_voice"
            ]
          }
        },
        {
          "name": "payload",
          "required": true,
          "description": "send_draft принимает chat_id, ненулевой integer draft_id, строку content до 65536 символов и metadata; native Root renderer отправляет временный preview в личный чат владельца без message_id. Файловые действия принимают artifact descriptor владельца. send_voice дополнительно принимает необязательный is_voice:boolean; true сохраняет голосовую подачу до native transport. Неподтверждённая доставка не возвращает успешную квитанцию. metadata._brai_return_notice_generation — необязательное неотрицательное целое поколение служебного уведомления; Root отклоняет устаревшее поколение и не расширяет доступ к адресу.",
          "schema": {
            "type": "object"
          }
        },
        {
          "name": "scope_id",
          "required": true,
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            },
            "message_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "raw_response": {},
            "retryable": {
              "type": "boolean"
            },
            "retry_after": {
              "type": [
                "number",
                "null"
              ]
            },
            "continuation_message_ids": {
              "type": "array"
            },
            "error_kind": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "errors": [
        {
          "code": -32003,
          "message": "Forbidden"
        }
      ]
    },
    {
      "name": "turn_ended",
      "summary": "Уведомить ingress о завершении конкретного хода.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "turn_id",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "name": "health",
      "summary": "Раздельно проверить транспортный bootstrap и полный native запуск профиля.",
      "params": [
        {
          "name": "require_tools",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          },
          "description": "Дождаться полного native startup и ограниченного каталога; подготовка не разрешает вызовы до active Auth."
        }
      ],
      "result": {
        "name": "status",
        "schema": {
          "type": "object",
          "required": [
            "ready",
            "userId",
            "telegramId",
            "operational",
            "policyReady",
            "role",
            "rolePolicyVersion"
          ],
          "properties": {
            "ready": {
              "const": true
            },
            "userId": {
              "type": "string"
            },
            "telegramId": {
              "type": "string"
            },
            "operational": {
              "type": "boolean"
            },
            "policyReady": {
              "description": "Auth и подключение policy завершены; удержанное восстановление может ещё ожидать release.resume.",
              "type": "boolean"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "admin",
                "user",
                "guest"
              ]
            },
            "rolePolicyVersion": {
              "const": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "name": "interactive",
      "summary": "Передать подлинный owner-bound callback/inline update из ingress в private native adapter.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "update",
          "required": true,
          "schema": {
            "type": "object"
          }
        },
        {
          "name": "scope_id",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        {
          "name": "actor_telegram_id",
          "required": true,
          "description": "Фактический аккаунт, допущенный Root через Auth; stable author worker не меняется.",
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        },
        {
          "name": "chat_generation",
          "required": false,
          "description": "Поколение trusted ingress. Отсутствие совместимо только с generation0 до первой паузы. Проверяется до activation и непосредственно до native callback; actor и effective private route остаются owner-bound.",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "description": "Paused или stale callback не исполняет native handler и не снимает recoveryBlocked. Birth-generation исходного bot message хранится доверенным ingress; date старого сообщения не является временем click. После pause/resume legacy или старые кнопки требуют нового prompt-сообщения текущего поколения. Inflight callbacks отменяются при pause, уже выполненный внешний эффект не отзывается."
    },
    {
      "name": "telegram_api",
      "summary": "Tokenless native UI; назначение, сообщение и query проверяет ingress.",
      "params": [
        {
          "name": "method",
          "required": true,
          "schema": {
            "enum": [
              "send_message",
              "edit_message_text",
              "edit_message_reply_markup",
              "delete_message",
              "answer_callback_query",
              "answer_inline_query"
            ]
          }
        },
        {
          "name": "payload",
          "required": true,
          "schema": {
            "type": "object"
          }
        },
        {
          "name": "scope_id",
          "required": true,
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "result": {
        "name": "telegramReceipt",
        "schema": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "message_id",
                "chat"
              ]
            },
            {
              "const": true
            }
          ]
        }
      }
    },
    {
      "name": "chat_pause",
      "summary": "Trusted ingress применяет route generation до отмены native хода. Только primary duplex; secondary остаётся health-only.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "chat",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        },
        {
          "name": "thread",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^$|^[1-9][0-9]{0,15}$",
            "not": {
              "const": "1"
            }
          }
        },
        {
          "name": "paused",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "generation",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "stopped",
                "stopping",
                "resumed"
              ]
            }
          }
        }
      }
    },
    {
      "name": "chat_states",
      "summary": "Обратный callback ingress: полный snapshot владельца до native startup. Недоступный snapshot запрещает startup/recovery.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "result": {
        "name": "snapshot",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "routes"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "routes": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chat",
                  "thread",
                  "paused",
                  "generation",
                  "recoveryBlocked",
                  "discardThrough",
                  "resumeAfter"
                ],
                "properties": {
                  "chat": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "thread": {
                    "type": "string",
                    "pattern": "^$|^[1-9][0-9]{0,15}$",
                    "not": {
                      "const": "1"
                    }
                  },
                  "paused": {
                    "type": "boolean"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "recoveryBlocked": {
                    "type": "boolean"
                  },
                  "discardThrough": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "resumeAfter": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "UTC Unix seconds: raw Telegram message date must be at or after durable resume barrier."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "release.begin",
      "paramStructure": "by-name",
      "summary": "Закрыть допуск источников и дождаться завершения принятой работы.",
      "params": [
        {
          "name": "operationId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        }
      ],
      "result": {
        "name": "release",
        "schema": {
          "type": "object",
          "required": [
            "operationId",
            "state",
            "reason"
          ],
          "properties": {
            "operationId": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "draining",
                "blocked",
                "ready",
                "resumed"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "name": "release.status",
      "paramStructure": "by-name",
      "summary": "Проверить активную работу и очереди без их изменения.",
      "params": [
        {
          "name": "operationId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        }
      ],
      "result": {
        "name": "release",
        "schema": {
          "type": "object",
          "required": [
            "operationId",
            "state",
            "reason"
          ],
          "properties": {
            "operationId": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "draining",
                "blocked",
                "ready",
                "resumed"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "name": "release.resume",
      "paramStructure": "by-name",
      "summary": "Снять барьер той же операции после завершения удержанного восстановления, без таймера ожидания.",
      "params": [
        {
          "name": "operationId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        }
      ],
      "result": {
        "name": "release",
        "schema": {
          "type": "object",
          "required": [
            "operationId",
            "state",
            "reason"
          ],
          "properties": {
            "operationId": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "draining",
                "blocked",
                "ready",
                "resumed"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  ]
}
