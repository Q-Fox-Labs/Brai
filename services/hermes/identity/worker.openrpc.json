{
  "openrpc": "1.2.6",
  "info": {
    "title": "Brai Hermes worker IPC",
    "version": "1.0.0"
  },
  "methods": [
    {
      "name": "dispatch",
      "summary": "Доставить допущенное Telegram событие в личный runner.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "event",
          "required": true,
          "schema": {
            "type": "object",
            "required": [
              "source",
              "message_id"
            ],
            "properties": {
              "source": {
                "type": "object"
              },
              "message_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "message_type": {
                "type": "string"
              },
              "user_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "user_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "media_urls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "media_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "media_text_inlined": {
                "type": "array",
                "items": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "reply_to_message_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reply_to_text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamp": {
                "type": "string"
              },
              "reply_expected": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "identity_inputs": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "itemId"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "caption": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "groupId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "type": "object",
          "required": [
            "accepted",
            "turn_id"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "turn_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "name": "cancel",
      "summary": "Остановить привязанный активный ход.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "turn_id",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "result": {
        "name": "state",
        "schema": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "stopped",
                "stopping",
                "not_running"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "name": "send",
      "summary": "Обратный вызов worker для доставки через ingress.",
      "params": [
        {
          "name": "action",
          "required": true,
          "schema": {
            "enum": [
              "send",
              "edit_message",
              "send_typing",
              "send_image",
              "send_animation",
              "send_image_file",
              "send_document",
              "send_video",
              "send_voice"
            ]
          }
        },
        {
          "name": "payload",
          "required": true,
          "description": "Файловые действия принимают artifact descriptor владельца. send_voice дополнительно принимает необязательный is_voice:boolean; true сохраняет голосовую подачу до native transport. Неподтверждённая доставка не возвращает успешную квитанцию.",
          "schema": {
            "type": "object"
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            },
            "message_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "raw_response": {},
            "retryable": {
              "type": "boolean"
            },
            "retry_after": {
              "type": [
                "number",
                "null"
              ]
            },
            "continuation_message_ids": {
              "type": "array"
            },
            "error_kind": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "name": "turn_ended",
      "summary": "Уведомить ingress о завершении конкретного хода.",
      "params": [
        {
          "name": "owner",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "turn_id",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "name": "health",
      "summary": "Проверить готовность runner и привязку; только подтверждённому UID ingress.",
      "params": [
        {
          "name": "require_tools",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          },
          "description": "После активации Auth также загрузить MCP и проверить инструмент входа."
        }
      ],
      "result": {
        "name": "status",
        "schema": {
          "type": "object",
          "required": [
            "ready",
            "userId",
            "telegramId"
          ],
          "properties": {
            "ready": {
              "const": true
            },
            "userId": {
              "type": "string"
            },
            "telegramId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
