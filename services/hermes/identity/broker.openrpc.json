    {
      "name": "ingress.admit",
      "description": "Register trusted Telegram route/turn/input before user RPC. inputId is SHA-256 of actual message identity and current text/media/timestamp supplied only by ingress, never by model. Same input preserves request/outcome; a new actual input resets login suppression and uses a distinct stable login requestId. Legacy omission is scoped to turnId. Competing active turn/binding is rejected.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "telegramId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        {
          "name": "turnId",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        {
          "name": "chatId",
          "required": true,
          "schema": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        {
          "name": "privateChat",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "inputId",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        {
          "name": "threadId",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Тема исходного личного Telegram запроса; задаётся только доверенным ingress."
          }
        },
        {
          "name": "linkConsent",
          "required": false,
          "description": "Computed only from the trusted new user message; never accepted from the model. Broker requires a pending delivered warning for that account and topic.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "expectedUid",
          "required": false,
          "description": "Trusted ingress pins the resolved worker UID before admission; alias rebinding must fail before reserving another owner turn.",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "unlinkConsent",
          "required": false,
          "description": "Legacy exact target parsed from trusted human text. Contextual short explicit consent uses linkConsent for the pinned unlink offer as well.",
          "schema": {
            "type": "string",
            "pattern": "^([1-9][0-9]{0,19})?$"
          }
        },
        {
          "name": "messageId",
          "required": false,
          "description": "Trusted original Telegram message ID. Confirmation requires a strictly later message than the delivered offer; editing an old message cannot confirm.",
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        },
        {
          "name": "accountRefused",
          "required": false,
          "description": "Trusted ingress recognizes an explicit refusal in the actual new message; never accepted from model.",
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/ParseError"
