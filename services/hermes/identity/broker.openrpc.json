{
  "openrpc": "1.3.2",
  "info": {
    "title": "Brai Hermes identity broker",
    "version": "1.0.0",
    "description": "Unix JSON-RPC 2.0, one UTF-8 NDJSON frame per connection; singleton or sequential batch of 1..16 requests. Notifications produce no response. SO_PEERCRED chooses caller role for every batch item. Frame at most 2 MiB, 32 concurrently admitted connections; control pending at most 32. Initial frame deadline 5s; authorization 3s, bootstrap/configuration 35s, file operations 1800s. Disconnect/timeout does not prove cancellation; no automatic mutation replay. Worker methods reject uid/owner parameters. See ../files/CONTRACT.md for stable inode, root snapshot, per-user cache and ingress-copy requirements. Login delivery requires loginDeliveryStatePath: root-owned regular SQLite file mode 0600 inside root-owned parent directories without group/other write. Broker creates a missing database mode 0600; existing unsafe files or symlink paths are rejected. maxLoginReceipts defaults to 1000000, can be raised by operator, and never evicts existing receipts."
  },
  "methods": [
    {
      "name": "authorize",
      "description": "Root-only admission check; user and profile must remain active.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "uid",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": [
            "allowed"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/ParseError"
        },
        {
          "$ref": "#/components/errors/InvalidRequest"
