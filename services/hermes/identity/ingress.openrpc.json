{
  "openrpc": "1.3.2",
  "info": {
    "title": "Brai trusted Telegram ingress chat control",
    "version": "1.0.0",
    "description": "JSON-RPC 2.0 newline frames via ingressControlSocket. Только root peer UID=0; path protected root parent with ingress-only ACL, socket mode0600 owned by ingress. До16 соединений,64 RPC tasks на соединение, кадр до1MiB, connection lifetime30s. Control ограничивает response32KiB и timeout10s. Timeout не снимает committed pause. Повтор того же состояния идемпотентен; повторное audit требуется публичным Control. Не создаёт worker connection."
  },
  "methods": [
    {
      "name": "chats.control",
      "paramStructure": "by-name",
      "summary": "Root Control выбирает owner из registry. paused отсутствует: читать; true: commit pause и остановить через primary duplex; false: снять запрет без replay.",
      "params": [
        {
          "name": "userId",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "profileId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "chat",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        },
        {
          "name": "thread",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^$|^[1-9][0-9]{0,15}$",
            "not": {
              "const": "1"
            }
          }
        },
        {
          "name": "paused",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "control",
        "schema": {
          "$ref": "./schemas/control.schema.json#/definitions/ChatControlBody"
        }
      },
      "errors": [
        {
          "code": -32602,
          "message": "Invalid chat control"
        },
        {
          "code": -32603,
          "message": "Internal error"
        }
      ]
    },
