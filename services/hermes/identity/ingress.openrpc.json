            "workerStartTime",
            "state",
            "reason"
          ],
          "properties": {
            "operationId": {
              "type": "string",
              "format": "uuid"
            },
            "attemptId": {
              "type": "string",
              "format": "uuid"
            },
            "profileId": {
              "type": "string",
              "format": "uuid"
            },
            "targetPayloadHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "workerPid": {
              "type": "integer",
              "minimum": 1
