+    def _init_recall_index(self, cur):
+        """Создать производный индекс; исходные записи и embedding не изменяются."""
+        cur.execute("CREATE EXTENSION IF NOT EXISTS pg_trgm")
+        cur.execute(f"""
+            CREATE OR REPLACE FUNCTION {self.schema}.brai_recall_text_v1(text, jsonb)
+            RETURNS text LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $recall$
+              SELECT CASE WHEN $2->'info'->>'hermes_kind' = 'fact'
+                THEN COALESCE($2->'info'->>'hermes_fact_text', $1)
+                ELSE COALESCE((SELECT string_agg(
+                  COALESCE(m->>'role', 'source') || ': ' || COALESCE(m->>'content', ''),
+                  E'\\n\\n' ORDER BY n)
+                  FROM jsonb_array_elements(CASE WHEN jsonb_typeof(
+                    $2->'info'->'hermes_messages') = 'array'
+                    THEN $2->'info'->'hermes_messages' ELSE '[]'::jsonb END)
+                    WITH ORDINALITY AS message(m,n)), $1) END
+            $recall$
+        """)
+        # AIDEV-NOTE: Только первая часть хранит запись полнотекстового индекса.
+        # Поиск смысла проверяет embedding КАЖДОЙ части, затем объединяет источники.
+        cur.execute(f"""
+            CREATE INDEX IF NOT EXISTS idx_brai_recall_text_v1 ON {self.schema}.memories
+            USING gin ({self.schema}.brai_recall_text_v1(memory, properties) gin_trgm_ops)
+            WHERE properties->'info'->'hermes_chunk_index' IS NULL
+               OR properties->'info'->'hermes_chunk_index' = '0'::jsonb
+        """)
+
+        # Hash keys keep this derived date index bounded for legacy identifiers.
+        # The lookup also compares original text, so collisions cannot change dates.
+        cur.execute(f"""
+            CREATE INDEX IF NOT EXISTS idx_brai_recall_source_date_v1
+            ON {self.schema}.memories (
+              user_name, md5(properties->'info'->>'hermes_author_id'),
+              md5(properties->'info'->>'hermes_event_id'), created_at)
+        """)
+
+    def recall_index(self, *, cubes, user_id, scope, author_id, query, vector,
+                     shared_infra=False, project=None, goal='evidence', relativity=0.45):
+        """Искать все совпадения в одной области и snapshot без ANN/top_k и LLM."""
+        import math
+        import re
+        import time
+        started = time.monotonic()
+        if (not isinstance(cubes, list) or not cubes
+                or any(not isinstance(c, str) or not c for c in cubes)
+                or not isinstance(user_id, str) or not user_id
+                or not isinstance(author_id, str) or not author_id
+                or not isinstance(scope, dict) or set(scope) != {'hermes_home_scope', 'hermes_memory_epoch'}
+                or any(not isinstance(v, str) or not v for v in scope.values())
+                or not isinstance(query, str) or not query.strip()
+                or goal not in ('evidence', 'locate_document', 'latest_conversation', 'latest_topic')
+                or type(shared_infra) is not bool
+                or (project is not None and not isinstance(project, str))
+                or not isinstance(vector, list) or not vector
+                or any(type(v) not in (float, int) or not math.isfinite(v) for v in vector)
+                or not any(vector)
+                or type(relativity) not in (float, int) or not 0 <= relativity <= 1):
+            raise ValueError('Invalid recall index request')
+        # JSONB containment uses the existing GIN scope index; no foreign archive is transferred.
+        clauses = ["user_name = ANY(%s)", "properties @> %s::jsonb",
+                   "properties->'info'->>'hermes_kind' IS DISTINCT FROM 'checkpoint'",
+                   "properties->'info'->>'hermes_visibility' IS DISTINCT FROM 'business_private'",
+                   "(properties->'info'->'hermes_business_scope' IS NULL OR properties->'info'->'hermes_business_scope' = 'null'::jsonb)",
+                   "properties->'info'->>'hermes_cube' = user_name",
+                   "(properties->'info'->'hermes_memberships') @> to_jsonb(ARRAY[user_name])"]
+        params = [cubes, json.dumps({'user_id': user_id, 'info': scope})]
+        own = "properties @> %s::jsonb"
+        params.append(json.dumps({'info': {'hermes_author_id': author_id}}))
+        if shared_infra:
+            own = "(" + own + " OR (user_name = 'infra' AND properties @> %s::jsonb))"
+            params.append(json.dumps({'info': {'hermes_shared_infra': True}}))
+        clauses.append(own)
+        if project is not None:
+            clauses.append("properties @> %s::jsonb")
+            params.append(json.dumps({'info': {'hermes_projects': [project]}}))
+        where = " AND ".join(clauses)
+        anchor = "(properties->'info'->'hermes_chunk_index' IS NULL OR properties->'info'->'hermes_chunk_index' = '0'::jsonb)"
+        key = """jsonb_build_array(properties->'info'->>'hermes_author_id',
+            CASE WHEN properties->'info'->>'hermes_kind' = 'fact' THEN 'fact' ELSE 'source' END,
+            COALESCE(CASE WHEN properties->'info'->>'hermes_kind' = 'fact'
+                THEN properties->'info'->>'hermes_logical_id'
+                ELSE properties->'info'->>'hermes_event_id' END, id))"""
+        # LIKE metacharacters are escaped, including literal "_" identifiers.
+        terms = list(dict.fromkeys(re.findall(r'\w+', query, flags=re.UNICODE)))
+        def pattern(term):
+            return '%' + term.replace(chr(92), chr(92)*2).replace('%', chr(92)+'%').replace('_', chr(92)+'_') + '%'
+        patterns = [pattern(term) for term in terms] or [pattern(query)]
+        conn = self._get_conn()
+        old_autocommit = conn.autocommit
+        try:
+            conn.autocommit = False
+            with conn.cursor() as cur:
+                cur.execute("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY")
+                cur.execute("SET LOCAL statement_timeout = '30s'")
+                cur.execute("SET LOCAL idle_in_transaction_session_timeout = '30s'")
+                cur.execute(f"""SELECT count(*), count(*) FILTER (WHERE embedding IS NULL OR vector_norm(embedding) = 0),
+                    count(DISTINCT {key}), count(DISTINCT {key}) FILTER (WHERE {anchor})
+                    FROM {self.schema}.memories WHERE {where}""", params)
+                physical, missing, logical, anchored = cur.fetchone()
+                if missing or logical != anchored:
+                    raise ValueError('Recall index coverage incomplete')
+                # Убираем служебные слова и добавляем основы слов обеих языковых
+                # конфигураций PostgreSQL. Иначе обычное "мы обсуждали в поездке"
+                # делает почти весь архив лексическим совпадением по одному "в".
+                cur.execute("SELECT term, ts_lexize('russian_stem', term), ts_lexize('english_stem', term) "
+                            "FROM unnest(%s::text[]) AS term", [terms])
+                meaningful = []
+                for term, russian, english in cur.fetchall():
+                    if russian != [] and english != []:
+                        meaningful.extend([term, *(russian or []), *(english or [])])
+                if meaningful:
+                    patterns = [pattern(term) for term in dict.fromkeys(meaningful)]
+                elif terms:
+                    patterns = [pattern(query)]
+                # AIDEV-NOTE: No ORDER BY vector-distance/LIMIT: pgvector uses exact
+                # cosine distances, not the approximate ivfflat nearest-neighbour index.
+                hit = f"""SELECT {key} AS logical FROM {self.schema}.memories WHERE {where}
+                    AND embedding <=> %s::vector <= %s
+                    UNION SELECT {key} AS logical FROM {self.schema}.memories WHERE {where}
+                    AND {anchor} AND {self.schema}.brai_recall_text_v1(memory,properties) ILIKE ANY(%s)"""
+                args = [*params, json.dumps(vector), 1 - relativity, *params, patterns]
+                if goal == 'locate_document':
+                    # Verified artifact filenames may be opaque in archived pointers.
+                    # Every document-bearing source remains eligible for metadata resolution.
+                    hit += f""" UNION SELECT {key} AS logical FROM {self.schema}.memories
+                        WHERE {where} AND {anchor} AND {self.schema}.brai_recall_text_v1(memory,properties)
+                        ~* '(artifact|\\.(pdf|docx?|odt|md|txt|html|xlsx?|csv))'"""
+                    args.extend(params)
+                if goal == 'latest_conversation':
+                    # Only compact dates/keys are evaluated across the archive; text is
+                    # fetched for the newest source and all timestamp ties.
+                    source = f"""SELECT {key} AS logical, created_at FROM {self.schema}.memories
+                        WHERE {where} AND {anchor}
+                        AND properties->'info'->>'hermes_kind' IN ('turn','native')
+                        AND NOT (EXISTS (SELECT 1 FROM jsonb_array_elements(COALESCE(
+                            properties->'info'->'hermes_messages', '[]'::jsonb)) AS m
+                            WHERE m->>'role' = 'user')
+                            AND NOT EXISTS (SELECT 1 FROM jsonb_array_elements(COALESCE(
+                            properties->'info'->'hermes_messages', '[]'::jsonb)) AS m
+                            WHERE m->>'role' = 'user' AND m->>'content' !~ %s))"""
+                    internal_pattern = r'^(?:\[[^\]\n]+\]\s*)?\[ASYNC DELEGATION BATCH COMPLETE[^\n]*\]\s*A background fan-out unit you dispatched earlier'
+                    hit = f"SELECT logical FROM ({source}) AS sources WHERE created_at = (SELECT max(created_at) FROM ({source}) AS dates)"
+                    args = [*params, internal_pattern, *params, internal_pattern]
+                # Materialize compact source keys once: a correlated date lookup
+                # re-reads large transcript JSON for every selected fact on real archives.
+                cur.execute(f"""
+                    WITH hits AS MATERIALIZED ({hit}), anchors AS MATERIALIZED (
+                      SELECT {key} AS logical, id,memory,properties,created_at,updated_at,user_name
+                      FROM {self.schema}.memories WHERE {where} AND {anchor}
+                    ), chosen AS MATERIALIZED (
+                      SELECT DISTINCT ON (logical) id, memory, properties, created_at, updated_at, user_name,
+                        properties->'info'->>'hermes_source_event' AS source_event,
+                        properties->'info'->>'hermes_author_id' AS author_id
+                      FROM anchors WHERE logical IN (SELECT logical FROM hits)
+                      ORDER BY logical, updated_at DESC NULLS LAST, created_at DESC NULLS LAST, id
+                    ), source_dates AS MATERIALIZED (
+                      SELECT links.source_event AS event_id, links.author_id,
+                        min(s.created_at) AS source_date
+                      FROM (SELECT DISTINCT source_event,author_id FROM chosen
+                        WHERE source_event IS NOT NULL AND author_id IS NOT NULL) AS links
+                      LEFT JOIN {self.schema}.memories AS s
+                        ON s.user_name = ANY(%s) AND s.properties @> %s::jsonb
+                        AND md5(s.properties->'info'->>'hermes_event_id') = md5(links.source_event)
+                        AND md5(s.properties->'info'->>'hermes_author_id') = md5(links.author_id)
+                        AND s.properties->'info'->>'hermes_event_id' = links.source_event
+                        AND s.properties->'info'->>'hermes_author_id' = links.author_id
+                      GROUP BY 1,2
+                    )
+                    SELECT c.id,c.memory,c.properties,c.created_at,c.updated_at,c.user_name,d.source_date
+                    FROM chosen AS c LEFT JOIN source_dates AS d
+                      ON d.event_id = c.source_event AND d.author_id = c.author_id
+                    ORDER BY c.created_at DESC NULLS LAST,c.id
+                """, [*args, *params, cubes, json.dumps({'user_id': user_id, 'info': scope})])
+                rows = []
+                for raw in cur:
+                    row = self._parse_row(raw[:5], False)
+                    row['_cube_id'] = raw[5]
+                    row['_source_date'] = raw[6].isoformat() if raw[6] is not None else None
+                    rows.append(row)
+                return {'version': 1, 'complete': True, 'physical_count': physical,
+                        'logical_count': logical, 'matched_count': len(rows), 'memories': rows,
+                        'elapsed_seconds': time.monotonic() - started}
+        finally:
+            try:
+                conn.rollback()
+                conn.autocommit = old_autocommit
+            finally:
+                self._put_conn(conn)
