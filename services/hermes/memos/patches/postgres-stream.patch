+@router.post("/feedback_scoped", summary="Owner-projected synchronous feedback")
+def feedback_scoped(feedback_req: ScopedFeedbackRequest):
+    # Existing internal API network boundary; only Identity Root constructs the projection.
+    if not _feedback_scope_gate.acquire(blocking=False):
+        raise HTTPException(429, "FEEDBACK_BUSY")
+    try:
+        return run_scoped_feedback(feedback_handler.feedback_server, feedback_req.model_dump())
+    except FeedbackScopeError as error:
+        status = 503 if error.code in {
+            "FEEDBACK_OUTCOME_UNKNOWN", "FEEDBACK_STORAGE_FAILED",
+            "FEEDBACK_DEADLINE_EXCEEDED", "FEEDBACK_READBACK_FAILED"} else 409
+        raise HTTPException(status, error.code) from None
+    except Exception:
+        raise HTTPException(503, "FEEDBACK_UNAVAILABLE") from None
+    finally:
+        _feedback_scope_gate.release()
