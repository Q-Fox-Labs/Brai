+    memory_stream_version = 1
+
+    def stream_memory(self, *, cube_id, user_id, filter=None):
+        """Читать все подходящие записи одним snapshot без выгрузки графа в RAM.
+
+        Только новый opt-in endpoint. Старый export_graph сохраняет свой контракт.
+        Закрытие итератора отменяет чтение и возвращает соединение в pool.
+        """
+        import uuid
+
+        if not isinstance(cube_id, str) or not cube_id or not isinstance(user_id, str) or not user_id:
+            raise ValueError("Memory stream requires cube and owner")
+        if filter is not None and not isinstance(filter, dict):
+            raise ValueError("Memory stream filter must be an object")
+        clauses = ["user_name = %s", "properties->'user_id' = %s::jsonb"]
+        params = [cube_id, json.dumps(user_id)]
+        date_filters = {}
+        for key, value in (filter or {}).items():
+            if not isinstance(key, str) or not key or any(not part for part in key.split('.')):
+                raise ValueError("Invalid memory stream filter")
+            if key in ('created_at', 'updated_at'):
+                # AIDEV-NOTE: _parse_row заменяет metadata датой SQL-колонки.
+                # Сравниваем тот же Python isoformat, включая NULL и timezone;
+                # строковое приведение PostgreSQL имело бы другую семантику.
+                date_filters[key] = value
+                continue
+            if key == 'id':
+                clauses.append("id::text = %s")
+                params.append(str(value))
+            else:
+                path = key.split('.')
+                if value is None:
+                    clauses.append("(properties #> %s::text[] IS NULL OR properties #> %s::text[] = 'null'::jsonb)")
+                    params.extend([path, path])
+                else:
+                    clauses.append("properties #> %s::text[] = %s::jsonb")
+                    params.extend([path, json.dumps(value)])
+        conn = self._get_conn()
+        old_autocommit = conn.autocommit
+        try:
+            # AIDEV-NOTE: Один snapshot исключает пропуски между HTTP-страницами.
+            conn.autocommit = False
+            with conn.cursor() as setup:
+                setup.execute("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY")
+                setup.execute("SET LOCAL statement_timeout = '30s'")
+                setup.execute("SET LOCAL idle_in_transaction_session_timeout = '30s'")
+            with conn.cursor(name='brai_memory_' + uuid.uuid4().hex) as cursor:
+                # AIDEV-NOTE: До передачи в Python отказываем чрезмерной записи;
+                # исключение не завершает поток trailer и не выдаёт частичную память.
+                cursor.execute(
+                    f"SELECT id, CASE WHEN octet_length(memory) + octet_length(properties::text) <= 8384512 THEN memory END, "
+                    f"CASE WHEN octet_length(memory) + octet_length(properties::text) <= 8384512 THEN properties END, "
+                    f"created_at, updated_at FROM {self.schema}.memories WHERE "
+                    + " AND ".join(clauses) + " ORDER BY created_at DESC, id DESC",
+                    params,
+                )
+                while True:
+                    batch = cursor.fetchmany(1)
+                    if not batch:
+                        break
+                    if batch[0][2] is None:
+                        raise ValueError("Memory record exceeds stream limit")
+                    row = self._parse_row(batch[0], False)
+                    if all(row['metadata'].get(key) == value for key, value in date_filters.items()):
+                        yield row
+        finally:
+            try:
+                conn.rollback()
+                conn.autocommit = old_autocommit
+            finally:
+                self._put_conn(conn)
+
