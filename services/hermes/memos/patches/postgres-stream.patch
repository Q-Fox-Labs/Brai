+    """Искать по существующим векторам и текстовому индексу без чтения архива моделью."""
+    import time
+    started = time.monotonic()
+    store = naive_mem_cube.text_mem.graph_store
+    if getattr(store, 'memory_index_version', None) != 1:
+        raise HTTPException(501, 'Recall index unavailable')
+    required = {'cubes', 'user_id', 'scope', 'author_id', 'query'}
+    optional = {'shared_infra', 'project', 'goal'}
+    if (set(body) - required - optional or not required <= set(body)
+            or not isinstance(body['query'], str) or not body['query'].strip()):
+        raise HTTPException(422, 'Invalid recall index request')
+    embedding_started = time.monotonic()
+    try:
+        vector = naive_mem_cube.text_mem.embedder.embed([body['query']])[0]
+    except Exception as error:
+        logger.warning('Recall index: stage=embedding outcome=%s elapsed=%.3fs',
+                       type(error).__name__, time.monotonic() - embedding_started)
+        raise HTTPException(503, 'Recall query embedding unavailable') from None
+    embedded = time.monotonic() - embedding_started
+    database_started = time.monotonic()
+    try:
+        result = store.recall_index(**body, vector=list(vector))
+    except ValueError:
+        logger.warning('Recall index: stage=database outcome=invalid elapsed=%.3fs',
+                       time.monotonic() - database_started)
+        raise HTTPException(409, 'Recall index invalid or incomplete') from None
+    except Exception as error:
+        logger.warning('Recall index: stage=database outcome=%s elapsed=%.3fs',
+                       type(error).__name__, time.monotonic() - database_started)
+        raise HTTPException(503, 'Recall index unavailable') from None
+    logger.info('Recall index: embedding=%.3fs database=%.3fs total=%.3fs physical=%d logical=%d matched=%d',
+                embedded, result['elapsed_seconds'], time.monotonic() - started,
+                result['physical_count'], result['logical_count'], result['matched_count'])
+    return {'code': 200, 'data': result}
+
+
+@router.post("/get_memory_stream")
+async def get_memory_stream(body: dict):
+    """Передать все записи области без полной сериализации графа в памяти API."""
+    import json
+    import anyio
+    from fastapi.responses import StreamingResponse
+
+    store = naive_mem_cube.text_mem.graph_store
+    if getattr(store, 'memory_stream_version', None) != 1:
+        raise HTTPException(501, 'Memory stream unavailable')
+    if (set(body) - {'mem_cube_id', 'user_id', 'filter'}
+            or not isinstance(body.get('mem_cube_id'), str) or not body['mem_cube_id']
+            or not isinstance(body.get('user_id'), str) or not body['user_id']
+            or not isinstance(body.get('filter', {}), dict)):
+        raise HTTPException(422, 'Invalid memory stream request')
+    iterator = store.stream_memory(cube_id=body['mem_cube_id'], user_id=body['user_id'], filter=body.get('filter'))
+
+    async def records():
+        count = 0
+        def encode(value):
+            raw = json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8') + b'\n'
+            if len(raw) > 8388608:
+                raise ValueError('Memory record exceeds stream limit')
+            return raw
+        try:
+            yield encode({'type': 'header', 'version': 1, 'cube_id': body['mem_cube_id'], 'user_id': body['user_id']})
+            while True:
+                row = await anyio.to_thread.run_sync(lambda: next(iterator, None))
+                if row is None:
+                    break
+                yield encode({'type': 'memory', 'memory': row})
+                count += 1
+            yield encode({'type': 'end', 'count': count})
+        finally:
+            # AIDEV-NOTE: Disconnect/cancel тоже закрывает snapshot; cancellation
+            # не должна прервать rollback или оставить соединение занятым.
+            with anyio.CancelScope(shield=True):
+                await anyio.to_thread.run_sync(iterator.close)
+
+    return StreamingResponse(records(), media_type='application/x-ndjson')
+
+
