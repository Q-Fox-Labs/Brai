+@router.post("/get_memory_stream")
+async def get_memory_stream(body: dict):
+    """Передать все записи области без полной сериализации графа в памяти API."""
+    import json
+    import anyio
+    from fastapi.responses import StreamingResponse
+
+    store = naive_mem_cube.text_mem.graph_store
+    if getattr(store, 'memory_stream_version', None) != 1:
+        raise HTTPException(501, 'Memory stream unavailable')
+    if (set(body) - {'mem_cube_id', 'user_id', 'filter'}
+            or not isinstance(body.get('mem_cube_id'), str) or not body['mem_cube_id']
+            or not isinstance(body.get('user_id'), str) or not body['user_id']
+            or not isinstance(body.get('filter', {}), dict)):
+        raise HTTPException(422, 'Invalid memory stream request')
+    iterator = store.stream_memory(cube_id=body['mem_cube_id'], user_id=body['user_id'], filter=body.get('filter'))
+
+    async def records():
+        count = 0
+        def encode(value):
+            raw = json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8') + b'\n'
+            if len(raw) > 8388608:
+                raise ValueError('Memory record exceeds stream limit')
+            return raw
+        try:
+            yield encode({'type': 'header', 'version': 1, 'cube_id': body['mem_cube_id'], 'user_id': body['user_id']})
+            while True:
+                row = await anyio.to_thread.run_sync(lambda: next(iterator, None))
+                if row is None:
+                    break
+                yield encode({'type': 'memory', 'memory': row})
+                count += 1
+            yield encode({'type': 'end', 'count': count})
+        finally:
+            # AIDEV-NOTE: Disconnect/cancel тоже закрывает snapshot; cancellation
+            # не должна прервать rollback или оставить соединение занятым.
+            with anyio.CancelScope(shield=True):
+                await anyio.to_thread.run_sync(iterator.close)
+
+    return StreamingResponse(records(), media_type='application/x-ndjson')
+
