+from memos.api.product_models import ScopedFeedbackRequest
+from memos.graph_dbs.brai_feedback_scope import run_scoped_feedback, FeedbackScopeError
+from threading import BoundedSemaphore as _FeedbackSemaphore
+_feedback_scope_gate = _FeedbackSemaphore(2)
