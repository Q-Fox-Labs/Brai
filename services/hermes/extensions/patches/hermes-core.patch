+@pytest.mark.asyncio
+async def test_partial_return_delivery_survives_another_process(lifecycle):
+    runner, adapter, marker = lifecycle
+    _add_task(runner, "-1001", "7")
+    _add_task(runner, "-1001", "9")
+    await asyncio.wait_for(runner._notify_active_sessions_of_shutdown(), timeout=5.0)
+    adapter.send = AsyncMock(side_effect=[SendResult(success=True), SendResult(success=False, error="retry")])
+    await _boot(runner)
