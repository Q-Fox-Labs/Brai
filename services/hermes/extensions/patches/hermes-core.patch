index 00000000..f196f46f
--- /dev/null
+++ b/gateway/return_notices.py
@@ -0,0 +1,245 @@
+# ABOUTME: Хранит адресатов успешно доставленных предупреждений об остановке.
+# ABOUTME: Подтверждает возврат по одному адресу, сохраняя ошибки для повтора.
+"""Долговечные парные уведомления native gateway; без содержимого переписки."""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import json
+import logging
+from typing import Optional
+from pathlib import Path
+from uuid import uuid4
+
+from utils import atomic_json_write
+
+
+def read_return_notices(path: Path) -> list[dict] | None:
+    """Вернуть ожидающие адреса; None означает отсутствие нового формата.
+
+    Повреждённый файл вызывает исключение и не заменяется пустым состоянием.
+    Старый planned-restart marker обрабатывается штатным отправителем.
+    """
+    try:
+        data = json.loads(path.read_text(encoding="utf-8-sig"))
+    except FileNotFoundError:
+        return None
+    return data.get("recipients")
+
+
+def return_notice_key(platform: str, chat_id, thread_id, profile=None) -> tuple:
+    """Вернуть ключ бота, чата и топика; default и None обозначают основной бот."""
+    return (profile if profile not in ("", "default") else None,
+            str(platform), str(chat_id), str(thread_id) if thread_id is not None else None)
+
+
+def adapter_notice_profile(adapter, platform, primary: dict, secondary: dict) -> str | None:
+    """Найти владельца фактического транспорта; неизвестный бот вызывает LookupError."""
+    for profile, adapters in [(None, primary), *secondary.items()]:
+        if adapters.get(platform) is adapter:
+            return profile
+    raise LookupError("Shutdown notice adapter is not owned by this gateway")
+
+
+def remember_return_notice(path: Path, platform: str, chat_id, thread_id, profile=None) -> None:
+    """Атомарно сохранить адрес успешного предупреждения; не хранить токены и текст.
+
+    Повторное предупреждение тому же адресу заменяет его квитанцию. Новая
+    квитанция защищена от подтверждения более ранней отправкой после await.
+    """
+    recipients = read_return_notices(path) or []
+    key = return_notice_key(platform, chat_id, thread_id, profile)
+    recipients = [r for r in recipients if return_notice_key(
+        r["platform"], r["chat_id"], r.get("thread_id"), r.get("profile")) != key]
+    recipients.append(dict(platform=key[1], chat_id=key[2], thread_id=key[3],
+                           profile=key[0], notice_id=uuid4().hex))
+    atomic_json_write(path, {"recipients": recipients}, mode=0o600, fsync_dir=True)
+
+
+def acknowledge_return_notice(path: Path, notice_id: str) -> None:
+    """Удалить только успешно доставленную квитанцию, сохраняя новые записи."""
+    recipients = read_return_notices(path)
+    if recipients is None:
+        return
+    remaining = [r for r in recipients if r["notice_id"] != notice_id]
+    if remaining:
+        atomic_json_write(path, {"recipients": remaining}, mode=0o600, fsync_dir=True)
+    else:
+        path.unlink(missing_ok=True)
+
+
+def resume_note_interactive(runner, source) -> bool:
+    """Выбрать вариант восстановления по фактическому адаптеру разговора."""
+    return bool(getattr(runner._delivery_adapter_for(source), "interactive_resume", True))
+
+
+def build_resume_recovery_note(
+    reason: Optional[str], message: str = "", *, interactive: bool = True) -> str:
+    """Build the resume-pending recovery system note for an interrupted turn (empty ``message`` = auto-resume).
+
+    Empty startup events continue the interrupted task on every platform.
+
+    On non-interactive event platforms (webhook, API server — adapters with ``interactive_resume = False``)
+    nobody can answer; the resumed turn must instead complete the interrupted work, or the task is silently
+    abandoned behind a "restored" acknowledgement that goes nowhere (#57056).
+    """
+    reason_phrase = (
+        "a gateway restart" if reason == "restart_timeout"
+        else "a gateway shutdown" if reason == "shutdown_timeout" else "a gateway interruption")
+    if message:
+        resume_guidance = (
+            "Address the user's NEW message below FIRST and focus on what the user is asking now.")
+        tail_guidance = (
+            "Do NOT re-execute old tool calls — skip any unfinished work from the conversation history."
+        )
+    elif interactive:
+        resume_guidance = (
+            "Review the conversation history and CONTINUE the interrupted task to completion "
+            "without asking the user to say 'continue'. Do not restart completed or cancelled work, "
+            "and preserve any pending request for user input or approval.")
+        tail_guidance = (
+            "Do NOT re-run tool calls whose results already appear in the history. "
+            "If an interrupted action has no recorded result, inspect its current state before "
+            "retrying it to avoid duplicate side effects. If continuation is blocked, explain "
+            "the specific reason and the next required action in the original conversation."
+        )
+    else:
+        resume_guidance = (
+            "No user is present on this non-interactive platform, "
+            "so do NOT emit a 'session restored' acknowledgement "
+            "or ask questions. Review the conversation history and "
+            "CONTINUE the interrupted task to completion.")
+        tail_guidance = (
+            "Do NOT re-run tool calls whose results already "
+            "appear in the history — resume from the first step that has no recorded result.")
+    return (
+        f"[System note: The previous turn was interrupted by "
+        f"{reason_phrase}; the gateway is now back online. "
+        f"Any restart/shutdown command in the history has already "
+        f"run — do NOT re-execute or verify it. {resume_guidance} {tail_guidance}]"
+        + (f"\n\n{message}" if message else ""))
+
+
+logger = logging.getLogger("gateway.run")
