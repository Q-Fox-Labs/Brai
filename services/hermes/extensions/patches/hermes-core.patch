+"""Display translation must preserve command parsing and original user values."""
+
+from agent.i18n import reset_language_cache
+from hermes_cli._parser import HermesArgumentParser
+from hermes_cli.ui_localization import translate_ui
+
+
+def test_russian_help_does_not_change_argument_names_or_parsed_values(monkeypatch):
+    monkeypatch.setenv('HERMES_LANGUAGE', 'ru')
+    reset_language_cache()
+    parser = HermesArgumentParser(prog='hermes demo')
+    parser.add_argument('--model', help='Model name')
+    parser.add_argument('--key', help='API key')
+    child = parser.add_subparsers(dest='command').add_parser('config', help='Show current configuration')
+    child.add_argument('value')
+    result = parser.parse_args(['--model', 'model-original', '--key', 'opaque-original', 'config', 'значение'])
+    assert (result.model, result.key, result.command, result.value) == (
+        'model-original', 'opaque-original', 'config', 'значение')
+    help_text = parser.format_help()
+    assert '--model' in help_text and '--key' in help_text and 'config' in help_text
+    assert 'Использование:' in help_text and 'Показать текущие настройки' in help_text
+    assert 'Показать справку и выйти' in help_text
+
+
+def test_wizard_translation_preserves_ansi_and_interpolated_user_data(monkeypatch):
+    monkeypatch.setenv('HERMES_LANGUAGE', 'ru')
+    reset_language_cache()
+    assert translate_ui('\x1b[33mCurrent: service-123\x1b[0m') == '\x1b[33mСейчас: service-123\x1b[0m'
+    original = 'Путь /tmp/a.json; имя user-service; command --literal'
+    assert translate_ui(original) == original
+    assert translate_ui('Failed to install package-123: error --literal') == (
+        'Не удалось установить package-123: error --literal')
+    monkeypatch.setenv('HERMES_LANGUAGE', 'en')
+    reset_language_cache()
+    assert translate_ui('Select TTS provider:') == 'Select TTS provider:'
+
+
+def test_menu_search_accepts_cyrillic_and_keeps_navigation_keys():
+    from hermes_cli.curses_ui import _SearchState, _handle_active_search_key, _filter_indices
+    from tests.hermes_cli.test_curses_ui_search import _FakeCurses
+    search = _SearchState(active=True)
+    for char in "модель":
+        assert _handle_active_search_key(_FakeCurses, char, search) == (True, False, True)
+    assert _filter_indices(["Выбрать модель", "Настройки терминала"], search.query) == [0]
+    assert _handle_active_search_key(_FakeCurses, _FakeCurses.KEY_ENTER, search) == (True, True, False)
+
+
+def test_argument_errors_keep_exit_code_and_original_flag(monkeypatch, capsys):
+    import pytest
+    monkeypatch.setenv('HERMES_LANGUAGE', 'ru')
+    reset_language_cache()
+    parser = HermesArgumentParser(prog='hermes demo')
+    parser.add_argument('--model')
+    with pytest.raises(SystemExit) as error:
+        parser.parse_args(['--model'])
+    assert error.value.code == 2
+    assert 'Ошибка: для --model нужно одно значение' in capsys.readouterr().err
+
+
+def test_templates_keep_configuration_braces_and_user_text(monkeypatch):
+    monkeypatch.setenv('HERMES_LANGUAGE', 'ru')
+    reset_language_cache()
+    original = "Error: container 'my-container' not found via podman.\nThe container may be running under root. Try: sudo hermes status"
+    result = translate_ui(original)
+    assert 'my-container' in result and 'podman' in result and 'sudo hermes status' in result
+    assert 'Контейнер' in result
+    assert translate_ui('◆ Ключи API') == '◆ Ключи API'
+
+
+def test_translating_a_message_does_not_create_missing_user_state(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path / 'empty'))
+    monkeypatch.delenv('HERMES_LANGUAGE', raising=False)
+    assert translate_ui('No files to back up.') == 'No files to back up.'
+    assert not (tmp_path / 'empty').exists()
+
+
+def test_unscoped_profile_uses_its_configuration_language(tmp_path, monkeypatch):
+    from agent.secret_scope import set_multiplex_context, reset_multiplex_context
+    (tmp_path / 'config.yaml').write_text('display:\n  language: ru\n', encoding='utf-8')
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setenv('HERMES_LANGUAGE', 'en')
+    token = set_multiplex_context(True)
+    try:
+        assert translate_ui('Select TTS provider:') == 'Выберите сервис озвучивания:'
+    finally:
+        reset_multiplex_context(token)
