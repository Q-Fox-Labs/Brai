@@ -0,0 +1,45 @@
+"""Presentation-only approval reasons; canonical detection/allowlist keys stay unchanged.
+
+Bundled reason catalogs live in locales/approval/<lang>.yaml. Plugins and the
+current profile's normal locale overlay can override a reason with the key
+``approval.reasons.<original English description>``. Unknown/custom reasons are
+returned verbatim, not translated heuristically (they may contain command code).
+"""
+
+from functools import lru_cache
+import logging
+from pathlib import Path
+
+from agent import i18n
+from agent.i18n_layers import parse_locale_file
+
+logger = logging.getLogger(__name__)
+_PROGRAM_PREFIX = "arbitrary program execution via "
+
+
+@lru_cache(maxsize=32)
+def _reason_catalog(locales_dir: str, language: str) -> dict[str, str]:
+    path = Path(locales_dir) / "approval" / f"{language}.yaml"
+    if not path.is_file():
+        return {}
+    try:
+        return parse_locale_file(path)
+    except Exception as exc:
+        logger.warning("Failed to load approval reason catalog %s: %s", path, exc, exc_info=True)
+        return {}
+
+
+def localize_approval_reason(description: str, *, lang: str | None = None) -> str:
+    """Translate display text only. Never use the result as an approval key."""
+    language = i18n.resolve_language_id(lang) if lang else i18n.get_language()
+    language = language or i18n.DEFAULT_LANGUAGE
+    reason, kwargs = description, {}
+    if description.startswith(_PROGRAM_PREFIX):
+        reason = "arbitrary program execution via {program}"
+        kwargs = {"program": description[len(_PROGRAM_PREFIX):]}
+    key = f"approval.reasons.{reason}"
+    translated = i18n.t(key, lang=language, **kwargs)
+    if translated != key:
+        return translated
+    translated = _reason_catalog(str(i18n._locales_dir()), language).get(reason)
+    return translated.format(**kwargs) if translated is not None else description
