diff --git a/apps/desktop/src/i18n/ru_complete.ts b/apps/desktop/src/i18n/ru_complete.ts
new file mode 100644
index 0000000000..7c9729a48c
--- /dev/null
+++ b/apps/desktop/src/i18n/ru_complete.ts
@@ -0,0 +1,11 @@
+/** Complete the Russian catalog with the same flat messages served to remote clients. */
+import { adaptStringOverrides, mergeTranslations, unflattenMessages } from '@hermes/shared/i18n'
+
+import type { TranslationOverrides } from './define-locale'
+import { en } from './en'
+import messages from './ru_complete.json'
+
+export function completeRussian(base: TranslationOverrides): TranslationOverrides {
+  const additions = adaptStringOverrides(en, unflattenMessages(messages, en)) as TranslationOverrides
+  return mergeTranslations<TranslationOverrides>(base, additions)
+}
