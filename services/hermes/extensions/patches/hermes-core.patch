+
+@pytest.fixture
+def lifecycle(tmp_path, monkeypatch):
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(gateway_run, "_startup_restore_drain_timeout_secs", lambda: 0)
+    runner, adapter = make_restart_runner()
+    runner._claim_pending_obligations = AsyncMock(return_value=[])
+    runner._redeliver_claimed_obligations = AsyncMock()
+    runner._free_tier_startup_line = Mock(return_value=None)
+    runner._profile_adapters = {}
+    return runner, adapter, tmp_path / ".restart_pending.json"
+
+
+def _add_task(runner, chat_id, thread_id=None):
+    source = make_restart_source(chat_id=chat_id, thread_id=thread_id, chat_type="group")
+    key = build_session_key(source)
+    runner._running_agents[key] = object()
+    runner._cache_session_source(key, source)
+    return source
+
+
+async def _boot(runner):
+    await asyncio.wait_for(runner._await_startup_boot_sends(
+        planned_restart_notification_pending=gateway_run._planned_restart_notification_pending(),
+    ), timeout=5.0)
+
+
+def _routes(calls):
+    return [(chat_id, (metadata or {}).get("thread_id")) for chat_id, _text, metadata in calls]
+
+
+@pytest.mark.asyncio
+async def test_stop_and_fresh_boot_return_to_every_warned_chat_and_topic(lifecycle):
+    runner, adapter, marker = lifecycle
+    _add_task(runner, "-1001", "7")
+    _add_task(runner, "-1001", "9")
+    _add_task(runner, "-1002", "7")
+    runner.config.platforms[Platform.TELEGRAM].home_channel = HomeChannel(
+        platform=Platform.TELEGRAM, chat_id="-1003", name="General",
+    )
+    await asyncio.wait_for(runner._notify_active_sessions_of_shutdown(), timeout=5.0)
+    warned = _routes(adapter.sent_calls)
+    assert set(warned) == {("-1001", "7"), ("-1001", "9"), ("-1002", "7"), ("-1003", None)}
+    assert len(read_return_notices(marker)) == 4
+
+    # Новый процесс: остаются только конфигурация и файл в профиле.
+    recovered, new_adapter = make_restart_runner()
+    recovered.config = runner.config
+    recovered._claim_pending_obligations = AsyncMock(return_value=[])
+    recovered._redeliver_claimed_obligations = AsyncMock()
+    await _boot(recovered)
+    assert _routes(new_adapter.sent_calls) == warned
+    assert all(meta["_interim_send"] for _, _, meta in new_adapter.sent_calls)
+    assert not marker.exists()
+    await _boot(recovered)
+    assert len(new_adapter.sent_calls) == 4
+
+
+@pytest.mark.asyncio
+async def test_failed_warning_is_not_promised_a_return_notice(lifecycle):
