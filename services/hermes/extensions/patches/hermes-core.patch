+"""Build fast JSON display catalogs from the canonical YAML translations.
+
+Run from this checkout with its managed Python environment after changing
+locales/en.yaml, ru.yaml, ru.help.yaml or ru.ui.yaml.
+"""
+
+from pathlib import Path
+import json
+import sys
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+
+def build(language: str = 'ru') -> None:
+    from agent.i18n import _load_bundled
+    english, localized = _load_bundled('en'), _load_bundled(language)
+    messages = {original: localized[key] for key, original in english.items() if key in localized}
+    help_messages = _load_bundled(f'{language}.help')
+    messages.update(help_messages)
+    messages.update(_load_bundled(f'{language}.ui'))
+    for surface, catalog in (('ui', messages), ('help', help_messages)):
+        path = ROOT / 'locales' / f'{language}.{surface}.json'
+        path.write_text(json.dumps(catalog, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
+        print(f'{path.name}: {len(catalog)} strings')
+
+
+if __name__ == '__main__':
+    build(sys.argv[1] if len(sys.argv) > 1 else 'ru')
