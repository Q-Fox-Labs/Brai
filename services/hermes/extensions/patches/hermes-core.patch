+@pytest.mark.asyncio
+async def test_offline_secondary_bot_never_falls_back_to_primary(lifecycle):
+    runner, primary, marker = lifecycle
+    secondary = SimpleNamespace(send=AsyncMock(return_value=SendResult(success=True)), send_path_degraded=False)
+    runner._profile_adapters = {"work": {Platform.TELEGRAM: secondary}}
