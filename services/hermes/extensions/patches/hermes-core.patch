+    assert marker.exists()
+
+    runner._profile_adapters["work"] = {Platform.TELEGRAM: secondary}
+    secondary.send.reset_mock()
+    await runner._replay_pending_planned_restart_notification()
+    secondary.send.assert_awaited_once()
+    assert secondary.send.await_args.args[0] == "42"
+    assert secondary.send.await_args.kwargs["metadata"]["thread_id"] == "8"
+    assert not marker.exists()
