diff --git a/hermes_cli/help_localization.py b/hermes_cli/help_localization.py
new file mode 100644
index 0000000000..75de8b0064
--- /dev/null
+++ b/hermes_cli/help_localization.py
@@ -0,0 +1,43 @@
+"""Localize argparse presentation without changing argument names or parsed values."""
+
+from copy import copy
+from functools import lru_cache
+import json
+
+from agent.i18n import _load_bundled, _locales_dir
+from hermes_cli.ui_localization import _display_language as get_language
+
+
+@lru_cache(maxsize=32)
+def _help_catalog(language: str) -> dict[str, str]:
+    packed = _locales_dir() / f"{language}.help.json"
+    return json.loads(packed.read_text(encoding='utf-8-sig')) if packed.is_file() else _load_bundled(f"{language}.help")
+
+
+def translate_help(text: str | None) -> str | None:
+    """Translate help at render time, after the active profile has been selected."""
+    if not text:
+        return text
+    return _help_catalog(get_language()).get(text, text)
+
+
+class _LocalizedFormatter:
+    def add_text(self, text):
+        return super().add_text(translate_help(text))
+
+    def start_section(self, heading):
+        return super().start_section(translate_help(heading))
+
+    def _format_usage(self, usage, actions, groups, prefix):
+        return super()._format_usage(usage, actions, groups, translate_help(prefix or "usage: "))
+
+    def _format_action(self, action):
+        localized = copy(action)
+        localized.help = translate_help(action.help)
+        return super()._format_action(localized)
+
+
+@lru_cache(maxsize=16)
+def localized_formatter(formatter_class):
+    """Keep RawText/RawDescription layout and argparse's interpolation rules."""
+    return type("LocalizedHelpFormatter", (_LocalizedFormatter, formatter_class), {})
diff --git a/hermes_cli/ui_localization.py b/hermes_cli/ui_localization.py
new file mode 100644
index 0000000000..531b428dbb
--- /dev/null
+++ b/hermes_cli/ui_localization.py
@@ -0,0 +1,104 @@
+"""Translate wizard presentation while keeping identifiers, input, and menu indices intact."""
+
+from functools import lru_cache
+import re
+import json
+import os
+from pathlib import Path
+
+_ANSI = re.compile(r"(\x1b\[[0-9;]*m)")
+_FIELD = re.compile(r"\{([A-Za-z_]\w*|\d+)(?::[^{}]*)?\}")
+
+
+@lru_cache(maxsize=32)
+def _catalog(language: str):
+    root = Path(os.getenv('HERMES_BUNDLED_LOCALES', '') or Path(__file__).resolve().parent.parent / 'locales')
+    packed = root / f"{language}.ui.json"
+    if packed.is_file():
+        messages = json.loads(packed.read_text(encoding='utf-8-sig'))
+    else:
+        from agent.i18n import _load_bundled
+        english, localized = _load_bundled("en"), _load_bundled(language)
+        messages = {original: localized[key] for key, original in english.items() if key in localized}
+        messages.update(_load_bundled(f"{language}.help"))
+        messages.update(_load_bundled(f"{language}.ui"))
+    normalized = {key.strip(): value.strip() for key, value in messages.items()}
+    templates = []
+    for original, translated in normalized.items():
+        placeholders = list(_FIELD.finditer(original))
+        if not placeholders or not re.search(r"[a-z]{3}|[A-Z]{5}", _FIELD.sub("", original)):
+            continue
+        pattern, fields, position = [], [], 0
+        for placeholder in placeholders:
+            pattern.append(re.escape(original[position:placeholder.start()]))
+            pattern.append(r"(.*?)")
+            fields.append(placeholder.group(1))
+            position = placeholder.end()
+        pattern.append(re.escape(original[position:]))
+        templates.append((re.compile("".join(pattern), re.DOTALL), fields, translated))
+    templates.sort(key=lambda item: len(item[0].pattern), reverse=True)
+    return normalized, templates
+
+
+def _plain(text: str, language: str) -> str:
+    messages, templates = _catalog(language)
+    stripped = text.strip()
+    translated = messages.get(stripped)
+    if translated is None:
+        for pattern, fields, value in templates:
+            match = pattern.fullmatch(stripped)
+            if match is not None:
+                captured = dict(zip(fields, match.groups()))
+                try:
+                    translated = _FIELD.sub(lambda field: captured[field.group(1)], value)
+                except (KeyError, ValueError):
+                    continue
+                break
+    if translated is not None:
+        leading = text[:len(text) - len(text.lstrip())]
+        trailing = text[len(text.rstrip()):]
+        return leading + translated + trailing
+    if "\n" in text:
+        return "\n".join(_plain(line, language) for line in text.split("\n"))
+    return text
+
+
+@lru_cache(maxsize=32)
+def _configured_language(home: str, signature: tuple) -> str:
+    """Read presentation settings without importing CLI configuration or creating state."""
+    import hermes_yaml as yaml
+    try:
+        config = yaml.safe_load((Path(home) / 'config.yaml').read_text(encoding='utf-8-sig'))
+    except (OSError, UnicodeError, yaml.YAMLError):
+        return 'en'
+    display = config.get('display') if isinstance(config, dict) else None
+    return str(display.get('language') or 'en') if isinstance(display, dict) else 'en'
+
+
+def _display_language() -> str:
+    from hermes_constants import get_hermes_home
+    from agent.secret_scope import UnscopedSecretError, get_secret
+    try:
+        explicit = get_secret('HERMES_LANGUAGE')
+    except UnscopedSecretError:
+        explicit = None
+    home = get_hermes_home()
+    if explicit:
+        language = explicit
+    else:
+        try:
+            stat = (home / 'config.yaml').stat()
+        except OSError:
+            return 'en'
+        language = _configured_language(str(home), (stat.st_mtime_ns, stat.st_size, stat.st_ino))
+    from agent.i18n import resolve_language_id
+    return resolve_language_id(language) or 'en'
+
+
+def translate_ui(text: str, *, language: str | None = None) -> str:
+    """Translate known display copy; leave user values and machine identifiers untouched."""
+    language = language or _display_language()
+    if language == "en" or not isinstance(text, str):
+        return text
+    return "".join(part if _ANSI.fullmatch(part) else _plain(part, language)
+                   for part in _ANSI.split(text))
