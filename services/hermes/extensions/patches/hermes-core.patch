+class GatewayReturnNoticesMixin:
+    """Парные уведомления остановки/возврата и совместимость прежних квитанций."""
+
+    async def _send_shutdown_notice(
+        self, adapter, chat_id: str, msg: str, kind: str, platform_str: str, *,
+        return_thread_id=None, **send_kwargs
+    ) -> bool:
+        """Send one shutdown notice; True when delivered. Failures are debug-logged, never raised."""
+        where = "home channel " if kind == "home channel" else ""
+        fail_fmt = f"Failed to send shutdown notification to {where}%s:%s: %s"
+        if not await self._send_notice_logged(adapter, chat_id, msg, platform_str, fail_fmt, **send_kwargs):
+            return False
+        from gateway.config import Platform
+        from gateway.run import _planned_restart_notification_path
+        try:
+            profile = adapter_notice_profile(
+                adapter, Platform(platform_str), self.adapters,
+                getattr(self, "_profile_adapters", None) or {},
+            )
+            remember_return_notice(
+                _planned_restart_notification_path(), platform_str, chat_id, return_thread_id, profile,
+            )
+        except Exception:
+            logger.error("Could not persist return notice for %s:%s", platform_str, chat_id, exc_info=True)
+        logger.info("Sent shutdown notification to %s %s:%s", kind, platform_str, chat_id)
+        return True
+
+    _planned_restart_notice_lock: Optional[asyncio.Lock] = None
+
+    async def _replay_return_notices(self, path: Path, recipients: list[dict]) -> None:
+        """Под lock штатного replay подтвердить возврат каждому фактическому адресату.
+
+        Неудачная доставка сохраняется; ошибка одного адресата не блокирует остальные.
+        Транспорт выбирается по сохранённому владельцу бота, без подмены профиля.
+        """
+        from agent.i18n import t
+        from gateway.config import Platform
+        from gateway.run_notifications import _safe_delivery_transport
+        from gateway.run_shutdown import _send_failed
+        from gateway.run import _async_profile_runtime_scope
+
+        for target in recipients:
+            try:
+                platform = Platform(target["platform"])
+                profile = target.get("profile")
+                config = self.config if profile is None else (getattr(self, "_profile_configs", None) or {}).get(profile)
+                if config is None:
+                    continue
+                transport = _safe_delivery_transport(
+                    platform, config, self._adapters_for_profile(profile), profile=profile,
+                )
+                if transport is None:
+                    continue
+                metadata = self._thread_metadata_for_target(
+                    platform, target["chat_id"], target.get("thread_id"), adapter=transport.adapter,
+                )
+                home = (getattr(self, "_served_profile_homes", None) or {}).get(profile) if profile else None
+                async with _async_profile_runtime_scope(home) if home else contextlib.nullcontext():
+                    # AIDEV-NOTE: Отдельный send, не ответ агента: не закрывает текущую задачу.
+                    from gateway.run import _interim_metadata, _non_conversational_metadata
+                    result = await asyncio.wait_for(transport.send(
+                        platform, target["chat_id"], t("gateway.startup.online"),
+                        metadata=_non_conversational_metadata(_interim_metadata(metadata), platform=platform),
+                    ), timeout=15.0)
+                if not _send_failed(result):
+                    acknowledge_return_notice(path, target["notice_id"])
+            except Exception:
+                logger.warning("Return notice remains pending for %s", target.get("platform"), exc_info=True)
+
+    async def _return_notice_watcher(self, interval: float = 30.0) -> None:
+        """Повторять парные уведомления после временной ошибки без нового сообщения."""
+        from gateway.run import _planned_restart_notification_path
+
+        while self._running:
+            if read_return_notices(_planned_restart_notification_path()) is not None:
+                await self._replay_pending_planned_restart_notification()
+            await asyncio.sleep(interval)
+
+    async def _replay_pending_planned_restart_notification(self) -> None:
+        """Deliver paired notices, or legacy home-channel notices; clear
+        ``.restart_pending.json`` only once all of them were reached.
+
+        Runs from the boot pass and again from ``_install_reconnected_adapter``, so a home whose
+        platform was down at boot gets its notice when the platform comes back (#112109). Delivered
+        targets are recorded in the marker so neither a later replay nor the next process (if this
+        one restarts first) notifies a home twice. The lock serializes a boot pass that outlived the
+        restore gate against a concurrent reconnect replay.
+        """
+        from gateway.run import _planned_restart_notification_path
+        from gateway.run_notifications import _served_notice_target_key
+
+        if self._planned_restart_notice_lock is None:
+            self._planned_restart_notice_lock = asyncio.Lock()
+        async with self._planned_restart_notice_lock:
+            path = _planned_restart_notification_path()
+            if not path.exists():
+                return
+            try:
+                data = json.loads(path.read_text(encoding="utf-8-sig"))
+                if "recipients" in data:
+                    await self._replay_return_notices(path, data["recipients"])
+                    return
+                delivered = {tuple(target) for target in data.get("delivered_targets", [])}
+                # Owed targets come from config, not live transports: a removed home or an opt-out
+                # (gateway_restart_notification=false) must not keep the marker alive forever.
+                owed = {
+                    _served_notice_target_key(
+                        profile, platform.value, cfg.home_channel.chat_id, cfg.home_channel.thread_id)
+                    for profile, platform, cfg in self._served_home_channel_configs()
+                    if cfg.home_channel and cfg.home_channel.chat_id and cfg.gateway_restart_notification
+                }
+                delivered |= await self._send_home_channel_startup_notifications(skip_targets=delivered)
+                if owed <= delivered:
+                    path.unlink(missing_ok=True)
+                    return
+                data["delivered_targets"] = [list(target) for target in delivered]
+                atomic_json_write(path, data, indent=None)
+            except Exception:
+                logger.warning("Planned-restart notification remains pending", exc_info=True)
