+"""Approval reasons are presentation text, never translated security keys or code."""
+
+import pytest
+
+from agent import i18n
+from tools import approval_prompt
+
+
+def test_cli_callback_receives_russian_reason_without_translating_code(monkeypatch):
+    monkeypatch.setenv("HERMES_LANGUAGE", "ru")
+    i18n.reset_language_cache()
+    seen = []
+    command = "python -c 'print(\"script execution via -e/-c flag\")'"
+    reason = "script execution via -e/-c flag"
+
+    def callback(command, description, **kwargs):
+        seen.append((command, description))
+        return "deny"
+
+    assert approval_prompt._ask_human(command, reason, 1, True, callback, True, False) == "deny"
+    assert seen == [(command, "выполнение скрипта через флаг -e/-c")]
+
+
+def test_every_detection_reason_has_russian_display_text():
+    import re
+    from tools import approval_detection as detection
+    from tools.approval_localization import localize_approval_reason
+
+    reasons = {reason for _, reason in detection.DANGEROUS_PATTERNS + detection.HARDLINE_PATTERNS}
+    reasons.update({detection._PARSER_LIMIT_DESCRIPTION, detection._MALFORMED_EXEC_DESCRIPTION,
+                    detection._GATEWAY_LIFECYCLE_SPLICE_DESCRIPTION,
+                    "sudo password guessing via stdin (sudo -S)",
+                    "script execution via -e/-c flag", "script execution via heredoc",
+                    "shell command via -c/-lc flag"})
+    for reason in sorted(reasons):
+        translated = localize_approval_reason(reason, lang="ru")
+        assert re.search("[А-Яа-яЁё]", translated), reason
+        assert localize_approval_reason(reason, lang="en") == reason
+
+
+def test_gateway_notification_localizes_a_copy_not_security_state(monkeypatch):
+    from tools import approval, approval_gateway_wait as wait
+    monkeypatch.setenv("HERMES_LANGUAGE", "ru")
+    i18n.reset_language_cache()
+    reason = "script execution via -e/-c flag"
+    data = {"command": "python -c 'print(1)'", "description": reason,
+            "pattern_key": reason, "pattern_keys": [reason]}
+    session = "localized-approval"
+    monkeypatch.setattr(wait._ctx, "_fire_approval_hook", lambda *a, **kw: None)
+
+    def notify(display):
+        assert display["description"] == "выполнение скрипта через флаг -e/-c"
+        assert display["command"] == data["command"]
+        assert display["pattern_key"] == reason
+        assert display["pattern_keys"] == [reason]
+        assert approval.list_gateway_approvals(session)[0]["description"] == reason
+        approval.resolve_gateway_approval(session, "deny")
+
+    result = wait._await_gateway_decision(session, notify, data)
+    assert result == {"resolved": True, "choice": "deny", "reason": None}
+    assert data["description"] == reason
