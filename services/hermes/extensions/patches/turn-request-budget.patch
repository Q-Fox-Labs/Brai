diff --git a/agent/brai_turn_budget.py b/agent/brai_turn_budget.py
new file mode 100644
--- /dev/null
+++ b/agent/brai_turn_budget.py
@@ -0,0 +1,315 @@
+# ABOUTME: Ограничивает дополнительные физические запросы одним пользовательским ходом.
+# ABOUTME: Хранит только техническое состояние; текст запросов и ответов не журналирует.
+"""Общий бюджет Hermes: две дополнительные попытки, включая сжатие истории."""
+
+from __future__ import annotations
+
+from contextvars import ContextVar
+from functools import wraps
+from threading import RLock
+import json
+import logging
+import math
+import os
+from pathlib import Path
+import time
+import uuid
+
+logger = logging.getLogger(__name__)
+_current = ContextVar("brai_turn_request_budget", default=None)
+
+
+class TurnRequestBudgetExhausted(RuntimeError):
+    """Остановить ход до повтора уже доставленного ответа или перерасхода бюджета."""
+
+    def __init__(self, message, *, reason="retry_budget", request_id="", budget=None):
+        super().__init__(message)
+        budget = budget or _current.get()
+        logger.warning(
+            "Hermes request budget exhausted turn_id=%s request_id=%s stage=exhausted "
+            "reason=%s attempt=%d extra=%d",
+            budget.turn_id if budget is not None else "unscoped", request_id or "unavailable",
+            reason, budget.physical if budget is not None else 0,
+            budget.spent if budget is not None else 0,
+        )
+
+
+class TurnRequestBudget:
+    """Владеть двумя дополнительными запросами на весь ход, включая worker threads."""
+
+    def __init__(self):
+        self.turn_id = uuid.uuid4().hex
+        self.lock = RLock()
+        self.spent = 0
+        self.physical = 0
+        self.lanes = {}
+        self.deadlines = {}
+
+    def start(self, metadata):
+        """Учесть физический вызов до обращения к провайдеру."""
+        metadata = metadata or {}
+        role = str(metadata.get("call_role") or "primary")
+        # AIDEV-NOTE: Новые request_id после recovery не создают новый бюджет.
+        lane = role if role.startswith("auxiliary:") else "primary"
+        with self.lock:
+            previous = self.lanes.get(lane)
+            request_id = str(metadata.get("api_request_id") or "")
+            retry = previous is not None and (
+                previous.failed or not previous.finished or (bool(request_id) and previous.request_id == request_id)
+            )
+            deadline = self.deadlines.get(lane)
+            if deadline is not None and retry and time.monotonic() >= deadline[1]:
+                raise TurnRequestBudgetExhausted(
+                    "Истёк срок исходного запроса; история сохранена.",
+                    reason="deadline", request_id=request_id, budget=self)
+            if retry and (previous.emitted or self.spent >= 2):
+                raise TurnRequestBudgetExhausted(
+                    "Ответ провайдера прерван. Продолжите новым сообщением; история сохранена.",
+                    reason="partial_emitted" if previous.emitted else "retry_limit",
+                    request_id=request_id, budget=self,
+                )
+            if retry:
+                self.spent += 1
+            self.physical += 1
+            attempt = PhysicalAttempt(self, lane, request_id, self.physical,
+                                      previous.origin if retry else time.monotonic(),
+                                      str(metadata.get("api_mode") or ""))
+            attempt.is_retry = retry
+            self.lanes[lane] = attempt
+            attempt.record("connect")
+            return attempt
+
+
+class PhysicalAttempt:
+    """Учесть стадии одного запроса без хранения содержимого потока."""
+
+    def __init__(self, budget, lane, request_id, number, origin, api_mode):
+        self.budget, self.lane, self.request_id = budget, lane, request_id
+        self.number, self.origin, self.api_mode = number, origin, api_mode
+        self.finished = self.failed = self.emitted = False
+        self.events = 0
+        self.terminal = False
+        self.stage = "connect"
+
+    def record(self, stage):
+        """Записать переход стадии и время от исходного запроса."""
+        self.stage = stage
+        logger.info("Hermes physical request turn_id=%s request_id=%s attempt=%d extra=%d "
+                    "stage=%s elapsed=%.3f events=%d",
+                    self.budget.turn_id, self.request_id or "unavailable",
+                    self.number, self.budget.spent, stage,
+                    time.monotonic() - self.origin, self.events)
+
+    def observe(self, event):
+        """Отличить событие, прогресс и подтверждённое завершение Responses."""
+        with self.budget.lock:
+            self.events += 1
+            kind = _field(event, "type", "")
+            delta = _field(event, "delta", "")
+            if self.events == 1:
+                self.record("first_event")
+            if kind in {"response.output_text.delta", "response.text.delta",
+                        "response.refusal.delta", "response.reasoning_summary_text.delta",
+                        "response.reasoning_text.delta"} and delta:
+                self.emitted = True
+            if kind == "response.output_item.done":
+                item = _field(event, "item", {})
+                if _field(item, "type") == "message" and _field(item, "phase") == "commentary":
+                    if any(_field(part, "type") == "output_text" and _field(part, "text")
+                           for part in (_field(item, "content", []) or [])):
+                        self.emitted = True
+            choices = _field(event, "choices", []) or []
+            if any(_field(_field(choice, "delta", {}), "content") for choice in choices):
+                self.emitted = True
+            if isinstance(delta, dict) and (delta.get("text") or delta.get("thinking")):
+                self.emitted = True
+            if delta and self.stage != "progress":
+                self.record("progress")
+            if kind in {"response.completed", "response.failed", "response.incomplete"}:
+                self.terminal = True
+                self.finish(failed=kind != "response.completed")
+
+    def finish(self, failed=False):
+        """Завершить учёт один раз; ошибка не стирается последующим закрытием."""
+        with self.budget.lock:
+            if self.finished:
+                return
+            self.finished, self.failed = True, failed
+            self.record("failed" if failed else "finish")
+
+    def check_retry(self):
+        """Остановить восстановление немедленно, когда безопасного повтора уже нет."""
+        with self.budget.lock:
+            if self.emitted or self.budget.spent >= 2:
+                raise TurnRequestBudgetExhausted(
+                    "Ответ провайдера прерван. Продолжите новым сообщением; история сохранена.",
+                    reason="partial_emitted" if self.emitted else "retry_limit",
+                    request_id=self.request_id, budget=self.budget,
+                )
+
+
+def _field(value, name, default=None):
+    """Прочитать техническое поле SDK object или JSON event."""
+    return value.get(name, default) if isinstance(value, dict) else getattr(value, name, default)
+
+
+class _PhysicalStream:
+    """Наблюдать один provider stream независимо от наличия Relay."""
+
+    def __init__(self, raw, attempt):
+        self.raw, self.iterator, self.attempt = raw, iter(raw), attempt
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        try:
+            chunk = next(self.iterator)
+        except StopIteration:
+            self.attempt.finish(failed=self.attempt.api_mode == "codex_responses" and not self.attempt.terminal)
+            if self.attempt.failed:
+                self.attempt.check_retry()
+            raise
+        except BaseException as error:
+            self.attempt.finish(failed=True)
+            if isinstance(error, Exception) and not isinstance(error, InterruptedError):
+                self.attempt.check_retry()
+            raise
+        self.attempt.observe(chunk)
+        return chunk
+
+    def close(self):
+        """Закрыть исходный ресурс на владельце без повторного сетевого вызова."""
+        self.attempt.finish(failed=not self.attempt.terminal and self.attempt.api_mode == "codex_responses")
+        close = getattr(self.raw, "close", None)
+        if callable(close):
+            close()
+
+    def __getattr__(self, name):
+        return getattr(self.raw, name)
+
+
+def physical_callback(callback, metadata, *, streaming=False):
+    """Обвязать именно provider callback, чтобы Relay retries тоже учитывались."""
+    budget = _current.get()
+    if budget is None:
+        return callback
+
+    @wraps(callback)
+    def invoke(request):
+        attempt = budget.start(metadata)
+        try:
+            raw = callback(request)
+        except BaseException as error:
+            attempt.finish(failed=True)
+            if isinstance(error, Exception) and not isinstance(error, InterruptedError):
+                attempt.check_retry()
+            raise
+        if streaming and hasattr(raw, "__iter__") and not hasattr(raw, "output"):
+            attempt.record("stream_open")
+            return _PhysicalStream(raw, attempt)
+        attempt.finish()
+        return raw
+    return invoke
+
+
+def physical_async_callback(callback, metadata):
+    """Учесть асинхронную попытку в том же бюджете без блокирования event loop."""
+    budget = _current.get()
+    if budget is None:
+        return callback
+
+    @wraps(callback)
+    async def invoke(request):
+        attempt = budget.start(metadata)
+        try:
+            result = await callback(request)
+        except BaseException as error:
+            attempt.finish(failed=True)
+            if isinstance(error, Exception) and not isinstance(error, InterruptedError):
+                attempt.check_retry()
+            raise
+        attempt.finish()
+        return result
+    return invoke
+
+
+def transport_timeout_policy():
+    """Прочитать единую политику silent phases из закреплённого корня расширений."""
+    try:
+        root = Path(os.environ["HERMESCUSTOM_ROOT"])
+        if not root.is_absolute():
+            raise ValueError("absolute root required")
+        policy = json.loads((root / "config/network-timeouts.json").read_text())
+        if set(policy) != {"version", "max_client_silence_seconds", "transport_idle_grace_seconds"}:
+            raise ValueError("invalid policy fields")
+        if type(policy["version"]) is not int or policy["version"] != 1:
+            raise ValueError("invalid policy version")
+        values = [policy["max_client_silence_seconds"], policy["transport_idle_grace_seconds"]]
+        if any(type(value) is not int or value <= 0 for value in values):
+            raise ValueError("invalid policy bounds")
+        return float(values[0]), float(values[0] + values[1])
+    except (KeyError, OSError, TypeError, ValueError):
+        raise TurnRequestBudgetExhausted(
+            "Не удалось проверить политику ожидания транспорта.", reason="timeout_policy") from None
+
+
+def validate_client_timeouts(wire_timeout, silent_windows, *, operation, request_id=""):
+    """Отклонить неподдерживаемые overrides до SDK запроса, сохранив native wall semantics.
+
+    SDK read ограничивает тишину независимо от общего wall deadline. Lifecycle-события
+    не становятся substantive progress; окно каждой native фазы проверяется отдельно.
+    """
+    limit, transport_idle = transport_timeout_policy()
+    wire = getattr(wire_timeout, "read", wire_timeout)
+    if (isinstance(wire, bool) or not isinstance(wire, (int, float))
+            or not math.isfinite(wire) or wire <= 0 or wire > limit):
+        raise TurnRequestBudgetExhausted(
+            "Клиентское ожидание превышает разрешённый предел транспорта.",
+            reason="timeout_policy:wire", request_id=request_id)
+    for stage, window in silent_windows.items():
+        if (isinstance(window, bool) or not isinstance(window, (int, float))
+                or math.isnan(window) or min(float(wire), max(0.0, window)) > limit
+                or min(float(wire), max(0.0, window)) >= transport_idle):
+            raise TurnRequestBudgetExhausted(
+                "Клиентское ожидание превышает разрешённый предел транспорта.",
+                reason="timeout_policy:" + operation + ":" + stage, request_id=request_id)
+
+
+
+def logical_deadline(seconds, *, lane="primary", request_id=""):
+    """Закрепить исходный native timeout; повтор получает прежний absolute monotonic deadline."""
+    budget = _current.get()
+    now = time.monotonic()
+    if budget is None:
+        return now + seconds
+    with budget.lock:
+        previous = budget.lanes.get(lane)
+        window = budget.deadlines.get(lane)
+        baseline = previous is not None and previous.finished and not previous.failed and (
+            not request_id or previous.request_id != request_id
+        )
+        # При nonstream execute текущая попытка начинается до создания watchdog.
+        baseline = baseline or (
+            lane == "primary" and window is not None and bool(request_id)
+            and window[0] != request_id and previous is not None and not previous.finished
+            and not getattr(previous, "is_retry", False)
+        )
+        if window is None or baseline:
+            window = (request_id, now + seconds)
+            budget.deadlines[lane] = window
+        return window[1]
+
+
+def turn_budget(function):
+    """Создать новый бюджет только на самостоятельный вход пользовательского хода."""
+    @wraps(function)
+    def invoke(*args, **kwargs):
+        if _current.get() is not None:
+            return function(*args, **kwargs)
+        token = _current.set(TurnRequestBudget())
+        try:
+            return function(*args, **kwargs)
+        finally:
+            _current.reset(token)
+    return invoke
