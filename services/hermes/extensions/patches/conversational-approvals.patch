+// ABOUTME: Provides locale composition and product display naming for Brai.
+// ABOUTME: Preserves technical identifiers and callable catalog interfaces.
 // Locale scaffolding shared by the desktop and web i18n layers. Generic over the
 // translation catalog type: each app supplies its own `Translations`/`en` and
 // wraps `mergeTranslations` in a one-line `defineLocale`.
@@ -206,3 +208,25 @@
   document.documentElement.lang = locale
   document.documentElement.dir = rtl ? 'rtl' : 'ltr'
 }
+
+/** Product display name; source identifiers, code, links and paths stay exact. */
+export function brandDisplayText(text: string): string {
+  const protectedText = /(```[\s\S]*?```|`[^`\n]*`|https?:\/\/[^\s<>]+|(?:[A-Za-z]:)?\/[^\s<>]+)/g
+  return text.split(protectedText).map((part, index) => index % 2
+    ? part
+    : part.replace(/(?<![\w./-])(?:Hermes(?: Agent)?|HERMES(?: AGENT)?|Гермес|ГЕРМЕС)(?![\w./-])/g, 'Brai')).join('')
+}
+
+/** Brand catalog leaves without rewriting keys or changing callable leaf arity. */
+export function brandDisplayCatalog<T>(catalog: T): T {
+  if (typeof catalog === 'string') return brandDisplayText(catalog) as T
+  if (typeof catalog === 'function') {
+    const translated = (...args: unknown[]) => brandDisplayText(catalog(...args))
+    Object.defineProperty(translated, 'length', { value: catalog.length })
+    return translated as T
+  }
+  if (Array.isArray(catalog)) return catalog.map(value => brandDisplayCatalog(value)) as T
+  if (!isRecord(catalog)) return catalog
+  return Object.fromEntries(Object.entries(catalog).map(([key, value]) =>
+    [key, brandDisplayCatalog(value)])) as T
+}
