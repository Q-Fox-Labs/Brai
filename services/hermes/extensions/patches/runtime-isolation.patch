+def bound_runtime_root(project_root: Path) -> Path | None:
+    """Read the installation binding, rejecting an unsafe or invalid existing file."""
+    path = Path(project_root) / ".brai-runtime.json"
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
+    except FileNotFoundError as exc:
+        if os.path.lexists(path):
+            raise ValueError("Invalid Hermes runtime binding") from exc
+        return None
+    except OSError as exc:
+        raise ValueError("Invalid Hermes runtime binding") from exc
+    try:
+        metadata = os.fstat(fd)
+        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid not in (0, os.geteuid())
+                or metadata.st_mode & 0o022 or metadata.st_nlink != 1 or metadata.st_size > 4096):
+            raise ValueError("Invalid Hermes runtime binding")
+        with os.fdopen(fd, "r", encoding="utf-8") as source:
+            fd = -1
+            data = json.load(source)
+        if (not isinstance(data, dict) or set(data) != {"format", "runtimeRoot"}
+                or data["format"] != "brai-hermes-runtime-v1"
+                or not isinstance(data["runtimeRoot"], str)):
+            raise ValueError("Invalid Hermes runtime binding")
+        value = data["runtimeRoot"]
+        if not value.startswith("/") or os.path.normpath(value) != value or value == "/":
+            raise ValueError("Invalid Hermes runtime binding")
+        return Path(value)
+    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
+        raise ValueError("Invalid Hermes runtime binding") from exc
+    finally:
+        if fd != -1:
+            os.close(fd)
+
