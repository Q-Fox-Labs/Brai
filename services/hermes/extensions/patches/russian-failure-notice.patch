+def connection_kind(provider, base_url):
+    """Определить тип соединения только по подтверждённому адресу движка."""
+    if not isinstance(provider, str) or not isinstance(base_url, str):
+        return 'unknown'
+    try:
+        parsed = urlsplit(base_url)
+        host = (parsed.hostname or '').lower().rstrip('.')
+        if not host or parsed.username or parsed.password:
+            return 'unknown'
+        try:
+            if ip_address(host).is_loopback:
+                return 'local'
+        except ValueError:
+            if host == 'localhost' or host.endswith('.localhost'):
+                return 'local'
+        if parsed.scheme != 'https':
+            return 'unknown'
+        slug = provider.strip().lower()
+        known = {'openai-codex': 'chatgpt.com', 'openrouter': 'openrouter.ai'}
+        try:
+            from hermes_cli.auth import PROVIDER_REGISTRY
+            descriptor = PROVIDER_REGISTRY.get(slug)
+            default_url = getattr(descriptor, 'inference_base_url', '') if descriptor else ''
+            default_host = (urlsplit(default_url).hostname or '').lower().rstrip('.')
+            if default_host:
+                known[slug] = default_host
+        except Exception:
+            pass
+        if slug in {'lmstudio', 'ollama', 'local', 'llama.cpp', 'llamacpp', 'vllm'}:
+            return 'unknown'
+        return 'external' if known.get(slug) == host else 'unknown'
+    except (ValueError, TypeError):
+        return 'unknown'
+
+
+def _message_for_connection(code, kind):
+    message = _COPY.get(code, _UNKNOWN)
+    if code not in _MODEL_CODES:
+        return message
+    if kind == 'external':
+        if code in _EXTERNAL_COPY:
+            return _EXTERNAL_COPY[code]
+        return 'Запрос направлен в сторонний сервис ИИ, к которому подключён агент. ' + message
+    if kind == 'local':
+        return 'Запрос направлен через локальное подключение. Где именно возникла проблема, пока неизвестно. ' + message
+    return 'Запрос направлен к подключённой модели. Пока неизвестно, на чьей стороне находится её сервис. ' + message
+
