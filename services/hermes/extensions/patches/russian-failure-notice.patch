+def _russian_gateway_error(error: Any) -> str:
+    """Объяснить подтверждённую причину, не выводя сырой текст внешней ошибки."""
+    text = str(error or "").strip()
+    if not text:
+        return "причина ошибки пока неизвестна"
+    try:
+        from agent.redact import redact_sensitive_text
+        safe = redact_sensitive_text(text, force=True)
+    except Exception:
+        safe = ""
+    if safe and re.search(r"[А-Яа-яЁё]", safe) and not re.search(r"[a-z]{3,}\s+[a-z]{3,}|[\u3400-\u9fff]", safe):
+        return safe
+    logger.warning("Техническая причина ошибки команды: %s", safe or type(error).__name__)
+    if isinstance(error, FileNotFoundError):
+        return "нужный файл или папка не найдены"
+    if isinstance(error, PermissionError):
+        return "нет доступа к необходимому ресурсу"
+    if isinstance(error, TimeoutError):
+        return "превышено время ожидания"
+    if isinstance(error, ConnectionError):
+        return "не удалось подключиться к сервису"
+    lower = text.lower()
+    status = getattr(error, "status_code", None)
+    if not isinstance(status, int):
+        match = re.search(r"(?:http|status(?: code)?|error code)\s*[:=]?\s*(401|403|404|429|502|503|504)\b", lower)
+        status = int(match.group(1)) if match else None
+    if status in (401, 403):
+        return "сервис отказал в доступе; проверьте настройки подключения"
+    if status == 404:
+        return "сервис не нашёл запрошенный ресурс"
+    if status == 429:
+        return "сервис ограничил запрос; причина и время возобновления пока неизвестны"
+    if status in (502, 503, 504):
+        return "сервис временно недоступен"
+    if "timed out" in lower or "timeout" in lower:
+        return "превышено время ожидания"
+    if "connection refused" in lower or "connection reset" in lower:
+        return "соединение с сервисом не установлено или прервано"
+    return "причину ошибки нужно проверить"
+
