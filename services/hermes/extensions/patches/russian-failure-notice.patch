+def explain_failure(original, *, surface, diagnostic, logger, redact, partial=False,
+                    status_code=None, billing_unverified=False, now=None, result=None,
+                    delivered_partial=''):
+    """Вернуть сообщение по классификации и сохранить диагностические данные в журнале."""
+    surface = surface if isinstance(surface, dict) else {}
+    result = result if isinstance(result, dict) else {}
+    code = surface.get('code', 'unknown')
+    if not isinstance(code, str) or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_.:-]{0,79}', code):
+        code = 'unknown'
+    raw_code = code
+    layer = surface.get('layer', 'unknown')
+    if layer not in {'provider', 'endpoint', 'streaming', 'auth', 'billing', 'gateway', 'disk'}:
+        layer = 'unknown'
+    if result.get('brai_failure_kind') in {'invalid_tool_call', 'truncated_tool_call', 'server_context_rejection', 'output_cap_exceeded'}:
+        code = result['brai_failure_kind']
+    elif result.get('brai_session_reset'):
+        code = 'context_reset'
+    elif result.get('compaction_disabled'):
+        code = 'compression_disabled'
+    elif result.get('compression_deferred'):
+        code = 'compression_deferred'
+    elif layer == 'disk':
+        code = 'disk_full'
+    elif code.startswith('session_persistence_failed:'):
+        code = 'session_persistence_failed'
+    elif code == 'billing' and billing_unverified:
+        code = 'billing_unverified'
+    if code == 'session_persistence_failed':
+        message = 'Не удалось сохранить состояние разговора, поэтому работа остановлена. Обратитесь к администратору для проверки хранилища.'
+    else:
+        kind = result.get('brai_connection_kind')
+        if kind not in {'local', 'external', 'unknown'}:
+            kind = connection_kind(result.get('provider'), result.get('base_url'))
+        message = _message_for_connection(code, kind)
+    lines = [_TITLES.get(code, _DEFAULT_TITLE), message]
+    if code == 'server_context_rejection':
+        size, window = result.get('brai_request_tokens'), result.get('brai_context_window')
+        if type(size) is int and type(window) is int and 0 < size < window <= 10**9:
+            lines.append(f'Оценка размера запроса с резервом на ответ — {size:,} токенов; ожидаемая вместимость — {window:,} токенов.')
+    resets_at = surface.get('resets_at', result.get('failure_resets_at'))
+    clock = time.time() if now is None else now
+    if (code in {'rate_limit', 'upstream_rate_limit', 'free_tier_rate_limited'}
+            and type(resets_at) in (int, float) and math.isfinite(resets_at)
+            and 0 < resets_at - clock < 315360000):
+        minutes = max(1, math.ceil((resets_at - clock) / 60))
+        lines.append(f'До снятия ограничения — примерно {minutes} мин.')
+    lines.append('⚠️ **Работа не завершена.**')
+    if partial:
+        lines.append('Некоторые действия могли уже выполниться. Перед повтором проверьте их результат.')
+    details = [f'Код: `{code}`']
+    status = status_code if type(status_code) is int else result.get('brai_http_status')
+    http = status if type(status) is int and 400 <= status <= 599 else None
+    if http is not None:
+        details.append(f'Ответ сервера: `HTTP {http}`')
+    original_error = result.get('brai_original_error')
+    if (diagnostic or original_error) and logger.isEnabledFor(logging.WARNING):
+        try:
+            reference = secrets.token_hex(8)
+            metadata = {}
+            for key in ('brai_error_provider', 'brai_error_model', 'session_id'):
+                value = result.get(key)
+                if isinstance(value, str) and value:
+                    metadata[key] = redact(value)[:256]
+            for key in ('brai_attempts', 'api_calls', 'brai_request_tokens', 'brai_context_window'):
+                value = result.get(key)
+                if type(value) is int and 0 <= value <= 10**9:
+                    metadata[key] = value
+            metadata['raw_code'] = raw_code
+            if type(result.get('billing_unverified')) is bool:
+                metadata['billing_unverified'] = result['billing_unverified']
+            if type(result.get('failure_retryable')) is bool:
+                metadata['failure_retryable'] = result['failure_retryable']
+            reset = result.get('failure_resets_at')
+            if type(reset) in (int, float) and math.isfinite(reset) and 0 < reset < 10**11:
+                metadata['failure_resets_at'] = reset
+            safe_diagnostic = redact(str(diagnostic or ''))
+            safe_original = redact(original_error) if isinstance(original_error, str) else ''
+            record = {'detail': safe_diagnostic[:8192], 'original_error': safe_original[:8192],
+                      'truncated': len(safe_diagnostic) > 8192 or len(safe_original) > 8192, **metadata}
+            logger.warning('TELEGRAM_FAILURE reference=%s layer=%s code=%s http=%s data=%s',
+                           reference, layer, code, http or '-', json.dumps(record, ensure_ascii=False))
+            details.append(f'Номер в журнале: `{reference}`')
+        except Exception:
+            pass
+    lines.append('**Данные для проверки:**\n' + '\n'.join(details))
+    if delivered_partial:
+        lines.insert(0, delivered_partial)
+    return '\n\n'.join(lines)
