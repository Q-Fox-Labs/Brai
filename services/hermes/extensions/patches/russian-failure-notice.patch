+# Классификация остаётся в диагностике; пользователю нужны последствия.
+_TITLES = {code: '⚠️ **Не удалось завершить запрос**' for code in _COPY}
+_DEFAULT_TITLE = '⚠️ **Не удалось завершить запрос**'
+_MODEL_CODES = frozenset(_COPY) - {
+    'loop_error', 'interpreter_shutdown', 'session_busy', 'disk_full',
