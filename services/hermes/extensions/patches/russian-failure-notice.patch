+        person = person.replace("(claim reclaimed)", "блокировка снята")
+        label = "Назначен" if match.group(1) == "Assigned" else "Изменён"
+        return f"{label} исполнитель задачи {match.group(2)}: {person}"
+    match = re.match(r"^Heartbeat recorded for (.+)$", text, re.DOTALL)
