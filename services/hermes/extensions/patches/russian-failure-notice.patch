+def explain_failure(original, *, surface, diagnostic, logger, redact, partial=False,
+                    status_code=None, billing_unverified=False, now=None):
+    """Добавить пояснение; при перегрузке заменить исходный текст.
+
+    ``original`` уже должен пройти штатную очистку для чата. ``surface`` — результат
+    agent.error_surface, а не классификация по словам. В журнал с номером попадает
+    очищенное диагностическое сообщение; исходные запросы и настройки не читаются.
+    При любой ошибке пояснения возвращается ровно ``original``.
+    """
+    try:
+        if not isinstance(original, str) or not original or not isinstance(surface, dict):
+            return original
+        code = surface.get('code', 'unknown')
+        if not isinstance(code, str) or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_.:-]{0,79}', code):
+            code = 'unknown'
+        layer = surface.get('layer', 'unknown')
+        if layer not in {'provider', 'endpoint', 'streaming', 'auth', 'billing', 'gateway', 'disk'}:
+            layer = 'unknown'
+        display_code = 'billing_unverified' if code == 'billing' and billing_unverified else code
+        critical = layer == 'disk' or code == 'ssl_cert_verification' or code.startswith('session_persistence_failed:')
+        title, action = _ADMIN if critical else _COPY.get(display_code, _UNKNOWN)
+        lines = [title, action]
+        if code in {'overloaded', 'server_error', 'timeout'}:
+            lines.append('Если сервис долго не восстанавливается и я не отвечаю, перешлите сообщение администратору.')
+        resets_at = surface.get('resets_at')
+        clock = time.time() if now is None else now
+        if (code in {'rate_limit', 'upstream_rate_limit'} and type(resets_at) in (int, float)
+                and math.isfinite(resets_at) and 0 < resets_at - clock < 315360000):
+            minutes = max(1, math.ceil((resets_at - clock) / 60))
+            lines.append(f'До сброса лимита — примерно {minutes} мин.')
+        if partial:
+            lines.append('Некоторые действия могли уже выполниться. Перед повтором проверьте их результат.')
+        # AIDEV-NOTE: при перегрузке исходный текст раскрывает сервис и внутренние команды.
+        if code != 'overloaded':
+            lines.append('**Исходное сообщение и подробности:**\n' + original)
+        details = [f'Код: `{code}`']
+        http = status_code if type(status_code) is int and 400 <= status_code <= 599 else None
+        if http is not None:
+            details.append(f'Ответ сервиса: `HTTP {http}`')
+        if diagnostic and logger.isEnabledFor(logging.WARNING):
+            reference = secrets.token_hex(8)
+            safe_diagnostic = redact(str(diagnostic or ''))[:2048]
+            logger.warning('TELEGRAM_FAILURE reference=%s layer=%s code=%s http=%s detail=%s',
+                           reference, layer, code, http or '-', json.dumps(safe_diagnostic, ensure_ascii=False))
+            details.append(f'Номер в журнале: `{reference}`')
+        lines.append('**Данные для проверки:**\n' + '\n'.join(details))
+        return '\n\n'.join(lines)
+    except Exception:
+        return original
