+def _telegram_failure_explanation(response, source, *, result=None, exception=None, partial=False, failure_notice=None):
+    """Подготовить понятное сообщение о сбое для Telegram."""
+    delivered = ""
+    try:
+        from gateway.run import _gateway_platform_value, _redact_gateway_user_facing_secrets, _sanitize_gateway_final_response
+        if _gateway_platform_value(source.platform) != "telegram":
+            return response
+        from agent.error_surface import build_error_surface_from_result, build_error_surface_from_exception
+        from gateway.russian_failure_notice import explain_failure
+        result = result if isinstance(result, dict) else None
+        surface = (build_error_surface_from_result(result) if result is not None
+                   else build_error_surface_from_exception(exception))
+        diagnostic = (f"{type(exception).__name__}: {exception}" if exception is not None
+                      else result.get("error", "") if result is not None else "")
+        if failure_notice is not None:
+            partial = failure_notice(result) == PARTIAL_FAILED_TURN_NOTICE
+        candidate = result.get("brai_delivered_partial", "") if result else ""
+        if candidate:
+            delivered = _sanitize_gateway_final_response(source.platform, candidate)
+        return explain_failure(response, surface=surface, diagnostic=diagnostic, logger=logger,
+                               redact=_redact_gateway_user_facing_secrets, partial=partial,
+                               status_code=getattr(exception, "status_code", None),
+                               billing_unverified=bool(result and result.get("billing_unverified")),
+                               result=result, delivered_partial=delivered)
+    except Exception:
+        logger.exception("Не удалось подготовить сообщение об ошибке для Telegram")
+        fallback = ("⚠️ **Не удалось завершить запрос**\n\nПричину ошибки нужно проверить. "
+                    "Некоторые действия могли уже выполниться; перед повтором проверьте их результат.")
+        return f"{delivered}\n\n{fallback}" if delivered else fallback


