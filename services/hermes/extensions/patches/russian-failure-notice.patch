+def _ru_kanban_help(text: str) -> str:
+    """Перевести стандартные заголовки argparse, сохраняя имена параметров."""
+    return (text.replace("usage:", "Использование:")
+            .replace("positional arguments:", "Обязательные параметры:")
+            .replace("options:", "Параметры:")
+            .replace("show this help message and exit", "показать эту справку"))
+
+
+def _ru_kanban_parse_error(error: str) -> str:
+    """Объяснить ошибки параметров и сохранить названия полей и значения."""
+    text = error.strip().split("error: ")[-1]
+    argument, sep, detail = text.partition(": ")
+    prefix = ""
+    if sep and argument.startswith("argument "):
+        prefix = f"Параметр {argument[len('argument '):]}: "
+        text = detail
+    if text.startswith("the following arguments are required: "):
+        return "Не указаны обязательные параметры: " + text.split(": ", 1)[1]
+    if text.startswith("unrecognized arguments: "):
+        return "Неизвестные параметры: " + text.split(": ", 1)[1]
+    if text.startswith("invalid choice: ") and " (choose from " in text:
+        value, choices = text[len("invalid choice: "):].split(" (choose from ", 1)
+        return prefix + f"недопустимое значение {value}. Допустимые значения: {choices.removesuffix(')')}"
+    if text.startswith("invalid int value: "):
+        return prefix + "нужно целое число; указано " + text.split(": ", 1)[1]
+    if text.startswith("invalid float value: "):
+        return prefix + "нужно число; указано " + text.split(": ", 1)[1]
+    for english, russian in (("expected one argument", "укажите значение"),
+                             ("expected at least one argument", "укажите хотя бы одно значение"),
+                             ("not allowed with argument ", "нельзя использовать одновременно с параметром ")):
+        if text.startswith(english):
+            return prefix + russian + text[len(english):]
+    # Не раскрывать пользователю сырую ошибку внешней библиотеки.
+    from agent.i18n import _russian_gateway_error
+    return prefix + _russian_gateway_error(text)
+
