+def _pending_summary(subsystem: str, record: dict) -> str:
+    """Описать известное действие по его данным, сохраняя текст пользователя."""
+    payload = record.get("payload") or {}
+    if not isinstance(payload, dict):
+        return str(record.get("summary") or "Изменение ожидает подтверждения")
+    action = payload.get("action")
+    if subsystem == wa.MEMORY:
+        operations = payload.get("operations") if action == "batch" else [payload]
+        if not isinstance(operations, list):
+            operations = []
+        descriptions = []
+        for op in operations:
+            if not isinstance(op, dict):
+                continue
+            kind = op.get("action")
+            label = {"add": "Добавить запись", "replace": "Заменить запись",
+                     "remove": "Удалить запись"}.get(kind, "Изменить запись")
+            detail = op.get("content") or op.get("new_text") if kind in {"add", "replace"} else op.get("old_text")
+            if isinstance(detail, str) and detail:
+                label += ": " + detail[:120] + ("…" if len(detail) > 120 else "")
+            descriptions.append(label)
+        return "; ".join(descriptions) or "Изменить память"
+    if subsystem == wa.SKILLS:
+        labels = {"create": "Создать навык", "edit": "Переписать навык", "patch": "Изменить навык",
+                  "write_file": "Записать файл навыка", "remove_file": "Удалить файл навыка",
+                  "delete": "Удалить навык", "batch": "Изменить несколько навыков"}
+        if action in labels:
+            name = payload.get("name")
+            path = payload.get("file_path")
+            text = labels[action] + (f" «{name}»" if name else "") + (f", файл: {path}" if path else "")
+            content = payload.get("content")
+            if action in {"create", "edit"} and isinstance(content, str):
+                description = wa._frontmatter_description(content)
+                if description:
+                    text += f" — {description}"
+            return text
+    return str(record.get("summary") or "Изменение ожидает подтверждения")


