+def explain_failure(original, *, surface, diagnostic, logger, redact, partial=False,
+                    status_code=None, billing_unverified=False, now=None, result=None,
+                    delivered_partial=''):
+    """Вернуть сообщение по классификации и сохранить диагностические данные в журнале."""
+    surface = surface if isinstance(surface, dict) else {}
+    result = result if isinstance(result, dict) else {}
+    code = surface.get('code', 'unknown')
+    if not isinstance(code, str) or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_.:-]{0,79}', code):
+        code = 'unknown'
+    layer = surface.get('layer', 'unknown')
+    if layer not in {'provider', 'endpoint', 'streaming', 'auth', 'billing', 'gateway', 'disk'}:
+        layer = 'unknown'
+    if result.get('brai_failure_kind') in {'invalid_tool_call', 'truncated_tool_call'}:
+        code = result['brai_failure_kind']
+    elif result.get('brai_session_reset'):
+        code = 'context_reset'
+    elif result.get('compression_deferred'):
+        code = 'compression_deferred'
+    elif layer == 'disk':
+        code = 'disk_full'
+    elif code.startswith('session_persistence_failed:'):
+        code = 'session_persistence_failed'
+    elif code == 'billing' and billing_unverified:
+        code = 'billing_unverified'
+    if code == 'session_persistence_failed':
+        message = 'Не удалось сохранить состояние разговора, поэтому работа остановлена. Обратитесь к администратору для проверки хранилища.'
+    else:
+        message = _COPY.get(code, _UNKNOWN)
+    lines = [message]
+    resets_at = surface.get('resets_at', result.get('failure_resets_at'))
+    clock = time.time() if now is None else now
+    if (code in {'rate_limit', 'upstream_rate_limit', 'free_tier_rate_limited'}
+            and type(resets_at) in (int, float) and math.isfinite(resets_at)
+            and 0 < resets_at - clock < 315360000):
+        minutes = max(1, math.ceil((resets_at - clock) / 60))
+        lines.append(f'До снятия ограничения — примерно {minutes} мин.')
+    lines.append('Работа не завершена.')
+    if partial:
+        lines.append('Некоторые действия могли уже выполниться. Перед повтором проверьте их результат.')
+    details = [f'Код: `{code}`']
+    http = status_code if type(status_code) is int and 400 <= status_code <= 599 else None
+    if http is not None:
+        details.append(f'Ответ сервера: `HTTP {http}`')
+    if diagnostic and logger.isEnabledFor(logging.WARNING):
+        try:
+            reference = secrets.token_hex(8)
+            safe_diagnostic = redact(str(diagnostic))[:2048]
+            logger.warning('TELEGRAM_FAILURE reference=%s layer=%s code=%s http=%s detail=%s',
+                           reference, layer, code, http or '-', json.dumps(safe_diagnostic, ensure_ascii=False))
+            details.append(f'Номер в журнале: `{reference}`')
+        except Exception:
+            pass
+    lines.append('Данные для проверки: ' + '; '.join(details))
+    if delivered_partial:
+        lines.insert(0, delivered_partial)
+    return '\n\n'.join(lines)
