{
  "name": "@brai/providers",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.mjs",
    "start": "node dist/main.js",
    "catalog": "npm run build && node dist/catalog.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "nats": "2.29.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "@types/pg": "8.15.6"
  },
  "engines": {
    "node": ">=24"
  }
}
