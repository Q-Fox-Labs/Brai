# ABOUTME: Упаковывает заранее материализованный artifacts runtime без установок.
# ABOUTME: Контекст уже содержит только точные locked dependencies и runtime-файлы.
FROM node:24.22.1-bookworm-slim AS runtime
ARG BRAI_SOURCE_REVISION
LABEL org.opencontainers.image.revision=${BRAI_SOURCE_REVISION}
ENV NODE_ENV=production
WORKDIR /app
COPY . /app/
WORKDIR /app/services/artifacts
ENV ARTIFACTS_DATA_DIR=/var/lib/brai-artifacts
USER node
EXPOSE 3004
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 CMD ["node", "dist/health.js"]
CMD ["node", "dist/main.js"]
