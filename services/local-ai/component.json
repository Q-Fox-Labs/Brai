  "dependencies": [],
  "commands": {
    "build": "npm run build",
    "check": "node --test tests/*.test.mjs"
  },
  "delivery": {
    "kind": "ready-files",
    "files": [
      "services/local-ai/contracts",
      "services/local-ai/dist",
      "services/local-ai/migrations",
      "services/local-ai/package.json",
      "services/local-ai/profiles",
