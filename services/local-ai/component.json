      "services/local-ai/runners/silero/schemas.json",
      "services/local-ai/schemas",
      "services/local-ai/src/main.mjs"
    ],
    "entrypoints": [
      "services/local-ai/src/main.mjs",
      "services/local-ai/runners/gigaam/runner.py",
      "services/local-ai/runners/silero/runner.py",
      "services/local-ai/dist/storage/migrate.js"
    ],
    "smokeImports": [
      "services/local-ai/contracts/index.mjs",
      "services/local-ai/src/main.mjs"
    ],
    "systemRequirements": [
      "Node.js 24.21.0",
      "Pinned native/Python/FFmpeg runtime from services/local-ai/release.json; supplied by Local AI installer",
      "Model weights and lifecycle state external, only catalog/install/runtime manage models"
    ]
  },
  "deploy": {
    "units": [
      "local-ai",
      "local-ai-migrate",
      "brai-local-ai-operation3-production.service"
    ],
    "migrations": [
      "services/local-ai/migrations"
    ],
    "health": "NATS brai.local_ai.v1.status; components database/nats/executables/weights ready"
  },
  "npm": {
    "workspaces": [
      "services/local-ai"
    ]
  }
}
