{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.invalid/contracts/local-ai/v1/messages.schema.json",
  "title": "Brai local-ai request and response DTOs",
  "oneOf": [
    { "$ref": "#/definitions/ModelsListRequest" }, { "$ref": "#/definitions/ModelsListResponse" },
    { "$ref": "#/definitions/ModelsGetRequest" }, { "$ref": "#/definitions/ModelCard" },
    { "$ref": "#/definitions/CatalogSearchRequest" }, { "$ref": "#/definitions/CatalogSearchResponse" },
    { "$ref": "#/definitions/InstallRequest" }, { "$ref": "#/definitions/InstallOperation" },
    { "$ref": "#/definitions/OperationGetRequest" }, { "$ref": "#/definitions/ConfigureRequest" },
    { "$ref": "#/definitions/ConfiguredResponse" }, { "$ref": "#/definitions/ModelRevisionRequest" },
    { "$ref": "#/definitions/ModelMutationResponse" }, { "$ref": "#/definitions/EmbedRequest" },
    { "$ref": "#/definitions/TranscribeRequest" }, { "$ref": "#/definitions/EmbedResponse" },
    { "$ref": "#/definitions/TranscribeResponse" }, { "$ref": "#/definitions/CancelRequest" },
    { "$ref": "#/definitions/CancelResponse" }, { "$ref": "#/definitions/StatusRequest" },
    { "$ref": "#/definitions/StatusResponse" }, { "$ref": "#/definitions/ErrorResponse" }
  ],
  "definitions": {
    "Uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "Timestamp": { "type": "string", "format": "rfc3339-microseconds" },
    "NonEmpty": { "type": "string", "minLength": 1 },
    "OperationKind": { "type": "string", "enum": ["embed", "transcribe"] },
    "ServiceErrorCode": { "type": "string", "enum": ["INVALID_ARGUMENT", "MODEL_NOT_FOUND", "MODEL_NOT_INSTALLED", "UNSUPPORTED_OPERATION", "MODEL_IN_USE", "INPUT_TOO_LARGE", "RESULT_TOO_LARGE", "BUSY", "MODEL_LOAD_FAILED", "ENGINE_UNAVAILABLE", "DEADLINE_EXCEEDED", "CANCELLED", "ARTIFACT_NOT_AVAILABLE", "DEPENDENCY_UNAVAILABLE", "INSTALLATION_FAILED", "REVISION_CONFLICT", "NOT_SUPPORTED", "INTERNAL"] },
    "ErrorResponse": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": { "code": { "$ref": "#/definitions/ServiceErrorCode" }, "message": { "type": "string", "minLength": 1, "maxLength": 256 }, "retryable": { "type": "boolean" } } },
    "ModelSelector": { "type": "object", "additionalProperties": false, "required": ["modelId", "revision", "profileId"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "$ref": "#/definitions/NonEmpty" } } },
    "ModelFile": { "type": "object", "additionalProperties": false, "required": ["path", "sizeBytes", "sha256"], "properties": { "path": { "$ref": "#/definitions/NonEmpty" }, "sizeBytes": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } } },
    "HardwareRequirements": { "type": "object", "additionalProperties": false, "required": ["cpuArchitectures", "minMemoryBytes", "accelerator"], "properties": { "cpuArchitectures": { "type": "array", "items": { "$ref": "#/definitions/NonEmpty" } }, "minMemoryBytes": { "type": ["integer", "null"], "minimum": 1 }, "accelerator": { "type": ["string", "null"] } } },
    "ProfileLimits": { "type": "object", "additionalProperties": false, "required": ["maxInputBytes", "maxAudioSeconds", "maxItems", "maxResultBytes", "vectorDimensions"], "properties": { "maxInputBytes": { "type": ["integer", "null"], "minimum": 1 }, "maxAudioSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 }, "maxItems": { "type": ["integer", "null"], "minimum": 1 }, "maxResultBytes": { "type": ["integer", "null"], "minimum": 1 }, "vectorDimensions": { "type": ["integer", "null"], "minimum": 1 } } },
    "Parameters": { "type": "object", "additionalProperties": false, "required": ["embed", "transcribe"], "properties": { "embed": { "type": ["object", "null"], "additionalProperties": false, "required": ["purpose"], "properties": { "purpose": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["query", "document", "symmetric"] } } } }, "transcribe": { "type": ["object", "null"], "additionalProperties": false, "properties": {} } } },
    "ModelRecord": { "type": "object", "additionalProperties": false, "required": ["modelId", "name", "description", "source", "license", "revision", "profileId", "supported", "operations", "languages", "inputKinds", "outputKinds", "files", "hardwareRequirements", "limits", "parameters"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "name": { "$ref": "#/definitions/NonEmpty" }, "description": { "type": "string" }, "source": { "$ref": "#/definitions/NonEmpty" }, "license": { "type": ["string", "null"] }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "type": ["string", "null"] }, "supported": { "type": "boolean" }, "operations": { "type": "array", "items": { "$ref": "#/definitions/OperationKind" } }, "languages": { "type": "array", "items": { "$ref": "#/definitions/NonEmpty" } }, "inputKinds": { "type": "array", "items": { "type": "string", "enum": ["text", "image_artifact", "audio_artifact", "video_artifact"] } }, "outputKinds": { "type": "array", "items": { "type": "string", "enum": ["vector", "transcription"] } }, "files": { "type": "array", "items": { "$ref": "#/definitions/ModelFile" } }, "hardwareRequirements": { "$ref": "#/definitions/HardwareRequirements" }, "limits": { "$ref": "#/definitions/ProfileLimits" }, "parameters": { "$ref": "#/definitions/Parameters" } }, "oneOf": [{ "properties": { "supported": { "const": true }, "profileId": { "$ref": "#/definitions/NonEmpty" }, "operations": { "type": "array", "minItems": 1 }, "inputKinds": { "type": "array", "minItems": 1 }, "outputKinds": { "type": "array", "minItems": 1 } } }, { "properties": { "supported": { "const": false }, "profileId": { "type": "null" } } }] },
    "ModelCard": { "type": "object", "additionalProperties": false, "required": ["modelId", "name", "description", "source", "license", "revision", "profileId", "supported", "operations", "languages", "inputKinds", "outputKinds", "files", "hardwareRequirements", "limits", "parameters", "installationState", "runtimeState"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "name": { "$ref": "#/definitions/NonEmpty" }, "description": { "type": "string" }, "source": { "$ref": "#/definitions/NonEmpty" }, "license": { "type": ["string", "null"] }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "type": ["string", "null"] }, "supported": { "type": "boolean" }, "operations": { "type": "array", "items": { "$ref": "#/definitions/OperationKind" } }, "languages": { "type": "array", "items": { "$ref": "#/definitions/NonEmpty" } }, "inputKinds": { "type": "array", "items": { "type": "string", "enum": ["text", "image_artifact", "audio_artifact", "video_artifact"] } }, "outputKinds": { "type": "array", "items": { "type": "string", "enum": ["vector", "transcription"] } }, "files": { "type": "array", "items": { "$ref": "#/definitions/ModelFile" } }, "hardwareRequirements": { "$ref": "#/definitions/HardwareRequirements" }, "limits": { "$ref": "#/definitions/ProfileLimits" }, "parameters": { "$ref": "#/definitions/Parameters" }, "installationState": { "type": "string", "enum": ["available", "not_installed", "installed", "unsupported"] }, "runtimeState": { "type": ["string", "null"], "enum": ["unloaded", "loading", "ready", "unloading", "error", null] } }, "oneOf": [{ "properties": { "supported": { "const": true }, "profileId": { "$ref": "#/definitions/NonEmpty" }, "operations": { "type": "array", "minItems": 1 }, "inputKinds": { "type": "array", "minItems": 1 }, "outputKinds": { "type": "array", "minItems": 1 } } }, { "properties": { "supported": { "const": false }, "profileId": { "type": "null" }, "installationState": { "const": "unsupported" }, "runtimeState": { "type": "null" } } }] },
    "CatalogFilter": { "type": "object", "additionalProperties": false, "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "operation": { "$ref": "#/definitions/OperationKind" }, "inputKind": { "type": "string", "enum": ["text", "image_artifact", "audio_artifact", "video_artifact"] }, "outputKind": { "type": "string", "enum": ["vector", "transcription"] }, "language": { "$ref": "#/definitions/NonEmpty" }, "installed": { "type": "boolean" } } },
    "ModelsListFilter": { "type": "object", "additionalProperties": false, "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "operation": { "$ref": "#/definitions/OperationKind" }, "inputKind": { "type": "string", "enum": ["text", "image_artifact", "audio_artifact", "video_artifact"] }, "outputKind": { "type": "string", "enum": ["vector", "transcription"] }, "language": { "$ref": "#/definitions/NonEmpty" }, "installed": { "type": "boolean" }, "ready": { "type": "boolean" } } },
    "PageRequest": { "type": "object", "additionalProperties": false, "properties": { "cursor": { "$ref": "#/definitions/NonEmpty" }, "limit": { "type": "integer", "minimum": 1 } } },
    "ModelsListRequest": { "type": "object", "additionalProperties": false, "required": ["filter"], "properties": { "filter": { "$ref": "#/definitions/ModelsListFilter" }, "page": { "$ref": "#/definitions/PageRequest" } } },
    "ModelsListResponse": { "type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/ModelCard" } }, "nextCursor": { "type": ["string", "null"] } } },
    "ModelsGetRequest": { "type": "object", "additionalProperties": false, "required": ["modelId"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" } } },
    "CatalogSearchRequest": { "type": "object", "additionalProperties": false, "required": ["query"], "properties": { "query": { "type": "string" }, "filter": { "type": "object", "additionalProperties": false, "properties": { "operation": { "$ref": "#/definitions/OperationKind" }, "inputKind": { "type": "string", "enum": ["text", "image_artifact", "audio_artifact", "video_artifact"] }, "outputKind": { "type": "string", "enum": ["vector", "transcription"] }, "language": { "$ref": "#/definitions/NonEmpty" } } }, "page": { "$ref": "#/definitions/PageRequest" } } },
    "CatalogSearchResponse": { "type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/ModelRecord" } }, "nextCursor": { "type": ["string", "null"] } } },
    "InstallRequest": { "type": "object", "additionalProperties": false, "required": ["modelId", "revision", "profileId", "requestId", "ownerId", "deadlineAt"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "$ref": "#/definitions/NonEmpty" }, "requestId": { "$ref": "#/definitions/Uuid" }, "ownerId": { "$ref": "#/definitions/NonEmpty" }, "deadlineAt": { "$ref": "#/definitions/Timestamp" } } },
    "OperationGetRequest": { "type": "object", "additionalProperties": false, "required": ["operationId", "ownerId"], "properties": { "operationId": { "$ref": "#/definitions/Uuid" }, "ownerId": { "$ref": "#/definitions/NonEmpty" } } },
    "InstallOperation": { "type": "object", "additionalProperties": false, "required": ["operationId", "ownerId", "modelId", "revision", "profileId", "status", "phase", "progressPercent", "errorCode", "createdAt", "updatedAt"], "properties": { "operationId": { "$ref": "#/definitions/Uuid" }, "ownerId": { "$ref": "#/definitions/NonEmpty" }, "modelId": { "$ref": "#/definitions/NonEmpty" }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "$ref": "#/definitions/NonEmpty" }, "status": { "type": "string", "enum": ["accepted", "running", "completed", "failed", "cancelled", "unknown"] }, "phase": { "type": "string", "enum": ["queued", "downloading", "verifying", "publishing", "completed", "failed", "cancelled"] }, "progressPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }, "errorCode": { "anyOf": [{ "$ref": "#/definitions/ServiceErrorCode" }, { "type": "null" }] }, "createdAt": { "$ref": "#/definitions/Timestamp" }, "updatedAt": { "$ref": "#/definitions/Timestamp" } } },
    "ConfigureRequest": { "type": "object", "additionalProperties": false, "required": ["modelId", "revision", "profileId", "ownerId", "idleUnloadSeconds"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "$ref": "#/definitions/NonEmpty" }, "ownerId": { "$ref": "#/definitions/NonEmpty" }, "idleUnloadSeconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647 } } },
    "ConfiguredResponse": { "type": "object", "additionalProperties": false, "required": ["modelId", "revision", "profileId", "idleUnloadSeconds"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "$ref": "#/definitions/NonEmpty" }, "idleUnloadSeconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647 } } },
    "ModelRevisionRequest": { "type": "object", "additionalProperties": false, "required": ["modelId", "revision", "profileId", "ownerId", "deadlineAt"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "$ref": "#/definitions/NonEmpty" }, "ownerId": { "$ref": "#/definitions/NonEmpty" }, "deadlineAt": { "$ref": "#/definitions/Timestamp" } } },
    "ModelMutationResponse": { "type": "object", "additionalProperties": false, "required": ["modelId", "revision", "profileId", "state"], "properties": { "modelId": { "$ref": "#/definitions/NonEmpty" }, "revision": { "$ref": "#/definitions/NonEmpty" }, "profileId": { "$ref": "#/definitions/NonEmpty" }, "state": { "type": "string", "enum": ["loaded", "unloaded", "removed"] } } },
    "InvocationBase": { "type": "object", "additionalProperties": false, "required": ["requestId", "model", "ownerId", "deadlineAt"], "properties": { "requestId": { "$ref": "#/definitions/Uuid" }, "model": { "$ref": "#/definitions/ModelSelector" }, "ownerId": { "$ref": "#/definitions/NonEmpty" }, "deadlineAt": { "$ref": "#/definitions/Timestamp" } } },
    "EmbeddingItem": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"type": "string"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "artifactId"], "properties": {"type": {"enum": ["image_artifact", "audio_artifact", "video_artifact"]}, "artifactId": {"$ref": "#/definitions/Uuid"}}}]},
    "EmbedRequest": {"type": "object", "additionalProperties": false, "required": ["requestId", "operationId", "model", "ownerId", "deadlineAt", "purpose"], "properties": {"requestId": {"$ref": "#/definitions/Uuid"}, "operationId": {"$ref": "#/definitions/Uuid"}, "model": {"$ref": "#/definitions/ModelSelector"}, "ownerId": {"$ref": "#/definitions/NonEmpty"}, "deadlineAt": {"$ref": "#/definitions/Timestamp"}, "texts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "purpose": {"type": "string", "enum": ["query", "document", "symmetric"]}, "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/EmbeddingItem"}}}, "oneOf": [{"required": ["texts"], "not": {"required": ["inputs"]}}, {"required": ["inputs"], "not": {"required": ["texts"]}}]},
    "TranscribeRequest": { "type": "object", "additionalProperties": false, "required": ["requestId", "operationId", "model", "ownerId", "deadlineAt", "audioArtifactId"], "properties": { "requestId": { "$ref": "#/definitions/Uuid" }, "operationId": { "$ref": "#/definitions/Uuid" }, "model": { "$ref": "#/definitions/ModelSelector" }, "ownerId": { "$ref": "#/definitions/NonEmpty" }, "deadlineAt": { "$ref": "#/definitions/Timestamp" }, "audioArtifactId": { "$ref": "#/definitions/Uuid" } } },
    "EmbedResponse": { "type": "object", "additionalProperties": false, "required": ["requestId", "operationId", "model", "durationMs", "vectors"], "properties": { "requestId": { "$ref": "#/definitions/Uuid" }, "operationId": { "$ref": "#/definitions/Uuid" }, "model": { "$ref": "#/definitions/ModelSelector" }, "durationMs": { "type": "integer", "minimum": 0 }, "vectors": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "number" } } } } },
    "Segment": { "type": "object", "additionalProperties": false, "required": ["startSeconds", "endSeconds", "text"], "properties": { "startSeconds": { "type": "number", "minimum": 0 }, "endSeconds": { "type": "number", "minimum": 0 }, "text": { "type": "string" } } },
    "TranscribeResponse": { "type": "object", "additionalProperties": false, "required": ["requestId", "operationId", "model", "durationMs", "text", "segments"], "properties": { "requestId": { "$ref": "#/definitions/Uuid" }, "operationId": { "$ref": "#/definitions/Uuid" }, "model": { "$ref": "#/definitions/ModelSelector" }, "durationMs": { "type": "integer", "minimum": 0 }, "text": { "type": "string" }, "segments": { "type": ["array", "null"], "items": { "$ref": "#/definitions/Segment" } } } },
    "CancelRequest": { "type": "object", "additionalProperties": false, "required": ["requestId", "operationId", "ownerId"], "properties": { "requestId": { "$ref": "#/definitions/Uuid" }, "operationId": { "$ref": "#/definitions/Uuid" }, "ownerId": { "$ref": "#/definitions/NonEmpty" } } },
    "CancelResponse": { "type": "object", "additionalProperties": false, "required": ["operationId", "status"], "properties": { "operationId": { "$ref": "#/definitions/Uuid" }, "status": { "type": "string", "enum": ["cancellation_requested", "already_terminal", "not_found"] } } },
    "StatusRequest": { "type": "object", "additionalProperties": false, "properties": { "ownerId": { "$ref": "#/definitions/NonEmpty" } } },
    "ComponentStatus": { "type": "object", "additionalProperties": false, "required": ["state", "errorCode"], "properties": { "state": { "type": "string", "enum": ["ready", "degraded", "unavailable", "unknown"] }, "errorCode": { "anyOf": [{ "$ref": "#/definitions/ServiceErrorCode" }, { "type": "null" }] } } },
    "StatusResponse": {"type": "object", "additionalProperties": false, "required": ["state", "components"], "properties": {"state": {"type": "string", "enum": ["ready", "degraded", "unavailable"]}, "components": {"type": "object", "additionalProperties": false, "required": ["database", "nats", "executables", "weights"], "properties": {"database": {"$ref": "#/definitions/ComponentStatus"}, "nats": {"$ref": "#/definitions/ComponentStatus"}, "executables": {"$ref": "#/definitions/ComponentStatus"}, "weights": {"$ref": "#/definitions/ComponentStatus"}}}}}
  }
}
