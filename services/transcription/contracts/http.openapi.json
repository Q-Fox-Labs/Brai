      "post": {
        "operationId": "request_submit",
        "description": "Trusted caller requires transcription:use. Text only in result.get while volatile buffer lives.",
        "security": [
          {
            "trustedSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/messages.schema.json#/definitions/PublicSubmitParams"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application DTO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/messages.schema.json#/definitions/PublicSubmitResult"
                }
              }
            }
          },
          "default": {
            "description": "Safe application error; status distinguishes invalid input, permission, conflict, capacity and dependency failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/messages.schema.json#/definitions/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
