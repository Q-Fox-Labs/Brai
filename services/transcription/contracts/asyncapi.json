{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Brai transcription",
    "version": "1.0.0",
    "description": "NATS Services: brai_transcription, queue brai_transcription; PING/INFO/STATS; trusted caller mapping from runtime. Request/reply metadata only, byte bounds configured, no JetStream text."
  },
  "defaultContentType": "application/json",
  "servers": {
    "private": {
      "host": "{host}:{port}",
      "protocol": "nats",
      "variables": {
        "host": {
          "default": "localhost"
        },
        "port": {
          "default": "4222"
        }
      }
    }
  },
  "channels": {
    "request_submit": {
      "address": "brai.transcription.v1.request.submit",
      "messages": {
        "request": {
          "$ref": "#/components/messages/PublicSubmitParams"
        }
      }
    },
    "request_get": {
      "address": "brai.transcription.v1.request.get",
      "messages": {
        "request": {
          "$ref": "#/components/messages/PublicGetParams"
        }
      }
    },
    "request_cancel": {
      "address": "brai.transcription.v1.request.cancel",
      "messages": {
        "request": {
          "$ref": "#/components/messages/PublicCancelParams"
        }
      }
    },
    "models_list": {
      "address": "brai.transcription.v1.models.list",
      "messages": {
        "request": {
          "$ref": "#/components/messages/PublicSettingsGetParams"
        }
      }
    },
    "settings_get": {
      "address": "brai.transcription.v1.settings.get",
