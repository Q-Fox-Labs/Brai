    "settings_set": {
      "address": "brai.transcription.v1.settings.set",
      "messages": {
        "request": {
          "$ref": "#/components/messages/PublicSettingsSetParams"
        }
      }
    },
    "replies": {
      "address": null,
      "messages": {
        "PublicSubmitResult": {
          "$ref": "#/components/messages/PublicSubmitResult"
        },
        "PublicCancelResult": {
          "$ref": "#/components/messages/PublicCancelResult"
        },
        "ModelsListResult": {
          "$ref": "#/components/messages/ModelsListResult"
        },
        "SettingsResult": {
          "$ref": "#/components/messages/SettingsResult"
        },
        "ErrorResponse": {
          "$ref": "#/components/messages/ErrorResponse"
        }
      }
    }
  },
