{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "helper/**/*.ts",
    "coordinator/**/*.ts",
    "executors/**/*.ts",
    "runtime/**/*.ts"
  ]
}
