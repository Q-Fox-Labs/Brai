{
  "formatVersion": 1,
  "id": "auth",
  "type": "container",
  "status": "active",
  "environments": [
    "dev",
    "prod"
  ],
  "executableSources": [
    "services/auth/src/bootstrap.ts",
    "services/auth/src/health.ts",
    "services/auth/src/import-identities.ts",
    "services/auth/src/main.ts",
    "services/auth/src/provision-identities.ts",
    "services/auth/src/ready-profiles.ts",
    "services/auth/src/revoke-legacy.ts",
    "services/auth/src/verify-provision.ts",
    "services/auth/src/migrate.ts"
  ],
  "inputs": {
    "build": [
      "services/auth/tsconfig.json"
    ],
    "runtime": [
      "services/auth/package.json",
      "services/auth/schemas/messages.schema.json",
      "services/auth/src/admin.ts",
      "services/auth/src/auth.ts",
      "services/auth/src/bootstrap.ts",
      "services/auth/src/bridge.ts",
      "services/auth/src/config.ts",
      "services/auth/src/email.ts",
      "services/auth/src/health.ts",
      "services/auth/src/identity-schema.ts",
      "services/auth/src/identity-types.ts",
      "services/auth/src/identity-record.ts",
      "services/auth/src/identity.ts",
      "services/auth/src/import-identities.ts",
      "services/auth/src/login-code.ts",
      "services/auth/src/main.ts",
      "services/auth/src/migrate.ts",
      "services/auth/src/nats.ts",
      "services/auth/src/provision-identities.ts",
      "services/auth/src/ready-profiles.ts",
      "services/auth/src/revoke-legacy.ts",
      "services/auth/src/schema.ts",
      "services/auth/src/sso.ts",
      "services/auth/src/verify-provision.ts",
      "services/auth/src/telegram-plugin.ts",
      "services/auth/src/v2.ts",
      "services/auth/contracts/service-data-scope.mjs",
      "services/auth/contracts/service-data-scope.d.mts",
      "services/auth/contracts/PERSONAL_DATA.md",
      "services/auth/src/lifecycle.ts",
      "services/auth/src/web-access.ts"
    ],
    "checks": [
      "services/auth/tests/bridge.test.mjs",
      "services/auth/tests/config.test.mjs",
      "services/auth/tests/engine.test.mjs",
      "services/auth/tests/integration/auth.test.mjs",
      "services/auth/tests/integration/compose.yml",
      "services/auth/tests/integration/init.sql",
      "services/auth/tests/integration/identity.test.mjs",
      "services/auth/tests/integration/migration.test.mjs",
      "services/auth/tests/integration/sso.test.mjs",
      "services/auth/tests/sso.test.mjs",
      "services/auth/tests/v2.test.mjs",
      "services/auth/tests/service-data-scope.test.mjs",
      "services/auth/tests/lifecycle.test.mjs",
      "services/auth/tests/integration/lifecycle.test.mjs",
      "services/auth/tests/integration/invite-lifecycle.test.mjs",
      "services/auth/tests/integration/telegram-lifecycle.test.mjs",
      "services/auth/tests/email.roles.sol.test.mjs",
      "services/auth/tests/integration/00-roles-regression.test.mjs",
      "services/auth/tests/integration/roles-revocation.test.mjs",
      "services/auth/tests/integration/email-role-generation.test.mjs"
    ]
  },
  "dependencies": [],
  "commands": {
    "build": "npm run build",
    "check": "node --test tests/*.test.mjs"
  },
  "delivery": {
    "kind": "oci-context",
    "files": [
      "services/auth/dist",
      "services/auth/package.json",
      "services/auth/schemas",
      "services/auth/contracts"
    ],
    "entrypoints": [
      "services/auth/dist/bootstrap.js",
      "services/auth/dist/import-identities.js",
      "services/auth/dist/provision-identities.js",
      "services/auth/dist/ready-profiles.js",
      "services/auth/dist/revoke-legacy.js",
      "services/auth/dist/verify-provision.js",
      "services/auth/dist/main.js",
      "services/auth/dist/migrate.js",
      "services/auth/dist/health.js"
    ],
    "smokeImports": [],
    "systemRequirements": [
      "Node.js 24.22.1"
    ]
  },
  "deploy": {
    "units": [
      "auth",
      "auth-migrate"
    ],
    "migrations": [
      "services/auth/migrations"
    ],
    "health": "node services/auth/dist/health.js"
  },
  "npm": {
    "workspaces": [
      "services/auth"
    ]
  }
}
