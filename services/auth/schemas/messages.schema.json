  "definitions": {
    "Headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cookie": {
          "type": "string",
          "maxLength": 16384
        },
        "origin": {
          "type": "string",
          "maxLength": 16384
        },
        "user-agent": {
          "type": "string",
          "maxLength": 16384
        },
        "x-forwarded-for": {
          "type": "string",
          "maxLength": 16384
        },
        "sec-fetch-site": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "SendCodeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email"
          ],
          "properties": {
            "email": {
              "type": "string",
              "maxLength": 320,
              "pattern": "^\\S+@\\S+\\.\\S+$"
            }
          }
        }
      }
    },
    "VerifyCodeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email",
            "otp"
          ],
          "properties": {
            "email": {
              "type": "string",
              "maxLength": 320,
              "pattern": "^\\S+@\\S+\\.\\S+$"
            },
            "otp": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            }
          }
        }
      }
    },
    "SessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "SignOutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "body",
        "setCookies"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "body": {},
        "setCookies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SsoIssueRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetOrigin",
            "challenge"
          ],
          "properties": {
            "targetOrigin": {
              "type": "string",
              "maxLength": 2048
            },
            "challenge": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        }
      }
    },
    "SsoRedeemRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ticket",
            "verifier",
            "targetOrigin"
          ],
          "properties": {
            "ticket": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,4096}$"
            },
            "verifier": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "targetOrigin": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      }
    },
    "IdentityUser": {"type":"object","additionalProperties":false,"required":["id","name","role","status","telegramId","profileId"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"role":{"enum":["creator","admin","user","guest"]},"status":{"enum":["provisioning","active","blocked"]},"telegramId":{"type":["string","null"]},"telegramIds":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"}},"profileId":{"type":["string","null"]},"email":{"type":"string"},"lifecycle":{"anyOf":[{"$ref":"#/definitions/LifecycleSummary"},{"type":"null"}]},"generation":{"type":"integer","minimum":0},"appliedGeneration":{"type":"integer","minimum":0}}},
