{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.example/schemas/auth/messages.schema.json",
  "definitions": {
    "Headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cookie": {
          "type": "string",
          "maxLength": 16384
        },
        "origin": {
          "type": "string",
          "maxLength": 16384
        },
        "user-agent": {
          "type": "string",
          "maxLength": 16384
        },
        "x-forwarded-for": {
          "type": "string",
          "maxLength": 16384
        },
        "sec-fetch-site": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "SendCodeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email"
          ],
          "properties": {
            "email": {
              "type": "string",
              "maxLength": 320,
              "pattern": "^\\S+@\\S+\\.\\S+$"
            }
          }
        }
      }
    },
    "VerifyCodeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email",
            "otp"
          ],
          "properties": {
            "email": {
              "type": "string",
              "maxLength": 320,
              "pattern": "^\\S+@\\S+\\.\\S+$"
            },
            "otp": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            }
          }
        }
      }
    },
    "SessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "SignOutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "body",
        "setCookies"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "body": {},
        "setCookies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SsoIssueRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetOrigin",
            "challenge"
          ],
          "properties": {
            "targetOrigin": {
              "type": "string",
              "maxLength": 2048
            },
            "challenge": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        }
      }
    },
    "SsoRedeemRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "#/definitions/Headers"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ticket",
            "verifier",
            "targetOrigin"
          ],
          "properties": {
            "ticket": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,4096}$"
            },
            "verifier": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "targetOrigin": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      }
    },
    "IdentityUser": {"type":"object","additionalProperties":false,"required":["id","name","role","status","telegramId","profileId"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"role":{"enum":["admin","user"]},"status":{"enum":["provisioning","active","blocked"]},"telegramId":{"type":["string","null"]},"profileId":{"type":["string","null"]},"email":{"type":"string"}}},
    "TelegramResolveRequest": {"type":"object","additionalProperties":false,"required":["telegramId"],"properties":{"telegramId":{"type":"string","pattern":"^[0-9]{1,20}$"}}},
    "TelegramCodeIssueRequest": {"type":"object","additionalProperties":false,"required":["telegramId","requestId"],"properties":{"telegramId":{"type":"string","pattern":"^[0-9]{1,20}$"},"requestId":{"type":"string","minLength":1,"maxLength":128}}},
    "TelegramResolveResponse": {"type":"object","additionalProperties":false,"required":["user"],"properties":{"user":{"anyOf":[{"$ref":"#/definitions/IdentityUser"},{"type":"null"}]}}},
    "TelegramCodeIssueResponse": {"type":"object","additionalProperties":false,"required":["code","expiresAt","origin"],"properties":{"code":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$"},"expiresAt":{"type":"string"},"origin":{"type":"string"}}},
    "IdentityProvisionRequest": {"type":"object","additionalProperties":false,"required":["requestId","telegramId","role","status"],"properties":{"requestId":{"type":"string","minLength":1,"maxLength":128},"telegramId":{"type":"string","pattern":"^[0-9]{1,20}$"},"name":{"type":"string","minLength":1,"maxLength":200},"role":{"enum":["admin","user"]},"userId":{"type":"string","minLength":1,"maxLength":128},"profileId":{"type":"string","minLength":1,"maxLength":128},"status":{"enum":["provisioning","active","blocked"]}}},
    "ProfileReadyRequest": {"type":"object","additionalProperties":false,"required":["userId","profileId"],"properties":{"userId":{"type":"string","minLength":1,"maxLength":128},"profileId":{"type":"string","minLength":1,"maxLength":128}}},
    "InviteRedeemRequest": {"type":"object","additionalProperties":false,"required":["telegramId","code"],"properties":{"telegramId":{"type":"string","pattern":"^[0-9]{1,20}$"},"code":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},"name":{"type":"string","minLength":1,"maxLength":200}}},
    "LoginCodeRedeemRequest": {"type":"object","additionalProperties":false,"required":["headers","body"],"properties":{"headers":{"$ref":"#/definitions/Headers"},"body":{"type":"object","additionalProperties":false,"required":["code"],"properties":{"code":{"type":"string","maxLength":64}}}}},
    "AdminEmptyRequest": {"type":"object","additionalProperties":false,"required":["headers","body"],"properties":{"headers":{"$ref":"#/definitions/Headers"},"body":{"type":"object","additionalProperties":false,"required":[],"properties":{}}}},
    "AdminUserRequest": {"type":"object","additionalProperties":false,"required":["headers","body"],"properties":{"headers":{"$ref":"#/definitions/Headers"},"body":{"type":"object","additionalProperties":false,"required":["userId"],"properties":{"userId":{"type":"string","minLength":1,"maxLength":128}}}}},
    "AdminRoleRequest": {"type":"object","additionalProperties":false,"required":["headers","body"],"properties":{"headers":{"$ref":"#/definitions/Headers"},"body":{"type":"object","additionalProperties":false,"required":["userId","role"],"properties":{"userId":{"type":"string","minLength":1,"maxLength":128},"role":{"enum":["admin","user"]}}}}},
    "AdminStatusRequest": {"type":"object","additionalProperties":false,"required":["headers","body"],"properties":{"headers":{"$ref":"#/definitions/Headers"},"body":{"type":"object","additionalProperties":false,"required":["userId","status"],"properties":{"userId":{"type":"string","minLength":1,"maxLength":128},"status":{"enum":["provisioning","active","blocked"]}}}}},
    "AdminInviteRequest": {"type":"object","additionalProperties":false,"required":["headers","body"],"properties":{"headers":{"$ref":"#/definitions/Headers"},"body":{"type":"object","additionalProperties":false,"required":["inviteId"],"properties":{"inviteId":{"type":"string","minLength":1,"maxLength":128}}}}},
    "AdminAuditRequest": {"type":"object","additionalProperties":false,"required":["headers","body"],"properties":{"headers":{"$ref":"#/definitions/Headers"},"body":{"type":"object","additionalProperties":false,"required":["userId","action"],"properties":{"userId":{"type":"string","minLength":1,"maxLength":128},"action":{"enum":["memory.list","memory.read","chats.list","chats.read","artifacts.list","artifacts.read"]}}}}},
    "TelegramLinkIssueRequest": {
      "$ref": "#/definitions/TelegramResolveRequest"
    },
    "TelegramLinkRedeemRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telegramId",
        "code"
      ],
      "properties": {
        "telegramId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "TelegramUnlinkRequest": {
      "type":"object","additionalProperties":false,"required":["telegramId","targetTelegramId"],
      "properties":{"telegramId":{"type":"string","pattern":"^[0-9]{1,20}$"},"targetTelegramId":{"type":"string","pattern":"^[0-9]{1,20}$"}}
    },
    "IdentityGetRequest": {
      "type":"object","additionalProperties":false,"required":["userId"],
      "properties":{"userId":{"type":"string","minLength":1,"maxLength":128}}
    },
    "IdentityGetResponse": {
      "type":"object","additionalProperties":false,"required":["user","telegramIds"],
      "properties":{"user":{"anyOf":[{"$ref":"#/definitions/IdentityUser"},{"type":"null"}]},
        "telegramIds":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"}}}
    },
    "TelegramLinkIssueResponse": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "expiresAt"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "expiresAt": {
              "type": "string"
            }
          }
        }
      ]
    },
    "TelegramUnlinkResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unlinked"
      ],
      "properties": {
        "unlinked": {
          "type": "boolean"
        }
      }
    }
  }
}
