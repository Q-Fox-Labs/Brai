    "test:connection": "npm run build && node --test test/connection.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "pg": "8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
