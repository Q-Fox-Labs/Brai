{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.invalid/contracts/contacts/v1/common.schema.json",
  "title": "Contacts v1 owner DTO",
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "externalId"
      ],
      "properties": {
        "namespace": {
          "const": "telegram"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "photoArtifactId": {
          "anyOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "sourceId",
        "callerId",
        "operationId"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/definitions/timestamp"
        },
        "sourceId": {
          "$ref": "#/definitions/source"
        },
        "callerId": {
          "$ref": "#/definitions/source"
        },
        "operationId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "enum": [
          "name",
          "username",
          "photoArtifactId"
        ]
      },
      "uniqueItems": true,
      "maxItems": 3
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "username",
        "photoArtifactId",
        "observedFields"
      ],
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "photoArtifactId": {
          "anyOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedFields": {
          "$ref": "#/definitions/fields"
        }
      }
    },
    "historyEvents": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "https://brai.invalid/contracts/history/v1/messages.schema.json#/definitions/appendRequest"
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contactResolutionId",
        "operationId",
        "packetId",
        "ownerId",
        "sourceId",
        "observedAt",
        "contactId",
        "identityId",
        "identity",
        "senderSnapshot",
        "historyEvents"
      ],
      "properties": {
        "contactResolutionId": {
          "$ref": "#/definitions/uuid"
        },
        "operationId": {
          "$ref": "#/definitions/id"
        },
        "packetId": {
          "$ref": "#/definitions/uuid"
        },
        "ownerId": {
          "$ref": "#/definitions/id"
        },
        "sourceId": {
          "$ref": "#/definitions/source"
        },
        "observedAt": {
          "$ref": "#/definitions/timestamp"
        },
        "contactId": {
          "$ref": "#/definitions/uuid"
        },
        "identityId": {
          "$ref": "#/definitions/uuid"
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "senderSnapshot": {
          "$ref": "#/definitions/snapshot"
        },
        "historyEvents": {
          "$ref": "#/definitions/historyEvents"
        }
      }
    },
    "observationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "ownerId",
        "sourceId",
        "observedAt",
        "contactId",
        "identityId",
        "identity",
        "profile",
        "changedFields",
        "committedAt",
        "historyEvents"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/definitions/id"
        },
        "ownerId": {
          "$ref": "#/definitions/id"
        },
        "sourceId": {
          "$ref": "#/definitions/source"
        },
        "observedAt": {
          "$ref": "#/definitions/timestamp"
        },
        "contactId": {
          "$ref": "#/definitions/uuid"
        },
        "identityId": {
          "$ref": "#/definitions/uuid"
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "profile": {
          "$ref": "#/definitions/profile"
        },
        "changedFields": {
          "$ref": "#/definitions/fields"
        },
        "committedAt": {
          "$ref": "#/definitions/timestamp"
        },
        "historyEvents": {
          "$ref": "#/definitions/historyEvents"
        }
      }
    },
    "currentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contactId",
        "ownerId",
        "namespace",
        "externalId",
        "name",
        "username",
        "photoArtifactId",
        "fieldOrigins",
        "firstObservedAt",
        "lastObservedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "contactId": {
          "$ref": "#/definitions/uuid"
        },
        "ownerId": {
          "$ref": "#/definitions/id"
        },
        "namespace": {
          "const": "telegram"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[1-9][0-9]*$"
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "photoArtifactId": {
          "anyOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "fieldOrigins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "username",
            "photoArtifactId"
          ],
          "properties": {
            "name": {
              "anyOf": [
                {
                  "$ref": "#/definitions/origin"
                },
                {
                  "type": "null"
                }
              ]
            },
            "username": {
              "anyOf": [
                {
                  "$ref": "#/definitions/origin"
                },
                {
                  "type": "null"
                }
              ]
            },
            "photoArtifactId": {
              "anyOf": [
                {
                  "$ref": "#/definitions/origin"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "firstObservedAt": {
          "$ref": "#/definitions/timestamp"
        },
        "lastObservedAt": {
          "$ref": "#/definitions/timestamp"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerId",
        "createdAt",
        "identities"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "ownerId": {
          "$ref": "#/definitions/id"
        },
        "createdAt": {
          "$ref": "#/definitions/timestamp"
        },
        "identities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/currentIdentity"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_NAMESPACE",
            "FORBIDDEN",
            "NOT_FOUND",
            "REQUEST_ID_CONFLICT",
            "INVALID_CURSOR",
            "REQUEST_TOO_LARGE",
            "RESULT_TOO_LARGE",
            "BUSY",
            "DATABASE_UNAVAILABLE",
            "DEADLINE_EXCEEDED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
