{
  "name": "@brai/agent",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "health": "node dist/health.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check:contracts": "npm run build && node --test tests/*.test.mjs"
  },
  "exports": {
    "./contracts": {
      "types": "./contracts/index.d.mts",
      "default": "./contracts/index.mjs"
    },
    "./contracts/codex/schema.json": "./contracts/codex/schema.json"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "nats": "2.29.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
