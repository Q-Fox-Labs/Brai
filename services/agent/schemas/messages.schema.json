{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.dev/schemas/agent-messages-1.json",
  "title": "Brai agent DTOs",
  "description": "Собственные DTO сервиса agent. Внешние Codex и AG-UI структуры проверяются их upstream-схемами.",
  "definitions": {
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Generation": {
      "type": "string",
      "format": "uuid"
    },
    "OperationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "Empty": {
      "type": "object",
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "name",
        "available"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "ThreadMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "title",
        "updatedAt"
      ],
      "properties": {
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "ProjectsRequest": {
      "$ref": "#/definitions/Empty"
    },
    "ProjectsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "projects"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Project"
          }
        }
      }
    },
    "StatusRequest": {
      "$ref": "#/definitions/Empty"
    },
    "StatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "ready",
        "connection",
        "authorization"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "ready": {
          "type": "boolean"
        },
        "connection": {
          "enum": [
            "connected",
            "connecting",
            "disconnected"
          ]
        },
        "authorization": {
          "enum": [
            "ready",
            "required",
            "failed",
            "unknown"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loadedThreads": {
              "type": "integer",
              "minimum": 0
            },
            "activeTurns": {
              "type": "integer",
              "minimum": 0
            },
            "pendingRpc": {
              "type": "integer",
              "minimum": 0
            },
            "pendingForms": {
              "type": "integer",
              "minimum": 0
            },
            "clients": {
              "type": "integer",
              "minimum": 0
            },
            "queuePerClient": {
              "type": "integer",
              "minimum": 0
            },
            "ledgerEntries": {
              "type": "integer",
              "minimum": 0
            },
            "upstreamFrameBytes": {
              "type": "integer",
              "minimum": 0
            },
            "natsSseFrameBytes": {
              "type": "integer",
              "minimum": 0
            },
            "snapshotBytes": {
              "type": "integer",
              "minimum": 0
            },
            "historyResponseBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "ThreadsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "cursor": {
          "$ref": "#/definitions/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "ThreadsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "threads",
        "nextCursor"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ThreadMetadata"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/Cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ThreadCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "generation",
        "operationId"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        }
      }
    },
    "ThreadCreateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "operationId",
        "outcome",
        "threadId"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "outcome": {
          "const": "accepted"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        }
      }
    },
    "ThreadReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "threadId"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        }
      }
    },
    "Truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truncated",
        "reason"
      ],
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "none",
            "byte-budget",
            "item-limit",
            "upstream-limit"
          ]
        }
      }
    },
    "ThreadSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "threadId",
        "generation",
        "streamEpoch",
        "seq",
        "state",
        "messages",
        "pendingRequests",
        "truncation",
        "activeTurnId",
        "turnStatus",
        "traceItems"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "streamEpoch": {
          "$ref": "#/definitions/Generation"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "ready",
            "working",
            "waiting",
            "completed",
            "interrupted",
            "error",
            "connection-lost",
            "executor-unavailable"
          ]
        },
        "messages": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object"
          }
        },
        "pendingRequests": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/PendingRequest"
          }
        },
        "truncation": {
          "$ref": "#/definitions/Truncation"
        },
        "activeTurnId": {
          "anyOf": [
            {
              "$ref": "#/definitions/OpaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "turnStatus": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "interrupted",
                "failed",
                "inProgress"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "traceItems": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/HistoryItem"
          }
        }
      }
    },
    "HistoryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "threadId"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "cursor": {
          "$ref": "#/definitions/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "turnId": {
          "$ref": "#/definitions/OpaqueId"
        }
      }
    },
    "HistoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "order",
        "kind",
        "content",
        "turnId",
        "trace",
        "truncated",
        "contentBytes"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "maxLength": 64
        },
        "content": {
          "type": "string",
          "maxLength": 786432
        },
        "truncated": {
          "type": "boolean"
        },
        "contentBytes": {
          "type": "integer",
          "minimum": 0
        },
        "turnId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "trace": {
          "$ref": "#/definitions/Trace"
        }
      }
    },
    "HistoryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "items",
        "truncation",
        "nextCursor"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/HistoryItem"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncation": {
          "$ref": "#/definitions/Truncation"
        }
      }
    },
    "TurnStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "threadId",
        "generation",
        "operationId",
        "text"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "TurnSteerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "threadId",
        "generation",
        "operationId",
        "expectedTurnId",
        "text"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "expectedTurnId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "TurnInterruptRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "threadId",
        "generation",
        "operationId",
        "turnId"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "turnId": {
          "$ref": "#/definitions/OpaqueId"
        }
      }
    },
    "RequestRespondRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "threadId",
            "generation",
            "operationId",
            "requestId",
            "kind",
            "answer"
          ],
          "properties": {
            "projectId": {
              "$ref": "#/definitions/ProjectId"
            },
            "threadId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "generation": {
              "$ref": "#/definitions/Generation"
            },
            "operationId": {
              "$ref": "#/definitions/OperationId"
            },
            "requestId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "kind": {
              "const": "command-approval"
            },
            "answer": {
              "$ref": "https://brai.dev/contracts/codex/schema.json#/definitions/CommandExecutionRequestApprovalResponse"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "threadId",
            "generation",
            "operationId",
            "requestId",
            "kind",
            "answer"
          ],
          "properties": {
            "projectId": {
              "$ref": "#/definitions/ProjectId"
            },
            "threadId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "generation": {
              "$ref": "#/definitions/Generation"
            },
            "operationId": {
              "$ref": "#/definitions/OperationId"
            },
            "requestId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "kind": {
              "const": "file-change-approval"
            },
            "answer": {
              "$ref": "https://brai.dev/contracts/codex/schema.json#/definitions/FileChangeRequestApprovalResponse"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "threadId",
            "generation",
            "operationId",
            "requestId",
            "kind",
            "answer"
          ],
          "properties": {
            "projectId": {
              "$ref": "#/definitions/ProjectId"
            },
            "threadId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "generation": {
              "$ref": "#/definitions/Generation"
            },
            "operationId": {
              "$ref": "#/definitions/OperationId"
            },
            "requestId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "kind": {
              "const": "permissions"
            },
            "answer": {
              "$ref": "https://brai.dev/contracts/codex/schema.json#/definitions/PermissionsRequestApprovalResponse"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "threadId",
            "generation",
            "operationId",
            "requestId",
            "kind",
            "answer"
          ],
          "properties": {
            "projectId": {
              "$ref": "#/definitions/ProjectId"
            },
            "threadId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "generation": {
              "$ref": "#/definitions/Generation"
            },
            "operationId": {
              "$ref": "#/definitions/OperationId"
            },
            "requestId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "kind": {
              "const": "question"
            },
            "answer": {
              "$ref": "https://brai.dev/contracts/codex/schema.json#/definitions/ToolRequestUserInputResponse"
            }
          }
        }
      ]
    },
    "TurnMutationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "operationId",
        "outcome",
        "threadId",
        "turnId"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "outcome": {
          "const": "accepted"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "turnId": {
          "$ref": "#/definitions/OpaqueId"
        }
      }
    },
    "RequestRespondResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "operationId",
        "outcome",
        "requestId"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "outcome": {
          "const": "accepted"
        },
        "requestId": {
          "$ref": "#/definitions/OpaqueId"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "outcome"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "STALE_GENERATION",
            "OPERATION_CONFLICT",
            "REQUEST_TOO_LARGE",
            "ITEM_TOO_LARGE",
            "CAPACITY_EXHAUSTED",
            "UPSTREAM_UNAVAILABLE",
            "TIMEOUT",
            "NOT_FOUND",
            "UNSUPPORTED",
            "STALE_REQUEST"
          ]
        },
        "outcome": {
          "enum": [
            "not-sent",
            "unknown",
            "query"
          ]
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "threadId",
        "turnId",
        "generation",
        "streamEpoch",
        "seq",
        "event"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/ProjectId"
        },
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "turnId": {
          "anyOf": [
            {
              "$ref": "#/definitions/OpaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "streamEpoch": {
          "$ref": "#/definitions/Generation"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event": {
          "type": "object"
        }
      }
    },
    "CustomRequestOpened": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/definitions/PendingRequest"
        }
      }
    },
    "CustomRequestResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "outcome"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected",
            "stale",
            "unknown"
          ]
        }
      }
    },
    "CustomConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "connected",
            "connecting",
            "disconnected",
            "executor-unavailable"
          ]
        }
      }
    },
    "CustomTruncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "reason"
      ],
      "properties": {
        "threadId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "reason": {
          "enum": [
            "byte-budget",
            "item-limit",
            "upstream-limit"
          ]
        }
      }
    },
    "CustomResyncRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "gap",
            "overflow",
            "generation-change",
            "epoch-change",
            "old-epoch"
          ]
        }
      }
    },
    "CustomOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "text"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "text": {
          "type": "string",
          "maxLength": 786432
        },
        "truncated": {
          "type": "boolean"
        },
        "contentBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CustomDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "diff"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/definitions/OpaqueId"
        },
        "diff": {
          "type": "string",
          "maxLength": 786432
        },
        "truncated": {
          "type": "boolean"
        },
        "contentBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PendingRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "kind",
            "params"
          ],
          "properties": {
            "requestId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "kind": {
              "const": "command-approval"
            },
            "params": {
              "$ref": "https://brai.dev/contracts/codex/schema.json#/definitions/CommandExecutionRequestApprovalParams"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "kind",
            "params"
          ],
          "properties": {
            "requestId": {
              "$ref": "#/definitions/OpaqueId"
            },
            "kind": {
              "const": "file-change-approval"
            },
