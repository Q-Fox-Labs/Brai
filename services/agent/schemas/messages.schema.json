{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "const": "projects"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "const": "status"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId"
          ],
          "properties": {
            "action": {
              "const": "threads"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId",
            "generation",
            "operationId"
          ],
          "properties": {
            "action": {
              "const": "create"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId",
            "threadId"
          ],
          "properties": {
            "action": {
              "const": "open"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId",
            "threadId"
          ],
          "properties": {
            "action": {
              "const": "turns"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId",
            "threadId"
          ],
          "properties": {
            "action": {
              "const": "items"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "turnId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId",
            "threadId",
            "generation",
            "operationId",
            "text"
          ],
          "properties": {
            "action": {
              "const": "start"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId",
            "threadId",
            "generation",
            "operationId",
            "expectedTurnId",
            "text"
          ],
          "properties": {
            "action": {
              "const": "steer"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "expectedTurnId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId",
            "threadId",
            "generation",
            "operationId",
            "turnId"
          ],
          "properties": {
            "action": {
              "const": "interrupt"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "turnId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "projectId",
            "threadId",
            "generation",
            "operationId",
            "requestId",
            "answer"
          ],
          "properties": {
            "action": {
              "const": "answer"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "answer": {
              "anyOf": [
                {
                  "$ref": "../contracts/codex/schema.json#/definitions/CommandExecutionRequestApprovalResponse"
                },
                {
                  "$ref": "../contracts/codex/schema.json#/definitions/FileChangeRequestApprovalResponse"
                },
                {
                  "$ref": "../contracts/codex/schema.json#/definitions/PermissionsRequestApprovalResponse"
                },
                {
                  "$ref": "../contracts/codex/schema.json#/definitions/ToolRequestUserInputResponse"
                }
              ]
            }
          }
        }
      ]
    },
    "DisplayItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "phase": {
          "enum": [
            "commentary",
            "final_answer",
            null
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "turnId",
        "type",
        "text"
      ]
    },
    "ThreadMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "canAcceptDirectInput": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "updatedAt": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "preview",
        "model",
        "canAcceptDirectInput",
        "updatedAt"
      ]
    },
    "PendingRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "command-approval",
            "file-change-approval",
            "permissions",
            "question",
            "unsupported"
          ]
        },
        "method": {
          "type": "string"
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "params": {
          "type": "object"
        },
        "answered": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "kind",
        "method",
        "turnId",
        "params",
        "answered"
      ]
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "inProgress",
            "completed",
            "interrupted",
            "failed"
          ]
        }
      },
      "required": [
        "id",
        "status"
      ]
    },
    "NativeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "thread": {
          "$ref": "#/definitions/ThreadMetadata"
        },
        "turn": {
          "anyOf": [
            {
              "$ref": "#/definitions/Turn"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "idle",
            "inProgress",
            "completed",
            "interrupted",
            "failed",
            "waiting",
            "connection-lost",
            "executor-unavailable"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DisplayItem"
          },
          "maxItems": 128
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PendingRequest"
          },
          "maxItems": 64
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "projectId",
        "threadId",
        "generation",
        "epoch",
        "seq",
        "thread",
        "turn",
        "state",
        "items",
        "requests",
        "truncated"
      ]
    },
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection": {
          "enum": [
            "connecting",
            "connected",
            "disconnected"
          ]
        },
        "authorization": {
          "enum": [
            "unknown",
            "ready",
            "required"
          ]
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "generation",
        "connection",
        "authorization",
        "ready"
      ]
    },
    "Projects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "projectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string"
              },
              "available": {
                "type": "boolean"
              }
            },
            "required": [
              "projectId",
              "name",
              "available"
            ]
          }
        }
      },
      "required": [
        "generation",
        "projects"
      ]
    },
    "Accepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome": {
          "const": "accepted"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "generation",
        "operationId",
        "outcome",
        "threadId"
      ]
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "data": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/definitions/ThreadMetadata"
              },
              {
                "$ref": "#/definitions/DisplayItem"
              },
              {
                "$ref": "#/definitions/Turn"
              }
            ]
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "generation",
        "data",
        "nextCursor"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "REQUEST_TOO_LARGE",
            "ITEM_TOO_LARGE",
            "STALE_GENERATION",
            "STALE_REQUEST",
            "OPERATION_CONFLICT",
            "CAPACITY_EXHAUSTED",
            "UPSTREAM_UNAVAILABLE",
            "TIMEOUT",
            "NOT_FOUND",
            "UNSUPPORTED"
          ]
        },
        "outcome": {
          "enum": [
            "not-sent",
            "unknown",
            "query"
          ]
        },
        "upstreamCode": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "outcome"
      ]
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "STATE_SNAPSHOT"
            },
            "snapshot": {
              "$ref": "#/definitions/NativeSnapshot"
            }
          },
          "required": [
            "type",
            "snapshot"
          ]
        }
      },
      "required": [
        "projectId",
        "threadId",
        "generation",
        "epoch",
        "seq",
        "event"
      ]
    },
    "Response": {
      "oneOf": [
        {
          "$ref": "#/definitions/NativeSnapshot"
        },
        {
          "$ref": "#/definitions/Status"
        },
        {
          "$ref": "#/definitions/Projects"
        },
        {
          "$ref": "#/definitions/Accepted"
        },
        {
          "$ref": "#/definitions/Page"
        },
        {
          "$ref": "#/definitions/Error"
        }
      ]
    }
  }
}
