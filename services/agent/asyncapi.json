{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Brai agent native state service",
    "version": "2.0.0"
  },
  "defaultContentType": "application/json",
  "channels": {
    "rpc": {
      "address": "brai.agent.v2.rpc",
      "messages": {
        "command": {
          "payload": {
            "$ref": "./schemas/messages.schema.json#/definitions/Command"
          }
        }
      }
    },
    "replies": {
      "address": null,
      "x-nats-reply-subject": "message.reply",
      "messages": {
        "response": {
          "headers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Nats-Service-Error": {
                "type": "string"
              },
              "Nats-Service-Error-Code": {
                "type": "string"
              }
            },
            "required": []
          },
          "payload": {
            "$ref": "./schemas/messages.schema.json#/definitions/Response"
          }
        }
      }
    },
    "event": {
      "address": "brai.agent.v2.event",
      "messages": {
        "snapshot": {
          "payload": {
            "$ref": "./schemas/messages.schema.json#/definitions/EventEnvelope"
          }
        }
      }
    }
  },
  "operations": {
    "request": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/rpc"
      },
      "messages": [
        {
          "$ref": "#/channels/rpc/messages/command"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/replies"
        },
        "messages": [
          {
            "$ref": "#/channels/replies/messages/response"
          }
        ]
      }
    },
    "publish": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/event"
      },
      "messages": [
        {
          "$ref": "#/channels/event/messages/snapshot"
        }
      ]
    }
  },
  "x-nats-service": {
    "name": "brai_agent",
    "version": "2.0.0",
    "queueGroup": "brai_agent"
  },
  "x-limits": {
    "frame": 1048576,
    "input": 65536,
    "state": 524288,
    "clients": 128,
    "queue": 64,
    "threads": 16,
    "pending": 64,
    "operations": 4096,
    "request": 32768
  },
  "x-timeouts-ms": {
    "read": 10000,
    "mutation": 12000
  },
  "x-retry-policy": "Never automatically retry mutations; operation IDs bind a request hash and its original result within a generation. Whole STATE_SNAPSHOT events may be coalesced; accept monotonically greater seq within the same generation/epoch. Read native history after generation/epoch change. activities/item are read-only scoped queries; generation rotation rejects a late result. Initial open/items/events omit non-message bodies. Summaries up to 100 IDs are fetched only on group expansion; full display on item expansion. Goal pause/clear additionally interrupt the confirmed active turn. Accepted earlier stages followed by any failure yield unknown; read open/goalGet before a new explicit operation. Native goals own automatic continuation. Plans carry native text/status; planProgress is transient and cannot be restored from history."
}
