{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.invalid/contracts/timer/v2/commands.schema.json",
  "title": "Brai timer commands",
  "oneOf": [
    {
      "$ref": "#/definitions/StartCommand"
    },
    {
      "$ref": "#/definitions/StopCommand"
    },
    {
      "$ref": "#/definitions/EditCommand"
    },
    {
      "$ref": "#/definitions/DeleteCommand"
    }
  ],
  "definitions": {
    "StartCommand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "expectedVersion",
            "userId"
          ],
          "properties": {
            "commandId": {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            "expectedVersion": {
              "$ref": "common.schema.json#/definitions/version"
            },
            "userId": {
              "$ref": "common.schema.json#/definitions/userId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "timerId",
            "startedAt",
            "userId"
          ],
          "properties": {
            "commandId": {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            "timerId": {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            "startedAt": {
              "$ref": "#/definitions/IntentTimestamp"
            },
            "userId": {
              "$ref": "common.schema.json#/definitions/userId"
            }
          }
        }
      ]
    },
    "StopCommand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "expectedVersion",
            "timerId",
            "userId"
          ],
          "properties": {
            "commandId": {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            "expectedVersion": {
              "$ref": "common.schema.json#/definitions/version"
            },
            "timerId": {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            "userId": {
              "$ref": "common.schema.json#/definitions/userId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "timerId",
            "stoppedAt",
            "userId"
          ],
          "properties": {
            "commandId": {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            "timerId": {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            "stoppedAt": {
              "$ref": "#/definitions/IntentTimestamp"
            },
            "userId": {
              "$ref": "common.schema.json#/definitions/userId"
            }
          }
        }
      ]
    },
    "EditCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "commandId",
        "timerId",
        "expectedVersion",
        "startedAt",
        "stoppedAt"
      ],
      "properties": {
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        },
        "commandId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "timerId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "expectedVersion": {
          "$ref": "common.schema.json#/definitions/version"
        },
        "startedAt": {
          "$ref": "#/definitions/IntentTimestamp"
        },
        "stoppedAt": {
          "$ref": "#/definitions/IntentTimestamp"
        }
      }
    },
    "DeleteCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "commandId",
        "timerId",
        "expectedVersion"
      ],
      "properties": {
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        },
        "commandId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "timerId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "expectedVersion": {
          "$ref": "common.schema.json#/definitions/version"
        }
      }
    },
    "IntentTimestamp": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/timestamp"
        },
        {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$",
          "type": "string"
        }
      ]
    }
  }
}
