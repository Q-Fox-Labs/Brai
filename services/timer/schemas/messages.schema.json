{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.invalid/contracts/timer/v2/messages.schema.json",
  "title": "Brai timer events and query DTOs",
  "oneOf": [
    {
      "$ref": "#/definitions/StartedEvent"
    },
    {
      "$ref": "#/definitions/StoppedEvent"
    },
    {
      "$ref": "#/definitions/TimerEditedEvent"
    },
    {
      "$ref": "#/definitions/TimerDeletedEvent"
    },
    {
      "$ref": "#/definitions/RejectedEvent"
    },
    {
      "$ref": "#/definitions/SnapshotResponse"
    },
    {
      "$ref": "#/definitions/HistoryRequest"
    },
    {
      "$ref": "#/definitions/HistoryResponse"
    },
    {
      "$ref": "#/definitions/CommandLookupRequest"
    },
    {
      "$ref": "#/definitions/CommandLookupResponse"
    },
    {
      "$ref": "#/definitions/StatisticsRequest"
    },
    {
      "$ref": "#/definitions/StatisticsResponse"
    }
  ],
  "definitions": {
    "StartedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "commandId",
        "version",
        "timerId",
        "startedAt",
        "userId"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "commandId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/version"
        },
        "timerId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "startedAt": {
          "$ref": "common.schema.json#/definitions/timestamp"
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "StoppedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "commandId",
        "version",
        "interval",
        "userId"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "commandId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/version"
        },
        "interval": {
          "$ref": "common.schema.json#/definitions/interval"
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "TimerEditedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "commandId",
        "version",
        "operation",
        "interval",
        "userId"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "commandId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/version"
        },
        "operation": {
          "type": "string",
          "enum": ["edit"]
        },
        "interval": {
          "$ref": "common.schema.json#/definitions/interval"
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "TimerDeletedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "commandId",
        "version",
        "operation",
        "timerId",
        "userId"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "commandId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/version"
        },
        "operation": {
          "type": "string",
          "enum": ["delete"]
        },
        "timerId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "RejectedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "commandId",
        "correlationId",
        "error",
        "userId"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "commandId": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "$ref": "common.schema.json#/definitions/error"
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "SnapshotResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "version",
        "serverTime",
        "recentCompleted",
        "nextCursor",
        "userId"
      ],
      "properties": {
        "active": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/definitions/activeTimer"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "common.schema.json#/definitions/version"
        },
        "serverTime": {
          "$ref": "common.schema.json#/definitions/timestamp"
        },
        "recentCompleted": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "common.schema.json#/definitions/interval"
          }
        },
        "totalCompletedMs": {
          "description": "Сумма всех завершённых интервалов владельца в миллисекундах; активный интервал исключён. Поле необязательно для совместимости с прежними producers v2.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "historyRevision": {
          "description": "Версия проекции истории владельца; растёт после успешного edit/delete. Поле необязательно для совместимости с прежними producers v2.",
          "$ref": "common.schema.json#/definitions/version"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "HistoryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "userId"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "HistoryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor",
        "userId"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/interval"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "historyRevision": {
          "description": "Версия проекции истории владельца; растёт после успешного edit/delete. Поле необязательно для совместимости с прежними producers v2.",
          "$ref": "common.schema.json#/definitions/version"
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "CommandLookupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "userId"
      ],
      "properties": {
        "commandId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      },
      "examples": [
        {
          "commandId": "91ae2be0-8d8f-4c50-9fd3-80b516b69a01",
          "userId": "user-a"
        }
      ]
    },
    "CommandLookupResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "status",
        "result",
        "userId"
      ],
      "properties": {
        "commandId": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/definitions/StartedEvent"
            },
            {
              "$ref": "#/definitions/StoppedEvent"
            },
            {
              "$ref": "#/definitions/TimerEditedEvent"
            },
            {
              "$ref": "#/definitions/TimerDeletedEvent"
            },
            {
              "$ref": "#/definitions/RejectedEvent"
            }
          ]
        },
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "SnapshotRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      },
      "required": [
        "userId"
      ]
    },
    "StatisticsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId"],
      "properties": {
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        }
      }
    },
    "Day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "completedMs", "targetMs", "percent", "achieved"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "completedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "targetMs": {
          "type": "integer",
          "enum": [28800000]
        },
        "percent": {
          "type": "number",
          "minimum": 0
        },
        "achieved": {
          "type": "boolean"
        }
      }
    },
    "StatisticsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "version", "serverTime", "timeZone", "totalCompletedMs", "daily", "challenge"],
      "properties": {
        "userId": {
          "$ref": "common.schema.json#/definitions/userId"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/version"
        },
        "serverTime": {
          "$ref": "common.schema.json#/definitions/timestamp"
        },
        "timeZone": {
          "type": "string",
          "enum": ["Europe/Moscow"]
        },
        "totalCompletedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "daily": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Day"
          }
        },
        "challenge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startDate", "endDateExclusive", "timeZone", "days", "dailyTargetMs", "targetMs", "completedMs", "remainingMs", "percent", "remainingDays", "requiredDailyMs", "achieved", "closedDays", "daily"],
          "properties": {
            "startDate": {
              "type": "string",
              "enum": ["2026-10-04"]
            },
            "endDateExclusive": {
              "type": "string",
              "enum": ["2026-11-01"]
            },
            "timeZone": {
              "type": "string",
              "enum": ["Europe/Moscow"]
            },
            "days": {
              "type": "integer",
              "enum": [28]
            },
            "dailyTargetMs": {
              "type": "integer",
              "enum": [28800000]
            },
            "targetMs": {
              "type": "integer",
              "enum": [806400000]
            },
            "completedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "remainingMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 806400000
            },
            "percent": {
              "type": "number",
              "minimum": 0
            },
            "remainingDays": {
              "type": "integer",
              "minimum": 0,
              "maximum": 28
            },
            "requiredDailyMs": {
              "type": "number",
              "minimum": 0
            },
            "achieved": {
              "type": "boolean"
            },
            "closedDays": {
              "type": "integer",
              "minimum": 0,
              "maximum": 28
            },
            "daily": {
              "type": "array",
              "minItems": 28,
              "maxItems": 28,
              "items": {
                "$ref": "#/definitions/Day"
              }
            }
          }
        }
      }
    }
  }
}
