{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.invalid/contracts/timer/v1/common.schema.json",
  "title": "Brai timer common DTO",
  "definitions": {
    "uuid": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["timerId", "startedAt", "stoppedAt", "durationMs"],
      "properties": {
        "timerId": {"$ref": "#/definitions/uuid"},
        "startedAt": {"$ref": "#/definitions/timestamp"},
        "stoppedAt": {"$ref": "#/definitions/timestamp"},
        "durationMs": {"type": "integer", "minimum": 0}
      }
    },
    "activeTimer": {
      "type": "object", "additionalProperties": false,
      "required": ["timerId", "startedAt"],
      "properties": {"timerId": {"$ref": "#/definitions/uuid"}, "startedAt": {"$ref": "#/definitions/timestamp"}}
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "enum": ["INVALID_ARGUMENT", "VERSION_CONFLICT", "TIMER_ALREADY_ACTIVE", "TIMER_NOT_ACTIVE", "COMMAND_ID_CONFLICT", "NOT_FOUND", "INTERNAL"]},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "currentVersion": {"$ref": "#/definitions/version"}
      }
    }
  }
}
