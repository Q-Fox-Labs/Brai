# ABOUTME: Упаковывает проверенный timer runtime без установки зависимостей.
# ABOUTME: Образ содержит готовый dist, схемы и owner-миграции точной ревизии.
FROM node:24.21.0-bookworm-slim
ARG BRAI_SOURCE_REVISION
LABEL org.opencontainers.image.revision=${BRAI_SOURCE_REVISION}
ENV NODE_ENV=production
WORKDIR /app
COPY . /app/
WORKDIR /app/services/timer
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 CMD ["node", "dist/health.js"]
CMD ["node", "dist/main.js"]
