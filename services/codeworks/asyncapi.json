        }
      ],
      "description": "Deadline 10s. Timeout does not cancel durable intent. Repeat a mutation only with the same idempotency key and unchanged payload.",
      "reply": {
        "channel": {
          "$ref": "#/channels/serviceReply"
        },
        "description": "Native NATS reply subject.",
        "x-nats-reply-subject": "message.reply",
        "messages": [
          {
            "$ref": "#/channels/serviceReply/messages/project_registerResponse"
          },
          {
            "$ref": "#/channels/serviceReply/messages/ServiceError"
          }
        ]
      },
      "bindings": {
