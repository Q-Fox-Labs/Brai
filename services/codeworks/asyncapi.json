        },
        "cleanupResponse": {
          "$ref": "#/components/messages/cleanupResponse"
        }
      }
    },
    "project_register": {
      "address": "brai.codeworks.v2.{executor}.project.register",
      "parameters": {
        "executor": {
          "description": "ACL-protected transport identity, never taken from request payload."
