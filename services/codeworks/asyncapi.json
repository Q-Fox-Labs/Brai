{
  "asyncapi": "3.1.0",
  "info": {
    "title": "Codeworks NATS Services",
    "version": "2.0.0",
    "description": "service_codeworks supports PING, INFO and STATS. ACL bind executor subject segment to broker identity. Registry operations require configured admin executor. Error headers and payload are ServiceError."
  },
  "defaultContentType": "application/json",
  "channels": {
    "serviceReply": {
      "address": null,
      "messages": {
        "ServiceError": {
