          {
            "$ref": "#/channels/reply/messages/operator_list"
          },
          {
            "$ref": "#/channels/reply/messages/error"
          }
        ]
      }
    },
    "review": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/review"
      },
      "messages": [
