{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:brai:bug-hunt:verification:v3",
  "definitions": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pending"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "case",
                "group"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "run-request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "request_id",
        "target"
      ]
    },
    "get": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "investigation_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_before_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "investigation_id"
      ]
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": []
    },
    "evidence-get": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "investigation_id": {
          "type": "string",
          "format": "uuid"
        },
        "evidence_id": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      },
      "required": [
        "investigation_id",
        "evidence_id"
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "investigation_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "request_id",
        "investigation_id",
        "reason"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "investigation_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "verdict": {
          "enum": [
            "confirmed",
            "refuted",
            "insufficient_evidence"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "request_id",
        "investigation_id",
        "expected_revision",
        "verdict",
        "explanation"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "pause": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "paused": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "request_id",
        "paused",
        "reason"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "facts": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "verdict": {
          "enum": [
            "confirmed",
            "refuted",
            "insufficient_evidence"
          ]
        },
        "reproduction_outcome": {
          "enum": [
            "reproduced",
            "not_reproduced",
            "not_attempted",
            "blocked",
            "invalid_test"
          ]
        },
        "observed_failure": {
          "enum": [
            "verified",
            "contradicted",
            "unknown"
          ]
        },
        "requirement_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "UUID свидетельства requirement, полученного через source_read по requirement_path. Для confirmed/refuted не null."
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "UUID свидетельства source, полученного через source_read. Для confirmed/refuted не null."
        },
        "runner_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Для confirmed/refuted: UUID evidence kind=runner из evidence_id результата reproduction_run/reproduction_get; обязателен даже для not_reproduced. Это не execution_id. Null допустим только при insufficient_evidence."
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "missing": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "claim",
        "expected",
        "facts",
        "verdict",
        "reproduction_outcome",
        "observed_failure",
        "requirement_id",
        "source_id",
        "runner_id",
        "evidence_ids",
        "missing",
        "limitations"
      ]
    },
    "modelReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "accepted",
        "candidate_sha256",
        "evidence_ids",
        "limitations"
      ]
    }
  }
}
