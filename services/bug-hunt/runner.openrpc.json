  "components": {
    "schemas": {
      "RunSpec": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "installation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "owner_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "investigation_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "installation_id",
              "owner_id",
              "investigation_id"
            ]
          },
          "recipe_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "recipe_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "spec_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requirement_id": {
                "type": "string",
                "format": "uuid"
              },
              "requirement_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "expected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "refutes_claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "confirms_claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "requirement_id",
              "requirement_sha256",
              "expected",
              "version"
            ]
          },
          "oracle_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fixture_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "deadline_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_tree_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "execution_id",
          "scope",
          "recipe_id",
          "recipe_version",
          "source_id",
          "source_commit",
          "source_sha256",
          "spec_sha256",
          "oracle",
          "oracle_sha256",
          "fixture_ref",
          "deadline_at",
          "source_tree_sha256"
        ]
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "installation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
