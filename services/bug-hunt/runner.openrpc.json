          "owner_id",
          "investigation_id"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "installation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "owner_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "investigation_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "installation_id",
              "owner_id",
              "investigation_id"
            ]
          },
          "recipe_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "recipe_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "spec_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "oracle_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "reproduced",
              "not_reproduced",
              "not_attempted",
              "blocked",
              "invalid_test"
            ]
          },
          "assertions": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "expected": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "actual": {
                  "type": "string",
                  "maxLength": 4000
                },
                "passed": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "expected",
                "actual",
                "passed"
              ]
            }
          },
          "log_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fidelity": {
            "const": "synthetic"
          },
          "substituted_boundaries": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "cleanup": {
            "enum": [
              "done",
              "pending"
            ]
          },
          "state": {
            "enum": [
              "completed",
              "failed",
              "unknown",
              "cancelled"
            ]
          },
          "source_tree_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "node_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dependencies_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "execution_id",
          "scope",
          "recipe_id",
          "recipe_version",
          "source_commit",
          "source_sha256",
          "spec_sha256",
          "oracle_sha256",
          "started_at",
          "finished_at",
          "exit_code",
          "outcome",
          "assertions",
          "log_sha256",
          "fidelity",
          "substituted_boundaries",
          "cleanup",
          "state",
          "source_tree_sha256",
          "node_sha256",
