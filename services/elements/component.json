{
  "formatVersion": 1,
  "id": "elements",
  "type": "container",
  "status": "active",
  "environments": [
    "dev"
  ],
  "executableSources": [
    "services/elements/planning/runner.py",
    "services/elements/src/health.ts",
    "services/elements/src/main.ts",
    "services/elements/src/migrate.ts",
    "services/elements/src/import-snapshot.ts"
  ],
  "inputs": {
    "build": [
      "package-lock.json",
      "services/elements/tsconfig.json"
    ],
    "runtime": [
      "services/elements/migrations/001.sql",
      "services/elements/migrations/002-game-core.sql",
      "services/elements/package.json",
      "services/elements/planning/baseline.json",
      "services/elements/planning/element-classification-rules.md",
      "services/elements/planning/game-planning-format.md",
      "services/elements/planning/game-planning-rules.md",
      "services/elements/planning/goal-planning-rules.md",
      "services/elements/planning/planning-review-rules.md",
      "services/elements/planning/planning-system.py",
      "services/elements/planning/quest-planning-rules.md",
      "services/elements/planning/runner.py",
      "services/elements/schemas/messages.schema.json",
      "services/elements/schemas/tools.schema.json",
      "services/elements/src/config.ts",
      "services/elements/src/contracts.ts",
      "services/elements/src/domain.ts",
      "services/elements/src/game.ts",
      "services/elements/src/health.ts",
      "services/elements/src/import-snapshot.ts",
      "services/elements/src/load.ts",
      "services/elements/src/main.ts",
      "services/elements/src/mcp.ts",
      "services/elements/src/migrate.ts",
      "services/elements/src/nats.ts",
      "services/elements/src/planning.ts",
      "services/elements/src/storage.ts"
    ],
    "checks": [
      "services/elements/tests/domain.test.mjs",
      "services/elements/tests/game.integration.test.mjs",
      "services/elements/tests/hierarchy.integration.test.mjs",
      "services/elements/tests/mcp.test.mjs",
      "services/elements/tests/planning-edges.integration.test.mjs",
      "services/elements/tests/planning-fixture.mjs",
      "services/elements/tests/planning.integration.test.mjs",
      "services/elements/tests/planning.test.mjs"
    ]
  },
  "dependencies": [],
  "commands": {
    "build": "npm run build",
    "check": "node --test tests/*.test.mjs"
  },
  "delivery": {
    "kind": "oci-context",
    "files": [
      "services/elements/dist",
      "services/elements/migrations",
      "services/elements/package.json",
      "services/elements/planning/baseline.json",
      "services/elements/planning/element-classification-rules.md",
      "services/elements/planning/game-planning-format.md",
      "services/elements/planning/game-planning-rules.md",
      "services/elements/planning/goal-planning-rules.md",
      "services/elements/planning/planning-review-rules.md",
      "services/elements/planning/planning-system.py",
      "services/elements/planning/quest-planning-rules.md",
      "services/elements/planning/runner.py",
      "services/elements/schemas"
    ],
    "entrypoints": [
      "services/elements/dist/main.js",
      "services/elements/dist/migrate.js",
      "services/elements/dist/health.js",
      "services/elements/planning/runner.py",
      "services/elements/dist/import-snapshot.js"
    ],
    "smokeImports": [],
    "systemRequirements": [
      "Node.js 24.21.0"
    ]
  },
  "deploy": {
    "units": [
      "elements",
      "elements-migrate"
    ],
    "migrations": [
      "services/elements/migrations"
    ],
    "health": "node services/elements/dist/health.js"
  },
  "npm": {
    "workspaces": [
      "services/elements"
    ]
  }
}
