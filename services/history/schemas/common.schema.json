{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brai.invalid/contracts/history/v1/common.schema.json",
  "title": "Brai history common DTO",
  "definitions": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "scopeType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with an explicit timezone and at most six fractional digits.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "data": {
      "type": "object"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "type_id",
        "occurred_at",
        "recorded_at",
        "actor_id",
        "scope_type",
        "scope_id",
        "object_type",
        "object_id",
        "data"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "type_id": {
          "$ref": "#/definitions/id"
        },
        "occurred_at": {
          "$ref": "#/definitions/timestamp"
        },
        "recorded_at": {
          "$ref": "#/definitions/timestamp"
        },
        "actor_id": {
          "oneOf": [
            {
              "$ref": "#/definitions/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_type": {
          "$ref": "#/definitions/scopeType"
        },
        "scope_id": {
          "$ref": "#/definitions/identifier"
        },
        "object_type": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "object_id": {
          "oneOf": [
            {
              "$ref": "#/definitions/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "$ref": "#/definitions/data"
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "code": {
          "$ref": "#/definitions/code"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "description": {
          "$ref": "#/definitions/description"
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category_id",
        "code",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "category_id": {
          "$ref": "#/definitions/id"
        },
        "code": {
          "$ref": "#/definitions/code"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "description": {
          "$ref": "#/definitions/description"
        }
      }
    },
    "webFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/definitions/source"
        },
        "category_id": {
          "$ref": "#/definitions/id"
        },
        "type_id": {
          "$ref": "#/definitions/id"
        },
        "actor_id": {
          "$ref": "#/definitions/identifier"
        },
        "object_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "object_id": {
          "$ref": "#/definitions/identifier"
        },
        "occurred_from": {
          "$ref": "#/definitions/timestamp"
        },
        "occurred_to": {
          "$ref": "#/definitions/timestamp"
        }
      }
    },
    "mcpFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/definitions/source"
        },
        "category_id": {
          "$ref": "#/definitions/id"
        },
        "type_id": {
          "$ref": "#/definitions/id"
        },
        "actor_id": {
          "$ref": "#/definitions/identifier"
        },
        "object_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "object_id": {
          "$ref": "#/definitions/identifier"
        },
        "occurred_from": {
          "$ref": "#/definitions/timestamp"
        },
        "occurred_to": {
          "$ref": "#/definitions/timestamp"
        },
        "scope_type": {
          "$ref": "#/definitions/scopeType"
        },
        "scope_id": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_ARGUMENT",
            "INVALID_CURSOR",
            "NOT_FOUND",
            "EVENT_ID_CONFLICT",
            "REQUEST_TOO_LARGE",
            "RESULT_TOO_LARGE",
            "BUSY",
            "DATABASE_UNAVAILABLE",
            "DEADLINE_EXCEEDED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
