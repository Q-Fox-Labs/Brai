{
  "openapi": "3.1.0",
  "info": {
    "title": "Brai Diary HTTP",
    "version": "1.0.0",
    "description": "Нормативные гарантии, пределы в UTF-8 байтах и правила доступа определены ../CONTRACT.md. Длина JSON Schema не заменяет байтовые пределы."
  },
  "security": [
    {
      "sessionCookie": []
    },
    {
      "personalBearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Listener готов; модели, Auth и БД проверяются отдельно."
          }
        }
      }
    },
    "/v1/entries": {
      "get": {
        "operationId": "listEntries",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "До 50 собственных записей",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      },
      "post": {
        "operationId": "createText",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Новая запись либо точный replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/v1/audio": {
      "post": {
        "operationId": "prepareAudio",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AudioInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Устойчивое намерение и готовность оригинала",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrepareResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/v1/entry/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getEntry",
        "responses": {
          "200": {
            "description": "Собственная полная запись",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/v1/upload/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "operationId": "uploadAudio",
        "parameters": [
          {
            "in": "header",
            "name": "x-content-size",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483648
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Принятый проверенный оригинал; обработка продолжается независимо от HTTP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      },
      "get": {
        "operationId": "getUploadState",
        "responses": {
          "200": {
            "description": "Подтверждённая позиция; ready означает принятый оригинал",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      },
      "patch": {
        "operationId": "uploadAudioPart",
        "parameters": [
          {
            "in": "header",
            "name": "x-content-size",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483648
            }
          },
          {
            "in": "header",
            "name": "upload-offset",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "in": "header",
            "name": "upload-chain",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary",
                "description": "1 MiB, последняя часть короче"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Подтверждённая позиция; ready означает принятый оригинал",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/v1/file/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "in": "header",
          "name": "Range",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "readOriginal",
        "responses": {
          "200": {
            "description": "Приватные байты оригинала"
          },
          "206": {
            "description": "Диапазон оригинала"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      },
      "head": {
        "operationId": "headOriginal",
        "responses": {
          "200": {
            "description": "Метаданные без байтов"
          },
          "206": {
            "description": "Диапазон без байтов"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp",
        "description": "Stateless Streamable HTTP MCP. Операции и inputSchema в mcp.json; cookie или персональная bearer-привязка.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC MCP result/error. Ошибка инструмента: isError с безопасным code."
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/v1/retry/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "retryTranscription",
        "description": "Один явный повтор своей остановившейся ASR без raw/Luna; прежний неизвестный исход сохраняется.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestId"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Повтор запланирован либо точный replay",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "state",
                    "entryId"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "scheduled",
                        "already_scheduled"
                      ]
                    },
                    "entryId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "previousState": {
                      "type": "string"
                    },
                    "previousErrorCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "header",
        "name": "Cookie",
        "description": "Cookie принадлежат Auth и передаются целиком. Дополнительно нужен x-brai-user; мутации требуют canonical Origin."
      },
      "personalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Токен привязан оператором к одному активному user/profile."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "TextInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "eventDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "required": [
          "requestId",
          "text"
        ]
      },
      "AudioInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "mimeType": {
            "type": "string",
            "pattern": "^audio/"
          },
          "recordedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "filename",
          "mimeType"
        ]
      },
      "Entry": {
        "type": "object",
        "required": [
          "id",
          "ownerId",
          "profileId",
          "requestId",
          "title",
          "source",
          "createdAt",
          "state",
          "eventDate",
          "dateStatus",
          "dateEvidence",
          "rawText",
          "correctedText",
          "transcription",
          "correction",
          "audioArtifactId",
          "errorCode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string"
          },
          "profileId": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "enum": [
              "audio",
              "text"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "enum": [
              "awaiting_upload",
              "transcribing",
              "correcting",
              "ready",
              "needs_attention"
            ]
          },
          "eventDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "dateStatus": {
            "enum": [
              "provided",
              "identified",
              "needs_clarification"
            ]
          },
          "dateEvidence": {
            "type": "string"
          },
          "rawText": {
            "type": [
              "string",
              "null"
            ]
          },
          "correctedText": {
            "type": [
              "string",
              "null"
            ]
          },
          "audioArtifactId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "transcription": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "requestId": {
                "type": "string"
              },
              "actualModel": {},
              "receivedAt": {
                "type": "string",
                "format": "date-time"
              },
              "strategy": {
                "const": "parts-v1"
              },
              "parts": {
                "type": "array",
                "maxItems": 128,
                "description": "Происхождение каждой части: Artifacts UUID, SHA256, PCM смещения и собственный requestId/actualModel Transcription.",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "correction": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "model": {
                "const": "gpt-6-luna"
              },
              "promptVersion": {
                "enum": [
                  "diary-v1",
                  "diary-parts-v1"
                ]
              },
              "rawResponse": {
                "type": "string"
              },
              "completedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "transcriptionRetry": {
            "type": "object",
            "description": "Прежний исход сохраняется при одном явном повторе.",
            "required": [
              "key",
              "previousRequestId",
              "previousState",
              "authorizedAt"
            ],
            "properties": {
              "key": {
                "type": "string",
                "format": "uuid"
              },
              "previousRequestId": {
                "type": "string",
                "format": "uuid"
              },
              "previousState": {
                "enum": [
                  "failed",
                  "outcome_unknown",
                  "cancelled"
                ]
              },
              "previousErrorCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "authorizedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "audioProgress": {
            "type": "object",
            "description": "Только подтверждённые PCM-кадры; процент = floor(100*готовые/totalFrames).",
            "required": [
              "totalFrames",
              "sampleRate",
              "transcribedFrames",
              "correctedFrames",
              "totalParts",
              "completedParts"
            ],
            "properties": {
              "totalFrames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 288016000
              },
              "sampleRate": {
                "const": 16000
              },
              "transcribedFrames": {
                "type": "integer",
                "minimum": 0
              },
              "correctedFrames": {
                "type": "integer",
                "minimum": 0
              },
              "totalParts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "completedParts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              }
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "description": "Entry без rawText, correctedText, correction и audioInput. Полная запись читается отдельным get.",
        "required": [
          "id",
          "title",
          "state",
          "eventDate",
          "dateStatus",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/Entry/properties/state"
          },
          "eventDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "dateStatus": {
            "$ref": "#/components/schemas/Entry/properties/dateStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "audioProgress": {
            "$ref": "#/components/schemas/Entry/properties/audioProgress"
          }
        }
      },
      "EntryResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/Entry"
          }
        },
        "required": [
          "entry"
        ]
      },
      "ListResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Summary"
            }
          }
        },
        "required": [
          "entries"
        ]
      },
      "PrepareResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/Entry"
          },
          "ready": {
            "type": "boolean"
          }
        },
        "required": [
          "entry",
          "ready"
        ]
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "entryId",
          "status"
        ]
      },
      "UploadState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entryId",
          "offset",
          "totalBytes",
          "chain",
          "chunkBytes",
          "ready"
        ],
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483648
          },
          "totalBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 2147483648
          },
          "chain": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "chunkBytes": {
            "const": 1048576
          },
          "ready": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "Ошибка 400/401/403/404/409/413/429/502/503. Условия и коды определены CONTRACT.md.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
