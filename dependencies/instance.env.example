# ABOUTME: Показывает обязательные несекретные параметры запуска зависимостей.
# ABOUTME: Пути должны быть абсолютными; секреты передаются отдельными файлами.
NATS_COMPOSE_PROJECT=nats
NATS_DATA_VOLUME=nats_nats_data
NATS_SERVER_ENV_FILE=/absolute/secrets/nats_server.env
BRAI_NATS_NETWORK=brai_nats_private
SUPABASE_COMPOSE_PROJECT=supabase
SUPABASE_DATA_ROOT=/absolute/prepared-supabase-root
SUPABASE_DB_CONFIG_VOLUME=supabase_db-config
SUPABASE_DENO_CACHE_VOLUME=supabase_deno-cache
BRAI_SUPABASE_NETWORK=brai_supabase
BRAI_DATABASE_NETWORK=brai_database_private
