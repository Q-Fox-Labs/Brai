!.agents/skills/speckit-plan/
!.agents/skills/speckit-specify/
!.agents/skills/speckit-tasks/
.aws/
.codex/
tmp/
# BEGIN BRAI NODE WORKSPACE
node_modules/
.next/
.next-reference/
dist/
*.tsbuildinfo
npm-debug.log*
# END BRAI NODE WORKSPACE

# Next.js generates workspace type declarations during build.
apps/web/next-env.d.ts

# DEV immutable releases and local runtime tooling.
.runtime/

# Личные дополнения пользовательского агента не входят в исходники и поставки.
/docs/user-agent/usercustom/

# Python verification caches are generated locally.
__pycache__/
